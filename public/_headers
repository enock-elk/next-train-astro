# Cache-Control for hosts that honor this file (Cloudflare Pages).
# GitHub Pages ignores it — nexttrain-edge Worker sets the same headers on
# nexttrain.co.za/_astro/* and /icons/*. HTML / sw.js / app-version.json stay
# short-lived so NUKE + deploys can take effect.
#
# Never advertise a stack version (no X-Powered-By: PHP/x.y). Cloudflare still
# sends `server: cloudflare` with no version — that is added after our origin.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=2592000

/sw.js
  Cache-Control: no-cache

/app-version.json
  Cache-Control: no-cache

/
  Cache-Control: no-cache
  X-Powered-By:
