# Cache-Control for hosts that honor this file (Cloudflare Pages).
# GitHub Pages ignores it. Production (nexttrain.co.za) uses Cloudflare
# Cache Rules + response header transforms from
# workers/nexttrain-edge/zone-rules.json — not a Worker. Same TTLs:
# /_astro/* long/immutable, /icons/* 30d, /sw.js + /app-version.json no-store.
# HTML stays off those rules so NUKE + deploys can take effect.
#
# Every HTML entry below is no-cache for one reason: a cached page outliving the
# hashed /_astro/ bundle it links to is what paints the unstyled shell. The host
# now retains several previous generations, but the shorter the stale-HTML
# window, the fewer readers need that safety net at all.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000

/sw.js
  Cache-Control: no-store, no-cache, must-revalidate

/app-version.json
  Cache-Control: no-store, no-cache, must-revalidate

/
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/routes/*
  Cache-Control: no-cache

/regions/*
  Cache-Control: no-cache

/corridors/*
  Cache-Control: no-cache

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
