# Cache-Control for hosts that honor this file (Cloudflare Pages).
# GitHub Pages ignores it — nexttrain-edge Worker sets the same headers on
# nexttrain.co.za/_astro/* and /icons/* (long TTL) and on /sw.js plus
# /app-version.json (no-store, so PWA/TWA are not stuck on max-age=600).
# HTML stays off that Worker so NUKE + deploys can take effect.
#
# Every HTML entry below is no-cache for one reason: a cached page outliving the
# hashed /_astro/ bundle it links to is what paints the unstyled shell. The host
# now retains several previous generations, but the shorter the stale-HTML
# window, the fewer readers need that safety net at all.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000

/sw.js
  Cache-Control: no-store, no-cache, must-revalidate

/app-version.json
  Cache-Control: no-store, no-cache, must-revalidate

/
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/routes/*
  Cache-Control: no-cache

/regions/*
  Cache-Control: no-cache

/corridors/*
  Cache-Control: no-cache

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
