---
/**
 * Full-view Route Community (same chrome as Live Board / Trip Planner).
 * Behaviour: src/lib/community.js
 */
---
<style is:global>
    .community-post-row,
    .community-post-row .community-msg-text,
    #community-reaction-sheet,
    #community-reaction-sheet button {
        -webkit-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
    }
    .nt-sheet-above-nav {
    bottom: 0;
  }
  body:has(#bottom-nav:not(.hidden)):not(.nt-immersive) .nt-sheet-above-nav {
    bottom: calc(var(--nt-nav-h, 3.6rem) + var(--nt-sys-bottom, env(safe-area-inset-bottom, 0px)));
  }
  html.nt-keyboard .nt-sheet-above-nav {
    bottom: var(--nt-kb-h, 0px);
  }
  #community-composer.community-composer-with-clip {
    padding-right: 2.75rem;
  }
  #community-composer {
    touch-action: pan-y;
    -webkit-overflow-scrolling: touch;
  }
  #community-reply-bar-snippet {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .community-bubble.nt-community-force-flash {
        animation: nt-alert-force-flash 1.5s ease-out 1;
    }
    .community-post-row.is-selected .community-bubble::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: rgba(11, 20, 26, 0.22);
        pointer-events: none;
    }
</style>

<div id="view-community" class="view-section bg-gray-50 dark:bg-gray-900/50 p-0">
    <div class="community-pane relative flex flex-col flex-1 min-h-0 h-full">
        <div class="nt-pack-wallpaper" aria-hidden="true"></div>
        <!--
          z-20, not z-[1]. The feed and composer also create stacking contexts.
          The route list is position:absolute and drops into the feed's box, so
          a matching z-index lets the later sibling (empty-state copy + wallpaper)
          paint on top. Taps then hit the feed, the list looks see-through, and
          the room never changes. Do not drop this chrome below the feed again.
        -->
        <div class="community-chrome relative z-20 shrink-0 pt-1.5 pb-1.5 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
            <div id="community-chrome-home" class="space-y-1">
            <span id="community-marks-chip" hidden aria-hidden="true" class="hidden"></span>
            <div class="community-route-row relative z-10 flex items-center justify-between gap-2 px-4">
                <div class="min-w-0 flex-1">
                    <label for="community-route-select" class="sr-only">Route room</label>
                    <div class="relative min-w-0" id="community-route-dropdown">
                        <select id="community-route-select" class="sr-only" tabindex="-1" aria-hidden="true"></select>
                        <button type="button" id="community-route-trigger" class="w-full flex items-center justify-between gap-2 px-3 py-1.5 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-600 text-left shadow-sm hover:border-blue-300 dark:hover:border-blue-600 hover:bg-white dark:hover:bg-gray-800/80 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500" aria-haspopup="listbox" aria-expanded="false">
                            <span id="community-route-display" class="min-w-0 flex-1 text-sm sm:text-base font-black text-gray-900 dark:text-white tracking-tight truncate leading-tight">Select route</span>
                            <span id="community-route-unread" class="community-room-unread hidden">0</span>
                            <svg id="community-route-chevron" class="w-4 h-4 text-gray-400 shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <ul id="community-route-list" role="listbox" class="absolute z-30 left-0 right-0 mt-1.5 max-h-[min(50vh,20rem)] overflow-y-auto custom-scrollbar isolate bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-xl shadow-2xl hidden flex-col text-left"></ul>
                    </div>
                </div>
                <button type="button" id="community-refresh-btn" class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-500 focus:outline-none shrink-0" aria-label="Refresh" title="Refresh">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                </button>
            </div>
            <div id="community-room-meta" class="flex items-center gap-3 px-4 min-w-0">
                <button type="button" id="community-room-about" class="shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" title="Disclaimer">Disclaimer</button>
                <button type="button" id="community-presence" class="min-w-0 flex-1 truncate text-right text-[10px] font-bold leading-none text-gray-400 dark:text-gray-500 tracking-wide hover:text-blue-600 dark:hover:text-blue-400 underline-offset-2 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm transition-colors" title="About who’s here">Just you here</button>
            </div>
            <h2 id="community-route-title" class="sr-only">Route feed</h2>
            <p id="community-typing" class="px-4 text-[10px] text-blue-600 dark:text-blue-400 font-medium hidden truncate"></p>

            <div id="community-guest-hint" class="hidden relative mx-4 pr-9 text-[11px] text-blue-800 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800/50 rounded-xl px-3 py-2">
                <p class="leading-snug">Anyone can read. <button type="button" id="community-signin-cta" class="font-bold underline focus:outline-none">Sign in</button> to post or reply.</p>
                <button type="button" id="community-guest-hint-dismiss" class="absolute top-1.5 right-1.5 p-1 rounded-md text-blue-500/80 hover:text-blue-800 dark:hover:text-blue-200 hover:bg-blue-100/80 dark:hover:bg-blue-900/50 focus:outline-none" aria-label="Dismiss" title="Dismiss">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            </div>
            <div id="community-select-bar" class="hidden items-center gap-1 px-2">
                <button type="button" id="community-select-back" class="p-2 rounded-full text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none" aria-label="Clear selection">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                </button>
                <span id="community-select-count" class="text-lg font-black text-gray-900 dark:text-white tabular-nums">1</span>
                <span class="flex-1"></span>
                <button type="button" id="community-select-delete" class="community-sheet-delete hidden p-2 rounded-full text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/40 focus:outline-none" aria-label="Delete" data-delete-mode="tombstone" data-delete-as="author">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2"/><path d="M7 7l1 13a1 1 0 001 1h6a1 1 0 001-1l1-13"/></svg>
                </button>
                <button type="button" id="community-select-report" class="community-sheet-report hidden p-2 rounded-full text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none" aria-label="Report">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4"/><path d="M5 4h12l-2 4 2 4H5"/></svg>
                </button>
                <button type="button" id="community-select-copy" class="p-2 rounded-full text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none" aria-label="Copy">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" stroke-width="2"></rect><path stroke-width="2" d="M4 16V6a2 2 0 012-2h10"></path></svg>
                </button>
                <button type="button" id="community-select-share" class="p-2 rounded-full text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none" aria-label="Share">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98"/></svg>
                </button>
                <button type="button" id="community-select-menu-btn" class="hidden p-2 rounded-full text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none" aria-label="More" aria-haspopup="menu">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.6"></circle><circle cx="12" cy="12" r="1.6"></circle><circle cx="12" cy="19" r="1.6"></circle></svg>
                </button>
            </div>
            <div id="community-select-menu" class="hidden absolute right-3 top-full z-30 mt-1 min-w-[12rem] rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-xl py-1" role="menu"></div>
        </div>

        <!-- Wallpaper lives on the pane so IME / composer resize does not retile it -->
        <div class="community-feed-scroll relative z-[1] flex-1 basis-0 min-h-[8rem] min-h-0 overflow-y-auto px-3 sm:px-4 pt-3 pb-4 custom-scrollbar bg-transparent">
            <div id="community-feed-empty" class="hidden py-10 px-2 text-center"></div>
            <div id="community-feed-list" class="pb-2 space-y-2.5"></div>
        </div>

        <div id="community-composer-dock" class="relative z-[1] shrink-0 px-3 pt-2 pb-2 bg-transparent">
            <div id="community-attach-preview" class="mb-1.5 flex flex-wrap gap-1.5 empty:hidden"></div>
            <p id="community-error" class="text-xs font-bold text-red-600 dark:text-red-400 mb-1 empty:hidden empty:mb-0"></p>
            <p id="community-char-hint" hidden class="mb-1 text-left text-[11px] leading-snug text-gray-500 dark:text-gray-400"></p>
            <button type="button" id="community-quota-hint" hidden class="mb-1 bg-transparent p-0 text-left text-[11px] leading-snug text-gray-500 underline decoration-dotted underline-offset-2 focus:outline-none dark:text-gray-400"></button>
            <p id="community-quota-note" hidden class="mb-2 text-[13px] font-normal leading-snug text-gray-600 dark:text-gray-300"></p>
            <div class="flex gap-2 items-end">
                <div class="relative flex-1 min-w-0">
                    <div id="community-reply-bar" class="hidden mb-1.5 px-3 py-2 rounded-xl bg-white/95 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 flex items-start gap-2 shadow-sm">
                        <div class="min-w-0 flex-1 border-l-[3px] border-blue-500 pl-2">
                            <p id="community-reply-bar-name" class="text-[11px] font-bold text-blue-600 dark:text-blue-400 truncate"></p>
                            <p id="community-reply-bar-snippet" class="text-[11px] text-gray-600 dark:text-gray-300 leading-snug line-clamp-2"></p>
                        </div>
                        <button type="button" id="community-reply-bar-clear" class="shrink-0 p-1 rounded-md text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 focus:outline-none" aria-label="Cancel reply">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                    </div>
                    <div id="community-copilot" class="hidden mb-1.5 space-y-1.5">
                        <div id="community-suggest-halt" class="hidden rounded-xl border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-950/40 text-amber-950 dark:text-amber-100 p-2.5">
                            <div id="community-suggest-halt-text" class="text-[12px] leading-relaxed whitespace-pre-wrap"></div>
                            <label for="community-suggest-context" class="block text-[11px] font-bold mt-2 mb-1">Add the missing fact</label>
                            <textarea id="community-suggest-context" rows="3" maxlength="2000" class="w-full rounded-xl border border-amber-300 dark:border-amber-700 bg-white dark:bg-gray-900 text-sm text-gray-900 dark:text-white p-2 focus:outline-none" placeholder="Type what the draft should use, then suggest again."></textarea>
                            <button type="button" id="community-suggest-again" class="mt-2 w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-3 rounded-xl text-sm focus:outline-none">Suggest again</button>
                        </div>
                        <div id="community-suggest-status" class="hidden rounded-lg border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-950/40 p-2" aria-live="polite">
                            <p id="community-suggest-status-text" class="text-[11px] font-bold text-indigo-950 dark:text-indigo-100"></p>
                        </div>
                    </div>
                    <textarea id="community-composer" rows="2" maxlength="8000" class="block w-full min-h-[3.75rem] max-h-[10rem] py-2.5 pl-3.5 pr-3 rounded-[1.35rem] bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 text-sm leading-5 text-left text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none resize-none overflow-y-auto" placeholder="Please be kind and respectful."></textarea>
                    <button type="button" id="community-attach-btn" class="hidden absolute right-1.5 bottom-1.5 w-9 h-9 rounded-full text-gray-500 dark:text-gray-400 hover:bg-gray-200/80 dark:hover:bg-gray-700 flex items-center justify-center focus:outline-none" aria-label="Attach">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
                    </button>
                </div>
                <div class="flex shrink-0 flex-col justify-end gap-1">
                    <button type="button" id="community-guide-open" class="hidden h-8 rounded-xl border border-gray-300 bg-white px-3 text-xs font-bold text-gray-800 shadow-sm focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-gray-100">Guide</button>
                    <button type="button" id="community-post-btn" class="h-[2.75rem] px-3.5 min-w-[3.25rem] rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold shadow-sm focus:outline-none disabled:opacity-50">Post</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="community-guide-modal" class="fixed inset-0 z-[150] hidden flex items-start justify-center bg-black/80 p-3 pt-[max(0.75rem,env(safe-area-inset-top))]" role="dialog" aria-modal="true" aria-labelledby="community-guide-title">
    <div class="flex w-full max-w-lg flex-col rounded-2xl bg-white px-3 py-3 shadow-2xl dark:bg-gray-800">
        <div class="mb-3 flex shrink-0 items-center justify-between gap-3">
            <h3 id="community-guide-title" class="text-lg font-black text-gray-900 dark:text-white">Guide this reply</h3>
            <button type="button" id="community-guide-close" class="rounded-full p-2 text-gray-500 hover:bg-gray-100 focus:outline-none dark:hover:bg-gray-700" aria-label="Close">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <p class="text-[11px] leading-snug text-gray-500 dark:text-gray-400">This note steers only the next draft in this room. It is not posted.</p>
        <label for="community-guide-text" class="mt-3 block text-[11px] font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400">Guidance</label>
        <textarea id="community-guide-text" rows="6" maxlength="2000" class="mt-2 max-h-[40vh] w-full rounded-xl border border-gray-300 bg-white p-3 text-sm leading-relaxed text-gray-900 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-white" placeholder="What should this draft say or correct?"></textarea>
        <div class="mt-3 grid grid-cols-2 gap-2">
            <button type="button" id="community-guide-cancel" class="min-h-[2.75rem] rounded-xl border border-gray-300 bg-white text-sm font-bold text-gray-800 focus:outline-none dark:border-gray-600 dark:bg-gray-900 dark:text-gray-100">Cancel</button>
            <button type="button" id="community-guide-go" class="min-h-[2.75rem] rounded-xl bg-gray-900 text-sm font-bold text-white focus:outline-none dark:bg-white dark:text-gray-900">Regenerate</button>
        </div>
    </div>
</div>

<div id="community-attach-modal" class="nt-sheet-above-nav fixed inset-x-0 top-0 z-[140] hidden flex flex-col justify-end bg-black/50">
    <div id="community-attach-tray" class="w-full max-w-md space-y-2 rounded-t-2xl border-t border-gray-200 bg-white px-4 pb-4 pt-3 shadow-2xl dark:border-gray-700 dark:bg-gray-800">
        <div class="mx-auto mb-1 h-1 w-10 rounded-full bg-gray-300 dark:bg-gray-600" aria-hidden="true"></div>
        <p class="text-sm font-black text-gray-900 dark:text-white">Attach</p>
        <select id="community-poster-select" class="w-full min-h-[2.25rem] rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-xs text-gray-900 dark:text-white px-2 focus:outline-none">
            <option value="">Service alert poster…</option>
        </select>
        <div class="flex gap-2">
            <input id="community-attach-url" type="url" inputmode="url" maxlength="400" class="flex-1 min-w-0 min-h-[2.25rem] rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-xs px-2 text-gray-900 dark:text-white focus:outline-none" placeholder="https link or image address" />
            <button type="button" id="community-attach-add" class="shrink-0 px-3 rounded-xl bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 text-xs font-bold focus:outline-none">Add</button>
        </div>
    </div>
</div>

<div id="community-delete-modal" class="fixed inset-0 z-[170] hidden flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="community-delete-title">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-sm p-5">
        <h3 id="community-delete-title" class="text-base font-black text-gray-900 dark:text-white mb-2">Delete this message?</h3>
        <p id="community-delete-body" class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-4"></p>
        <div class="flex gap-2">
            <button type="button" id="community-delete-cancel" class="flex-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-900 dark:text-white font-bold py-3 px-4 rounded-lg transition-colors focus:outline-none">Cancel</button>
            <button type="button" id="community-delete-confirm" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-4 rounded-lg transition-colors focus:outline-none">Delete</button>
        </div>
    </div>
</div>

<style is:global>
  /* Route list is absolute and hangs into the feed. Chrome must stay above
     that stacking context or the empty-state copy eats the taps. */
  #view-community .community-chrome {
    z-index: 20;
  }
  /* The select bar covers the route header. Hiding that header used to
     shorten the chrome and shift every message. */
  #view-community .community-chrome.is-selecting #community-chrome-home {
    visibility: hidden;
  }
  #view-community .community-chrome.is-selecting #community-select-bar {
    position: absolute;
    inset: 0;
    z-index: 3;
    background-color: inherit;
  }
  #view-community .community-feed-scroll {
    overflow-anchor: none;
  }
  /* A little darker than the shared wash so the bubbles sit forward.
     Alerts and Feedback Hub keep their own wallpaper. */
  #view-community .nt-pack-wallpaper {
    background-color: color-mix(in srgb, #111827 6%, color-mix(in srgb, var(--nt-chrome-header) 16%, var(--nt-canvas)));
  }
  html.dark #view-community .nt-pack-wallpaper {
    background-color: color-mix(in srgb, #000 8%, color-mix(in srgb, var(--nt-chrome-header) 16%, var(--nt-canvas)));
  }
  #view-community .nt-pack-wallpaper::before {
    opacity: 0.11;
  }
  #view-community .community-route-row {
    z-index: 10;
  }
  #community-room-about {
    appearance: none;
    -webkit-appearance: none;
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0.08rem 0.48rem;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, #1d4ed8 14%, #fff);
    color: #1d4ed8;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  html.dark #community-room-about {
    background: color-mix(in srgb, #93c5fd 22%, #1f2937);
    color: #dbeafe;
  }
  #community-route-list.has-more-below {
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 0.95rem), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 0.95rem), transparent);
    box-shadow: 0 16px 22px -12px rgba(15, 23, 42, 0.45);
  }
  #community-route-dropdown.is-open {
    z-index: 40;
  }
  #community-route-list:not(.hidden) {
    background-color: #ffffff;
  }
  html.dark #community-route-list:not(.hidden) {
    background-color: #1f2937;
  }
  .community-post-row {
    display: flex;
    align-items: flex-start;
    width: 100%;
    position: relative;
    touch-action: pan-y;
    transition: transform 0.15s ease;
  }
  .community-post-row.is-swiping {
    transition: none;
  }
  .community-post-row.is-pressing .community-bubble {
    filter: brightness(0.82);
  }
  .dark .community-post-row.is-pressing .community-bubble {
    filter: brightness(0.72);
  }
  .community-post-row.is-pressing .community-avatar {
    filter: brightness(0.85);
  }
  /* A share chip or link inside the bubble takes the tap. The row must not dim with it. */
  .community-post-row.is-pressing:has(.community-share-chip:active) .community-bubble,
  .community-post-row.is-pressing:has(.community-share-chip:active) .community-avatar,
  .community-post-row.is-pressing:has(.community-msg-link:active) .community-bubble,
  .community-post-row.is-pressing:has(.community-msg-link:active) .community-avatar {
    filter: none;
  }
  .community-swipe-hint {
