---
/**
 * Full-view Route Community (same chrome as Live Board / Trip Planner).
 * Behaviour: src/lib/community.js
 */
---

<div id="view-community" class="view-section bg-gray-50 dark:bg-gray-900/50 p-0">
    <div class="flex flex-col flex-1 min-h-0 h-full">
        <div class="shrink-0 pt-4 pb-3 space-y-2.5 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
            <div class="flex items-start justify-between gap-2 px-4">
                <div class="min-w-0 flex-1">
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5">Community</p>
                    <label for="community-route-select" class="sr-only">Route room</label>
                    <div class="relative min-w-0" id="community-route-dropdown">
                        <select id="community-route-select" class="sr-only" tabindex="-1" aria-hidden="true"></select>
                        <button type="button" id="community-route-trigger" class="w-full flex items-center justify-between gap-2 px-3 py-2 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-600 text-left shadow-sm hover:border-blue-300 dark:hover:border-blue-600 hover:bg-white dark:hover:bg-gray-800/80 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500" aria-haspopup="listbox" aria-expanded="false">
                            <span id="community-route-display" class="text-sm sm:text-base font-black text-gray-900 dark:text-white tracking-tight truncate leading-tight">Select route</span>
                            <svg id="community-route-chevron" class="w-4 h-4 text-gray-400 shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <ul id="community-route-list" role="listbox" class="absolute z-[200] left-0 right-0 mt-1.5 max-h-[min(50vh,20rem)] overflow-y-auto custom-scrollbar bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-xl shadow-2xl hidden flex-col text-left"></ul>
                    </div>
                </div>
                <button type="button" id="community-refresh-btn" class="mt-6 p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-500 focus:outline-none shrink-0" aria-label="Refresh" title="Refresh">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                </button>
            </div>
            <h2 id="community-route-title" class="sr-only">Route feed</h2>

            <div class="flex items-center justify-between gap-2 px-4">
                <button type="button" id="community-presence" class="text-[10px] font-bold text-gray-400 dark:text-gray-500 tracking-wide hover:text-blue-600 dark:hover:text-blue-400 underline-offset-2 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm transition-colors" title="About who’s here">...</button>
                <p id="community-typing" class="text-[10px] text-blue-600 dark:text-blue-400 font-medium hidden truncate max-w-[55%]"></p>
            </div>

            <div id="community-guest-hint" class="hidden relative mx-4 pr-9 text-[11px] text-blue-800 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800/50 rounded-xl px-3 py-2">
                <p class="leading-snug">Anyone can read. <button type="button" id="community-signin-cta" class="font-bold underline focus:outline-none">Sign in</button> to post or reply.</p>
                <button type="button" id="community-guest-hint-dismiss" class="absolute top-1.5 right-1.5 p-1 rounded-md text-blue-500/80 hover:text-blue-800 dark:hover:text-blue-200 hover:bg-blue-100/80 dark:hover:bg-blue-900/50 focus:outline-none" aria-label="Dismiss" title="Dismiss">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        </div>

        <!-- Grows into leftover height; only this area scrolls — header/composer stay full size -->
        <div class="flex-1 basis-0 min-h-[8rem] overflow-y-auto px-3 sm:px-4 pt-3 pb-4 custom-scrollbar bg-gray-100/80 dark:bg-gray-950/40">
            <div id="community-feed-empty" class="hidden py-10 px-2 text-center"></div>
            <div id="community-feed-list" class="pb-2 space-y-2.5"></div>
        </div>

        <div class="shrink-0 border-t border-gray-200 dark:border-gray-700 p-3 bg-white dark:bg-gray-800 space-y-2">
            <p id="community-error" class="text-xs font-bold text-red-600 dark:text-red-400 min-h-[1rem]"></p>
            <div id="community-reply-bar" class="hidden mx-0 mb-1 px-3 py-2 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 flex items-start gap-2">
                <div class="min-w-0 flex-1 border-l-2 border-blue-500 pl-2">
                    <p id="community-reply-bar-name" class="text-[11px] font-bold text-blue-600 dark:text-blue-400 truncate"></p>
                    <p id="community-reply-bar-snippet" class="text-[11px] text-gray-500 dark:text-gray-400 truncate"></p>
                </div>
                <button type="button" id="community-reply-bar-clear" class="shrink-0 p-1 rounded-md text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 focus:outline-none" aria-label="Cancel reply">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="flex gap-2 items-stretch">
                <textarea id="community-composer" rows="2" maxlength="280" class="flex-1 min-w-0 min-h-[3.25rem] p-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 text-sm text-left text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none resize-none" placeholder="Sign in to post"></textarea>
                <button type="button" id="community-post-btn" class="shrink-0 self-stretch px-3.5 min-w-[3.25rem] rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold shadow-sm focus:outline-none disabled:opacity-50">Post</button>
            </div>
        </div>
    </div>
</div>

<style is:global>
  .community-post-row {
    display: flex;
    align-items: flex-start;
    width: 100%;
    position: relative;
    touch-action: pan-y;
    transition: transform 0.15s ease;
  }
  .community-post-row.is-swiping {
    transition: none;
  }
  .community-post-row.is-pressing .community-bubble {
    filter: brightness(0.82);
  }
  .dark .community-post-row.is-pressing .community-bubble {
    filter: brightness(0.72);
  }
  .community-post-row.is-pressing .community-avatar {
    filter: brightness(0.85);
  }
  .community-swipe-hint {
    position: absolute;
    left: 0.25rem;
    top: 0.75rem;
    transform: scale(0.85);
    opacity: 0;
    color: #64748b;
    pointer-events: none;
    transition: opacity 0.12s ease, transform 0.12s ease;
  }
  .community-post-row.is-swiping .community-swipe-hint {
    opacity: 1;
    transform: scale(1);
  }
  .community-avatar {
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: 0;
  }
  .community-bubble-wrap {
    width: 66.666%;
    max-width: 66.666%;
    flex: 0 0 66.666%;
    min-width: 0;
  }
  .community-bubble {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    overflow: hidden;
  }
  .community-bubble-own {
    background: #d9fdd3;
    color: #111827;
    border-radius: 0.75rem 0.75rem 0.2rem 0.75rem;
  }
  .dark .community-bubble-own {
    background: #005c4b;
    color: #e7f8f5;
  }
  .community-bubble-other {
    background: #ffffff;
    color: #111827;
    border-radius: 0.75rem 0.75rem 0.75rem 0.2rem;
    border: 1px solid rgba(229, 231, 235, 0.9);
  }
  .dark .community-bubble-other {
    background: #1f2937;
    color: #f3f4f6;
    border-color: #374151;
  }
  .community-bubble-name-row {
    padding: 0.3rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    background: rgba(0, 0, 0, 0.055);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .dark .community-bubble-name-row {
    background: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }
  .community-bubble-own .community-bubble-name-row {
    background: rgba(0, 0, 0, 0.06);
  }
  .dark .community-bubble-own .community-bubble-name-row {
    background: rgba(0, 0, 0, 0.18);
  }
  .community-bubble-body {
    padding: 0.35rem 0.65rem 0.4rem;
  }
  .community-msg-text {
    font-size: 0.84rem;
    line-height: 1.35;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .community-msg-time {
    float: right;
    margin: 0.2rem 0 0 0.55rem;
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.1;
    opacity: 0.65;
    white-space: nowrap;
  }
  .community-reaction-pills {
    display: inline-flex;
    gap: 0.2rem;
    margin-top: -0.35rem;
    margin-left: 0.35rem;
    position: relative;
    z-index: 1;
  }
  .community-reaction-pill {
    font-size: 0.7rem;
    line-height: 1;
    padding: 0.15rem 0.35rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid #e5e7eb;
    box-shadow: 0 1px 2px rgba(0,0,0,0.06);
  }
  .dark .community-reaction-pill {
    background: #111827;
    border-color: #374151;
  }
</style>
