---
// Brand-left header (WhatsApp-style): Next Train + day meta left · alerts / ⋮ right
---

<header id="app-header" class="app-header shrink-0 px-3 py-2.5 bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl z-30 relative flex items-center justify-between gap-3 border-b border-gray-200/80 dark:border-gray-700/80 transition-[padding] duration-300">

    <div id="offline-wrapper" class="absolute top-0 left-0 right-0 flex justify-center z-[60] pointer-events-none">
        <div id="offline-indicator" style="display: none;" class="pointer-events-auto w-max bg-amber-400 text-gray-900 border-amber-500 border-b border-x border-t-0 dark:bg-gray-900/95 dark:text-amber-400 dark:border-amber-500/80 dark:shadow-[0_4px_12px_rgba(245,158,11,0.15)] backdrop-blur-md text-xs font-black uppercase px-4 py-1 rounded-b-lg shadow-md flex items-center justify-center tracking-widest whitespace-nowrap transition-colors">
            WORKING OFFLINE
        </div>
    </div>

    <div class="min-w-0 flex-1 header-brand-block pl-0.5">
        <h1 id="app-title" class="header-title text-[2.55rem] sm:text-[2.75rem] font-black text-blue-600 dark:text-blue-400 select-none cursor-pointer tracking-[-0.035em] leading-none">
            Next Train
        </h1>
        <div class="header-meta mt-1.5 min-w-0">
            <p id="current-day" class="text-[11px] sm:text-xs font-medium text-gray-500 dark:text-gray-400 leading-tight truncate">Getting schedules…</p>
            <!-- Sim clock only — diagnostic, shown by logic.js when $isSimMode -->
            <p id="current-time" class="hidden mt-0.5 text-[10px] font-mono text-amber-700 dark:text-amber-400 tabular-nums" aria-hidden="true"></p>
            <p id="last-updated-date-hidden" class="hidden text-[10px] text-gray-400 dark:text-gray-500 font-medium uppercase tracking-wide mt-0.5"></p>
        </div>
    </div>

    <div class="flex items-center gap-0.5 shrink-0 self-start mt-1 relative z-[70]">
        <button id="notice-bell" type="button" class="hidden relative p-2 rounded-full text-red-600 dark:text-red-300 hover:bg-red-50 dark:hover:bg-red-950/40 focus:outline-none transition-colors" aria-label="Service Alert">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
            <span id="notice-dot" class="absolute top-1.5 right-1.5 block h-2 w-2 rounded-full ring-2 ring-white dark:ring-gray-900 bg-red-600 hidden"></span>
        </button>

        <button id="open-nav-btn" type="button" class="p-2 rounded-full text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none transition-colors" aria-label="More options">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="5" r="1.75"></circle>
                <circle cx="12" cy="12" r="1.75"></circle>
                <circle cx="12" cy="19" r="1.75"></circle>
            </svg>
        </button>
        <!-- Legacy alias kept for any gear-button callers -->
        <button id="open-settings-gear-btn" type="button" class="hidden" tabindex="-1" aria-hidden="true"></button>
    </div>
</header>

<script is:inline>
    // Instant day label so cold boot never shows a blank shell
    (function () {
      try {
        var el = document.getElementById('current-day');
        if (!el) return;
        var names = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        var d = new Date();
        var day = d.getDay();
        var type = day === 0 ? 'No Service' : (day === 6 ? 'Saturday Schedule' : 'Weekday Schedule');
        var typeClass = day === 0
          ? 'font-bold text-red-600 dark:text-red-400 ml-1'
          : 'font-bold text-blue-600 dark:text-blue-400 ml-1';
        el.innerHTML = names[day] + ' <span class="' + typeClass + '">' + type + '</span>';
      } catch (e) { /* keep Getting schedules… */ }
    })();
</script>
<script>
    // @ts-nocheck
    const openSettings = () => {
        if (typeof window.openAppHub === 'function') {
            window.openAppHub();
            return;
        }
        const sidenav = document.getElementById('sidenav');
        const overlay = document.getElementById('sidenav-overlay');
        sidenav?.classList.remove('-translate-x-full', 'translate-x-full');
        sidenav?.classList.add('translate-x-0', 'open');
        if (overlay) {
            overlay.classList.remove('hidden');
            overlay.classList.add('open');
            setTimeout(() => overlay.classList.remove('opacity-0'), 10);
        }
        document.body.classList.add('sidenav-open', 'modal-active');
    };

    document.getElementById('open-nav-btn')?.addEventListener('click', openSettings);
    document.getElementById('open-settings-gear-btn')?.addEventListener('click', openSettings);
</script>
