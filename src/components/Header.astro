---
// src/components/Header.astro
---

<header class="pt-2 px-3 pb-1 bg-white/85 dark:bg-gray-800/95 backdrop-blur-xl z-20 shadow-sm relative flex flex-col justify-center min-h-[85px] border-b border-gray-200/50 dark:border-gray-800/50">
    
    <!-- Absolute Hamburger Menu -->
    <button id="open-nav-btn" class="absolute top-2 left-4 p-2 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 focus:outline-none hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors z-30" aria-label="Open App Hub">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
    </button>
    
    <!-- Absolute Service Alert Bell (Hidden by default) -->
    <button id="notice-bell" class="hidden absolute top-4 right-4 z-50 p-1.5 rounded-full bg-red-100 dark:bg-red-900 text-red-600 dark:text-red-300 shadow-md focus:outline-none hover:scale-105 transition-transform" aria-label="Service Alert">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
        <span id="notice-dot" class="absolute top-0 right-0 block h-2.5 w-2.5 rounded-full ring-2 ring-white dark:ring-gray-800 bg-red-600 transform translate-x-1/4 -translate-y-1/4 hidden"></span>
    </button>

    <!-- Centered Title -->
    <div class="text-center w-full mt-7 pt-2 relative z-10">
        <h1 id="app-title" class="text-2xl font-black text-gray-900 dark:text-white select-none cursor-pointer tracking-tight leading-none mb-3">Metrorail Next Train</h1>
        
        <div class="flex flex-col items-center mt-1">
            <p id="current-time" class="text-base text-gray-700 dark:text-gray-300 font-bold leading-tight">--:--:--</p>
            <p id="current-day" class="text-sm font-medium text-gray-500 dark:text-gray-400 mt-0.5 leading-tight">Loading...</p>
            <p id="last-updated-date-hidden" class="hidden text-[10px] text-gray-400 dark:text-gray-500 font-medium uppercase tracking-wide mt-1"></p>
        </div>
    </div>
</header>

<script>
    // Component-scoped UI Logic
    const openNavBtn = document.getElementById('open-nav-btn');
    openNavBtn?.addEventListener('click', () => {
        const sidenav = document.getElementById('sidenav');
        const overlay = document.getElementById('sidenav-overlay');
        
        if (sidenav) sidenav.classList.remove('-translate-x-full');
        if (sidenav) sidenav.classList.add('translate-x-0', 'open');
        
        if (overlay) {
            overlay.classList.remove('hidden');
            // Small timeout to allow display:block to apply before opacity transition
            setTimeout(() => overlay.classList.remove('opacity-0'), 10);
        }
        
        document.body.classList.add('sidenav-open', 'modal-active');
    });
</script>