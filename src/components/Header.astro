---
// SPA-parity header: hamburger left · centered brand · alert bell right
---

<!-- z-index omitted on purpose: a z-* here traps the hamburger under an absolute maintenance strip -->
<div class="pt-2 px-3 pb-1 bg-white/85 dark:bg-gray-800/95 backdrop-blur-xl shadow-sm relative flex flex-col justify-center min-h-[85px] dark:border-b dark:border-gray-800/50" id="app-header">

    <div id="offline-wrapper" class="absolute top-0 left-0 right-0 flex justify-center z-[60] pointer-events-none">
        <div id="offline-indicator" style="display: none;" class="pointer-events-auto w-max bg-amber-400 text-gray-900 border-amber-500 border-b border-x border-t-0 dark:bg-gray-900/95 dark:text-amber-400 dark:border-amber-500/80 dark:shadow-[0_4px_12px_rgba(245,158,11,0.15)] backdrop-blur-md text-xs font-black uppercase px-4 py-1 rounded-b-lg shadow-md flex items-center justify-center tracking-widest whitespace-nowrap transition-colors">
            WORKING OFFLINE
        </div>
    </div>

    <!-- Symmetry: #notice-bell must keep the same layout tokens as #open-nav-btn (hub.js resets severity colors only). -->
    <button id="open-nav-btn" type="button" class="absolute top-2 left-4 z-[70] p-2 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 shadow-sm focus:outline-none hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors" aria-label="Open App Hub">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
    </button>

    <button id="notice-bell" type="button" class="hidden absolute top-2 right-4 z-[70] p-2 rounded-full bg-red-100 dark:bg-red-900 text-red-600 dark:text-red-300 shadow-sm focus:outline-none hover:bg-red-200 dark:hover:bg-red-800 transition-colors" aria-label="Service Alert">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
        <span id="notice-dot" class="absolute top-0 right-0 block h-2.5 w-2.5 rounded-full ring-2 ring-white dark:ring-gray-800 bg-red-600 transform translate-x-1/4 -translate-y-1/4 hidden"></span>
    </button>

    <div class="text-center w-full mt-6 pt-1.5 relative z-10">
        <h1 id="app-title" class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400 select-none cursor-pointer tracking-tighter leading-none mb-2 drop-shadow-sm">Next Train</h1>

        <div class="flex flex-col items-center mt-0.5">
            <p id="current-day" class="text-sm font-bold text-gray-500 dark:text-gray-400 leading-tight">Getting schedules…</p>
            <!-- Sim clock only — diagnostic, shown by logic.js when $isSimMode -->
            <p id="current-time" class="hidden mt-0.5 text-[10px] font-mono text-amber-700 dark:text-amber-400 tabular-nums" aria-hidden="true"></p>
        </div>
        <p id="last-updated-date-hidden" class="hidden text-[10px] text-gray-400 dark:text-gray-500 font-medium uppercase tracking-wide mt-1"></p>
    </div>

    <!-- Legacy alias kept for any gear-button callers -->
    <button id="open-settings-gear-btn" type="button" class="hidden" tabindex="-1" aria-hidden="true"></button>
</div>

<script is:inline>
    // Instant day label so cold boot never shows a blank “Loading…” shell
    (function () {
      try {
        var el = document.getElementById('current-day');
        if (!el) return;
        var names = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        var d = new Date();
        var day = d.getDay();
        var type = day === 0 ? 'No Service' : (day === 6 ? 'Saturday Schedule' : 'Weekday Schedule');
        var typeClass = day === 0
          ? 'font-bold text-red-600 dark:text-red-400 ml-1'
          : 'font-bold text-blue-600 dark:text-blue-400 ml-1';
        el.innerHTML = names[day] + ' <span class="' + typeClass + '">' + type + '</span>';
      } catch (e) { /* keep Getting schedules… */ }
    })();
</script>
<script>
    // @ts-nocheck
    const openSettings = () => {
        if (typeof window.openAppHub === 'function') {
            window.openAppHub();
            return;
        }
        const sidenav = document.getElementById('sidenav');
        const overlay = document.getElementById('sidenav-overlay');
        sidenav?.classList.remove('-translate-x-full', 'translate-x-full');
        sidenav?.classList.add('translate-x-0', 'open');
        if (overlay) {
            overlay.classList.remove('hidden');
            overlay.classList.add('open');
            setTimeout(() => overlay.classList.remove('opacity-0'), 10);
        }
        document.body.classList.add('sidenav-open', 'modal-active');
    };

    document.getElementById('open-nav-btn')?.addEventListener('click', openSettings);
    document.getElementById('open-settings-gear-btn')?.addEventListener('click', openSettings);
</script>
