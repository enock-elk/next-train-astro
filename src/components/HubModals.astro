<!-- SERVICE ALERT -->
<div id="notice-modal" class="fixed inset-0 bg-black bg-opacity-80 z-[125] hidden flex items-center justify-center p-4 backdrop-blur-sm transition-opacity duration-300">
    <div id="notice-modal-card" class="bg-white dark:bg-gray-800 rounded-xl shadow-2xl w-full max-w-sm p-6 transform transition-all scale-100 border-l-4 border-red-500 flex flex-col max-h-[85dvh] overflow-y-auto custom-scrollbar">
        <div class="flex justify-between items-start mb-4 shrink-0">
            <div class="flex items-center text-red-600 dark:text-red-400">
                <h3 id="notice-modal-title" class="text-lg font-bold text-gray-900 dark:text-white">Service Alert</h3>
            </div>
            <button type="button" onclick="if(location.hash==='#notice')history.back();else closeSmoothModal('notice-modal')" class="text-gray-400 hover:text-gray-500 focus:outline-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div id="notice-content" class="nt-rich-body text-gray-700 dark:text-gray-300 text-sm mb-4 leading-relaxed"></div>
        <p id="notice-timestamp" class="text-xs text-gray-400 dark:text-gray-500 font-mono mb-4 border-t border-gray-100 dark:border-gray-700 pt-2"></p>
        <button type="button" id="notice-modal-close-btn" onclick="if(location.hash==='#notice')history.back();else closeSmoothModal('notice-modal')" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg shadow-sm transition-colors focus:outline-none">Close</button>
    </div>
</div>

<!-- ON-TRAIN SHARE / CLOSEST-TRAIN / LOCATE PROMPT -->
<div id="nt-on-train-sheet" class="fixed inset-0 z-[140] hidden flex items-end sm:items-center justify-center p-4 bg-gray-900/50 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="nt-on-train-title">
    <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-2xl w-full max-w-sm border border-gray-200 dark:border-gray-700 p-5">
        <h3 id="nt-on-train-title" class="text-base font-black text-gray-900 dark:text-white tracking-tight">Show others where you are?</h3>
        <p id="nt-on-train-body" class="mt-2 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">Share a rough location for 10 minutes so others on this corridor can see you.</p>
        <div class="mt-5 flex flex-col gap-2">
            <button type="button" id="nt-on-train-primary" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold focus:outline-none">Show where I am</button>
            <button type="button" id="nt-on-train-secondary" class="w-full py-3 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 text-sm font-bold focus:outline-none">Not now</button>
            <button type="button" id="nt-on-train-tertiary" class="hidden w-full py-2 text-[12px] font-semibold text-gray-500 dark:text-gray-400 focus:outline-none">Cancel</button>
        </div>
    </div>
</div>

<!-- TRAINS NEAR YOU -->
<div id="nt-nearby-trains-modal" class="fixed inset-0 z-[145] hidden flex items-end sm:items-center justify-center p-0 sm:p-4 bg-gray-900/55 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="nt-nearby-title">
    <div class="bg-white dark:bg-gray-900 rounded-t-2xl sm:rounded-2xl shadow-2xl w-full max-w-md max-h-[88dvh] flex flex-col border border-gray-200 dark:border-gray-700">
        <div class="shrink-0 px-5 pt-4 pb-3 border-b border-gray-100 dark:border-gray-800">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                    <h3 id="nt-nearby-title" class="text-lg font-black text-gray-900 dark:text-white tracking-tight">Trains near you</h3>
                    <p id="nt-nearby-sub" class="mt-1 text-[12px] text-gray-500 dark:text-gray-400 leading-snug">Pick a train only if you’re close to its path. Otherwise others still see you — just not as a tracker.</p>
                </div>
                <button type="button" id="nt-nearby-close" class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-500 focus:outline-none" aria-label="Close">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>
        <div id="nt-nearby-list" class="flex-1 overflow-y-auto custom-scrollbar px-4 py-3 space-y-2 min-h-[8rem]"></div>
        <p id="nt-nearby-empty" class="hidden px-5 py-6 text-sm font-semibold text-gray-500 dark:text-gray-400 text-center">No trains in the next 30 minutes on this corridor.</p>
        <div class="shrink-0 p-4 border-t border-gray-100 dark:border-gray-800 flex flex-col gap-2">
            <button type="button" id="nt-nearby-presence" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold focus:outline-none">Just show where I am</button>
            <button type="button" id="nt-nearby-dismiss" class="w-full py-2.5 text-[12px] font-semibold text-gray-500 dark:text-gray-400 focus:outline-none">Close</button>
        </div>
    </div>
</div>

<!-- LIVE TRAIN TRACKER (station list) -->
<div id="nt-live-tracker-modal" class="fixed inset-0 z-[146] hidden flex items-end sm:items-center justify-center p-0 sm:p-4 bg-gray-900/55 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="nt-live-tracker-title">
    <div class="bg-white dark:bg-gray-900 rounded-t-2xl sm:rounded-2xl shadow-2xl w-full max-w-md max-h-[88dvh] flex flex-col border border-gray-200 dark:border-gray-700">
        <div class="shrink-0 px-5 pt-4 pb-3 border-b border-gray-100 dark:border-gray-800">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                    <h3 id="nt-live-tracker-title" class="text-lg font-black text-gray-900 dark:text-white tracking-tight">Live train</h3>
                    <p id="nt-live-tracker-sub" class="mt-1 text-[12px] text-gray-500 dark:text-gray-400 leading-snug">Where verified riders are on this corridor right now.</p>
                </div>
                <button type="button" id="nt-live-tracker-close" class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-500 focus:outline-none" aria-label="Close">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>
        <div id="nt-live-tracker-list" class="flex-1 overflow-y-auto custom-scrollbar px-5 py-4 min-h-[8rem]"></div>
        <div class="shrink-0 p-4 border-t border-gray-100 dark:border-gray-800">
            <button type="button" id="nt-live-tracker-dismiss" class="w-full py-2.5 text-[12px] font-semibold text-gray-500 dark:text-gray-400 focus:outline-none">Close</button>
        </div>
    </div>
</div>
