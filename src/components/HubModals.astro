---
// Hub / admin-adjacent modals: feedback, about, notices, login, developer panel
---

<!-- FEEDBACK -->
<div id="feedback-modal" class="fixed inset-0 bg-gray-900/60 z-[130] hidden flex items-center justify-center p-4 backdrop-blur-md transition-opacity duration-300">
    <div class="bg-white/95 dark:bg-gray-900/95 backdrop-blur-2xl rounded-2xl shadow-2xl w-full max-w-md max-h-[90dvh] flex flex-col transform transition-all scale-95 border border-white/40 dark:border-gray-700/50">
        <div class="p-5 border-b border-gray-200/50 dark:border-gray-800/50 flex justify-between items-center bg-transparent rounded-t-2xl shrink-0">
            <h3 class="text-lg font-black text-gray-900 dark:text-white flex items-center tracking-tight">
                <svg class="w-5 h-5 mr-2 text-blue-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.9 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>
                Send Feedback
            </h3>
            <button type="button" onclick="closeSmoothModal('feedback-modal')" class="p-2 rounded-full bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white transition focus:outline-none" aria-label="Close Feedback">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div id="feedback-reply-context" class="hidden"></div>
        <div class="p-6 overflow-y-auto flex-grow space-y-5 custom-scrollbar">
            <div>
                <label class="block text-[11px] font-bold text-gray-500 dark:text-gray-400 uppercase mb-2 tracking-wider">What's on your mind?</label>
                <select id="feedback-type" class="w-full p-3.5 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-sm font-medium text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all shadow-inner appearance-none">
                    <option value="general">General Feedback</option>
                    <option value="schedule_error">Schedule / Time Error</option>
                    <option value="bug">App Bug or Glitch</option>
                    <option value="suggestion">Feature Suggestion</option>
                </select>
            </div>
            <div>
                <label class="block text-[11px] font-bold text-gray-500 dark:text-gray-400 uppercase mb-2 tracking-wider">Details</label>
                <textarea id="feedback-text" rows="6" class="w-full p-3.5 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-sm font-medium text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all shadow-inner resize-none" placeholder="Tell us what you noticed..."></textarea>
            </div>
            <details class="group bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300">
                <summary class="cursor-pointer flex items-center justify-between p-3.5 text-[11px] font-bold text-gray-600 dark:text-gray-300 uppercase tracking-wider select-none focus:outline-none hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                    <div class="flex items-center"><span class="text-base mr-2">📎</span> Add Attachment (Optional)</div>
                    <svg class="w-4 h-4 text-gray-400 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </summary>
                <div class="p-4 pt-1 border-t border-gray-200 dark:border-gray-700">
                    <label for="feedback-file" class="cursor-pointer flex flex-col items-center justify-center w-full py-4 px-4 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-xl hover:bg-blue-50 dark:hover:bg-gray-700/50 hover:border-blue-300 dark:hover:border-gray-500 transition-all">
                        <span class="text-2xl mb-1">🖼️</span>
                        <span class="text-xs font-bold text-gray-600 dark:text-gray-400 transition-colors" id="feedback-file-label">Attach Images/PDFs (Max 4, 5MB each)</span>
                        <input type="file" id="feedback-file" class="hidden" accept="image/*,.pdf" multiple>
                    </label>
                    <div id="feedback-file-preview" class="hidden mt-3 flex items-center justify-between p-3 bg-blue-50 dark:bg-blue-900/30 rounded-xl border border-blue-100 dark:border-blue-800/50 shadow-sm">
                        <div class="flex items-center min-w-0 pr-2">
                            <span class="text-blue-500 dark:text-blue-400 mr-2 shrink-0">📄</span>
                            <span id="feedback-file-name" class="text-xs font-bold text-blue-800 dark:text-blue-300 truncate">filename.jpg</span>
                        </div>
                        <button type="button" id="feedback-file-remove" class="text-gray-400 hover:text-red-500 transition-colors focus:outline-none shrink-0 p-1">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                </div>
            </details>
            <div class="pt-2 border-t border-gray-100 dark:border-gray-700">
                <label class="block text-[11px] font-bold text-gray-500 dark:text-gray-400 uppercase mb-2 tracking-wider">WhatsApp / Email (Optional)</label>
                <input type="text" id="feedback-email" class="w-full p-3.5 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-sm font-medium text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all shadow-inner" placeholder="Leave your number or email for a reply">
                <p class="text-[9px] text-gray-400 mt-1.5 flex items-start"><span class="mr-1">🔒</span> We will only use this to reply to your specific feedback.</p>
            </div>
        </div>
        <div class="p-4 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 rounded-b-2xl flex space-x-3 shrink-0">
            <button type="button" onclick="closeSmoothModal('feedback-modal')" class="flex-1 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-800 dark:text-gray-200 font-bold py-3.5 rounded-xl transition-colors focus:outline-none text-sm">Cancel</button>
            <button type="button" id="feedback-submit-btn" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 rounded-xl shadow-md transition-colors focus:outline-none text-sm flex items-center justify-center">
                <span id="feedback-submit-text">Submit</span>
                <svg id="feedback-spinner" class="w-4 h-4 ml-2 animate-spin hidden" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            </button>
        </div>
    </div>
</div>

<!-- ABOUT -->
<div id="about-modal" class="fixed inset-0 bg-white dark:bg-gray-900 z-[120] hidden flex flex-col items-center p-0 full-screen transition-opacity duration-300 overflow-y-auto">
    <div class="w-full max-w-2xl p-6 flex justify-end sticky top-0 bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm z-20">
        <button type="button" id="close-about-btn" class="p-2 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition shadow-sm focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>
    <div class="w-full max-w-md px-6 pb-12 flex flex-col items-center text-center">
        <img src="/icons/loading-logo.png" class="w-20 h-20 mb-4 shadow-lg rounded-full" alt="Next Train Logo" onerror="this.style.display='none'">
        <h2 id="about-app-title" class="text-3xl font-black text-gray-900 dark:text-white mb-2 select-none">Next Train</h2>
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 text-xs font-bold uppercase tracking-wider mb-6">Unofficial & Independent</div>
        <div class="text-center space-y-4 text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-8">
            <p><span class="text-2xl block mb-2">🙋‍♂️</span> The idea for <strong>Next Train</strong> first sparked in 2023, but it was during mid-November 2025 that building began with a simple mission: to replace blurry notice photos and crowded station boards with clear, digital accuracy.</p>
            <p>What began as a tool for family has grown to help thousands of commuters. While this remains an <strong>independent passion project</strong> (not an official PRASA tool), it is built with the reliability our community deserves.</p>
        </div>
        <div class="w-full bg-gray-50 dark:bg-gray-800 rounded-xl p-4 mb-6 shadow-inner border border-gray-100 dark:border-gray-700">
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-3">Built & Maintained By</p>
            <div class="flex items-center justify-center space-x-3">
                <div class="text-right">
                    <p class="text-base font-bold text-gray-900 dark:text-white leading-tight">Enock Kazembe</p>
                    <p class="text-[10px] text-gray-500 uppercase tracking-wide mt-0.5">Lead Developer</p>
                </div>
                <div class="h-8 w-px bg-gray-300 dark:bg-gray-700"></div>
                <div class="flex flex-col space-y-1.5">
                    <a href="https://www.facebook.com/enock.kazembe/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center px-3 py-1 bg-[#1877F2] hover:bg-blue-700 text-white rounded font-bold text-[10px] transition-colors shadow-sm">Facebook</a>
                    <button type="button" id="about-contact-btn" class="flex items-center justify-center px-3 py-1 bg-gray-800 hover:bg-gray-900 dark:bg-gray-600 dark:hover:bg-gray-500 text-white rounded font-bold text-[10px] transition-colors shadow-sm focus:outline-none"><span class="mr-1.5">✉️</span> Contact Enock</button>
                </div>
            </div>
        </div>
        <p id="about-version-label" class="mt-8 text-[10px] text-gray-400 font-mono">Version (Guardian Edition)</p>
    </div>
</div>

<!-- LOGIN -->
<div id="login-modal" class="fixed inset-0 bg-black bg-opacity-80 z-[120] hidden flex items-center justify-center p-4 backdrop-blur-sm transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-sm p-8 transform transition-all scale-95 border border-gray-200 dark:border-gray-700">
        <div class="flex justify-center mb-4">
            <div class="bg-blue-100 dark:bg-blue-900/30 p-3 rounded-full text-blue-600 dark:text-blue-400">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"></path></svg>
            </div>
        </div>
        <h3 id="admin-gateway" class="text-xl font-black text-gray-900 dark:text-white mb-1 text-center tracking-tight">Admin Gateway</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400 text-center mb-6">Restricted access protocol.</p>
        <div class="space-y-4">
            <div>
                <label class="block text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase mb-1">Email</label>
                <input type="email" id="admin-email" class="w-full p-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all" placeholder="admin@nexttrain.co.za">
            </div>
            <div>
                <label class="block text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase mb-1">Password</label>
                <div class="relative">
                    <input type="password" id="admin-password" class="w-full p-3 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all pr-12" placeholder="••••••••">
                    <button type="button" id="toggle-password-btn" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-blue-500 transition-colors focus:outline-none h-full w-10 justify-center">
                        <svg id="eye-open-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                        <svg id="eye-closed-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.978 9.978 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path></svg>
                    </button>
                </div>
            </div>
        </div>
        <div class="flex space-x-3 mt-8">
            <button type="button" id="admin-cancel-btn" class="flex-1 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-800 dark:text-gray-200 py-3 rounded-xl font-bold transition-colors focus:outline-none text-sm">Cancel</button>
            <button type="button" id="admin-login-btn" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-bold shadow-md transition-colors focus:outline-none text-sm flex items-center justify-center">
                <span>Sign In</span>
                <svg id="admin-login-spinner" class="w-4 h-4 ml-2 animate-spin hidden" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            </button>
        </div>
    </div>
</div>

<!-- DEV / ADMIN PANEL -->
<div id="dev-modal" class="fixed inset-0 bg-black bg-opacity-90 z-[120] hidden flex items-center justify-center p-4 backdrop-blur-md transition-opacity duration-300 overflow-y-auto">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-2xl w-full max-w-md p-6 transform transition-all scale-100 my-auto">
        <div class="flex justify-between items-center mb-6 border-b border-gray-200 dark:border-gray-700 pb-4">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center">
                <span class="text-2xl mr-2">🛠️</span> Developer Mode
            </h3>
            <button type="button" onclick="closeSmoothModal('dev-modal')" class="text-gray-400 hover:text-gray-500 p-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full transition-colors focus:outline-none" aria-label="Close Dev Modal">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div id="telemetry-panel" class="bg-white dark:bg-gray-800 rounded-xl shadow-md border border-gray-200 dark:border-gray-700 p-4 mb-4 relative overflow-hidden transition-all duration-300">
            <button type="button" id="telemetry-header-btn" class="w-full text-left text-xs font-bold text-gray-400 uppercase tracking-wider flex items-center justify-between focus:outline-none mb-4">
                <span class="flex items-center">
                    <span class="mr-2">📊</span> Live Telemetry
                    <span id="telemetry-last-sync" class="hidden ml-2 text-[9px] font-mono text-gray-400 dark:text-gray-500 lowercase opacity-60 tracking-normal">synced: --:--:--</span>
                </span>
                <svg id="telemetry-chevron" class="w-4 h-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div id="telemetry-body" class="space-y-3">
                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-green-50 dark:bg-green-900/20 p-3 rounded-lg border border-green-100 dark:border-green-800 flex flex-col items-center justify-center">
                        <span class="text-[10px] text-green-600 dark:text-green-400 font-bold uppercase tracking-wider mb-1">Last 5 Mins</span>
                        <span id="stat-5m" class="text-2xl font-black text-green-700 dark:text-green-300 animate-pulse">--</span>
                    </div>
                    <div class="bg-blue-50 dark:bg-blue-900/20 p-3 rounded-lg border border-blue-100 dark:border-blue-800 flex flex-col items-center justify-center">
                        <span class="text-[10px] text-blue-600 dark:text-blue-400 font-bold uppercase tracking-wider mb-1">Last 30 Mins</span>
                        <span id="stat-30m" class="text-2xl font-black text-blue-700 dark:text-blue-300 animate-pulse">--</span>
                    </div>
                    <div class="bg-indigo-50 dark:bg-indigo-900/20 p-3 rounded-lg border border-indigo-100 dark:border-indigo-800 flex flex-col items-center justify-center">
                        <span class="text-[10px] text-indigo-600 dark:text-indigo-400 font-bold uppercase tracking-wider mb-1">Today</span>
                        <span id="stat-today" class="text-2xl font-black text-indigo-700 dark:text-indigo-300 animate-pulse">--</span>
                    </div>
                    <div class="bg-teal-50 dark:bg-teal-900/20 p-3 rounded-lg border border-teal-100 dark:border-teal-800 flex flex-col items-center justify-center">
                        <span class="text-[10px] text-teal-600 dark:text-teal-400 font-bold uppercase tracking-wider mb-1">7 Days (WAU)</span>
                        <span id="stat-weekly" class="text-2xl font-black text-teal-700 dark:text-teal-300 animate-pulse">--</span>
                    </div>
                    <div class="bg-cyan-50 dark:bg-cyan-900/20 p-3 rounded-lg border border-cyan-100 dark:border-cyan-800 flex flex-col items-center justify-center">
                        <span class="text-[10px] text-cyan-600 dark:text-cyan-400 font-bold uppercase tracking-wider mb-1">30 Days (MAU)</span>
                        <span id="stat-monthly" class="text-2xl font-black text-cyan-700 dark:text-cyan-300 animate-pulse">--</span>
                    </div>
                    <div class="bg-purple-50 dark:bg-purple-900/20 p-3 rounded-lg border border-purple-100 dark:border-purple-800 flex flex-col items-center justify-center">
                        <span class="text-[10px] text-purple-600 dark:text-purple-400 font-bold uppercase tracking-wider mb-1">All-Time</span>
                        <span id="stat-alltime" class="text-2xl font-black text-purple-700 dark:text-purple-300 animate-pulse">--</span>
                    </div>
                </div>
                <div class="bg-red-50 dark:bg-red-900/20 p-3 rounded-lg border border-red-100 dark:border-red-800 flex items-center justify-between">
                    <span class="text-[10px] text-red-600 dark:text-red-400 font-bold uppercase tracking-wider flex items-center"><span class="mr-1">🚨</span> System Errors (Today)</span>
                    <span id="stat-errors" class="text-lg font-black text-red-700 dark:text-red-300 animate-pulse">--</span>
                </div>
            </div>
        </div>
        <div id="admin-modules-container">
            <div id="alert-panel" data-admin-loaded="false"></div>
        </div>
        <div id="admin-signout-container"></div>
    </div>
</div>

<!-- ADMIN REPLY -->
<div id="developer-reply-modal" class="fixed inset-0 bg-black bg-opacity-80 z-[140] hidden flex items-center justify-center p-4 backdrop-blur-sm transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-sm p-6 transform transition-all scale-95 border border-gray-200 dark:border-gray-700">
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center space-x-2">
                <span class="text-2xl">💬</span>
                <h3 class="text-lg font-black text-gray-900 dark:text-white tracking-tight">Message from Admin</h3>
            </div>
            <button type="button" onclick="closeSmoothModal('developer-reply-modal')" class="text-gray-400 hover:text-gray-500 focus:outline-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div id="developer-reply-content" class="bg-gray-50 dark:bg-gray-900 p-4 rounded-xl border border-gray-200 dark:border-gray-700 text-sm text-gray-800 dark:text-gray-200 leading-relaxed whitespace-pre-wrap mb-6">Loading message...</div>
        <div id="admin-message-actions" class="w-full">
            <button type="button" id="mark-reply-read-btn" class="w-full bg-gray-900 hover:bg-black dark:bg-gray-700 dark:hover:bg-gray-600 text-white font-bold py-3 rounded-xl shadow-md transition-colors focus:outline-none">Got it, Thanks!</button>
        </div>
    </div>
</div>

<!-- SERVICE ALERT -->
<div id="notice-modal" class="fixed inset-0 bg-black bg-opacity-80 z-[110] hidden flex items-center justify-center p-4 backdrop-blur-sm transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-2xl w-full max-w-sm p-6 transform transition-all scale-100 border-l-4 border-red-500 flex flex-col max-h-[85dvh] overflow-y-auto custom-scrollbar">
        <div class="flex justify-between items-start mb-4 shrink-0">
            <div class="flex items-center text-red-600 dark:text-red-400">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">Service Alert</h3>
            </div>
            <button type="button" onclick="closeSmoothModal('notice-modal')" class="text-gray-400 hover:text-gray-500 focus:outline-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <p id="notice-content" class="text-gray-700 dark:text-gray-300 text-sm mb-4 leading-relaxed"></p>
        <p id="notice-timestamp" class="text-xs text-gray-400 dark:text-gray-500 font-mono mb-4 border-t border-gray-100 dark:border-gray-700 pt-2"></p>
        <button type="button" onclick="closeSmoothModal('notice-modal')" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg shadow-sm transition-colors focus:outline-none">Close</button>
    </div>
</div>
