---
// Hub / admin-adjacent modals: feedback, about, notices, login, developer panel
import { withBase } from '../lib/config.js';
---

<!-- FEEDBACK -->
<div id="feedback-modal" class="fixed inset-0 bg-gray-900/60 z-[130] hidden flex items-center justify-center p-4 backdrop-blur-md transition-opacity duration-300">
    <div class="bg-white/95 dark:bg-gray-900/95 backdrop-blur-2xl rounded-2xl shadow-2xl w-full max-w-md max-h-[90dvh] flex flex-col transform transition-all scale-95 border border-white/40 dark:border-gray-700/50">
        <div class="p-5 border-b border-gray-200/50 dark:border-gray-800/50 flex justify-between items-center bg-transparent rounded-t-2xl shrink-0">
            <h3 class="text-lg font-black text-gray-900 dark:text-white flex items-center tracking-tight">
                <svg class="w-5 h-5 mr-2 text-blue-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.9 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>
                Send Feedback
            </h3>
            <button type="button" onclick="closeSmoothModal('feedback-modal')" class="p-2 rounded-full bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white transition focus:outline-none" aria-label="Close Feedback">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="p-6 pb-8 overflow-y-auto flex-grow space-y-5 custom-scrollbar min-h-0">
            <div id="feedback-reply-context" class="hidden"></div>
            <div id="feedback-type-wrap">
                <label class="block text-[11px] font-bold text-gray-500 dark:text-gray-400 uppercase mb-2 tracking-wider">What's on your mind?</label>
                <div class="relative">
                    <select id="feedback-type" class="w-full p-3.5 pr-10 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-sm font-medium text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all shadow-inner appearance-none">
                        <option value="general">General Feedback</option>
                        <option value="schedule_error">Schedule / Time Error</option>
                        <option value="bug">App Bug or Glitch</option>
                        <option value="suggestion">Feature Suggestion</option>
                    </select>
                    <svg class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
            </div>
            <div>
                <label class="block text-[11px] font-bold text-gray-500 dark:text-gray-400 uppercase mb-2 tracking-wider">Details</label>
                <textarea id="feedback-text" rows="5" class="w-full p-3.5 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-sm font-medium text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all shadow-inner resize-none" placeholder="Tell us what you noticed..."></textarea>
                <p id="feedback-mod-hint" class="mt-1.5 text-[11px] font-semibold text-amber-700 dark:text-amber-300 min-h-[1rem]" aria-live="polite"></p>
            </div>
            <details class="group bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300">
                <summary class="cursor-pointer flex items-center justify-between p-3.5 text-[11px] font-bold text-gray-600 dark:text-gray-300 uppercase tracking-wider select-none focus:outline-none hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                    <div class="flex items-center"><svg class="w-4 h-4 mr-2 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg> Add Attachment (Optional)</div>
                    <svg class="w-4 h-4 text-gray-400 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </summary>
                <div class="p-4 pt-1 border-t border-gray-200 dark:border-gray-700">
                    <label for="feedback-file" class="cursor-pointer flex flex-col items-center justify-center w-full py-4 px-4 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-xl hover:bg-blue-50 dark:hover:bg-gray-700/50 hover:border-blue-300 dark:hover:border-gray-500 transition-all">
                        <svg class="w-8 h-8 mb-1 text-blue-500 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5L5 21"/></svg>
                        <span class="text-xs font-bold text-gray-600 dark:text-gray-400 transition-colors" id="feedback-file-label">Attach Images/PDFs (Max 4, 5MB each)</span>
                        <input type="file" id="feedback-file" class="hidden" accept="image/*,.pdf" multiple>
                    </label>
                    <div id="feedback-file-preview" class="hidden mt-3 flex items-center justify-between p-3 bg-blue-50 dark:bg-blue-900/30 rounded-xl border border-blue-100 dark:border-blue-800/50 shadow-sm">
                        <div class="flex items-center min-w-0 pr-2">
                            <svg class="w-4 h-4 text-blue-500 dark:text-blue-400 mr-2 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
                            <span id="feedback-file-name" class="text-xs font-bold text-blue-800 dark:text-blue-300 truncate">filename.jpg</span>
                        </div>
                        <button type="button" id="feedback-file-remove" class="text-gray-400 hover:text-red-500 transition-colors focus:outline-none shrink-0 p-1">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                </div>
            </details>
            <div class="pt-2 border-t border-gray-100 dark:border-gray-700">
                <label class="block text-[11px] font-bold text-gray-500 dark:text-gray-400 uppercase mb-2 tracking-wider">WhatsApp / Email (Optional)</label>
                <input type="text" id="feedback-email" class="w-full p-3.5 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-sm font-medium text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all shadow-inner" placeholder="Leave your number or email for a reply">
                <p class="text-[9px] text-gray-400 mt-1.5 leading-snug">
                    We will only use this to reply to your specific feedback.
                </p>
                <button type="button" id="feedback-privacy-link" class="mt-1.5 inline-flex items-center gap-1 text-[9px] text-gray-400 underline underline-offset-2 decoration-gray-400 hover:text-blue-600 dark:hover:text-blue-400 font-medium focus:outline-none">
                    <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                    Privacy Policy
                </button>
            </div>
        </div>
        <div class="p-4 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 rounded-b-2xl flex space-x-3 shrink-0">
            <button type="button" onclick="closeSmoothModal('feedback-modal')" class="flex-1 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-800 dark:text-gray-200 font-bold py-3.5 rounded-xl transition-colors focus:outline-none text-sm">Cancel</button>
            <button type="button" id="feedback-submit-btn" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 rounded-xl shadow-md transition-colors focus:outline-none text-sm flex items-center justify-center">
                <span id="feedback-submit-text">Submit</span>
                <svg id="feedback-spinner" class="w-4 h-4 ml-2 animate-spin hidden" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            </button>
        </div>
    </div>
</div>

<!-- PER-TRAIN STATUS REPORT -->
<div id="delay-report-modal" class="fixed inset-0 bg-gray-900/60 z-[130] hidden flex items-center justify-center p-4 backdrop-blur-md transition-opacity duration-300">
    <div class="bg-white/95 dark:bg-gray-900/95 backdrop-blur-2xl rounded-2xl shadow-2xl w-full max-w-sm max-h-[90dvh] flex flex-col transform transition-all scale-95 border border-white/40 dark:border-gray-700/50 overflow-hidden">
        <div class="p-4 border-b border-gray-200/50 dark:border-gray-800/50 flex justify-between items-center shrink-0">
            <div class="min-w-0 pr-2">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Live board</p>
                <h3 id="train-report-title" class="text-base font-black text-gray-900 dark:text-white tracking-tight truncate">Report this train</h3>
                <p id="train-report-sub" class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5 leading-snug"></p>
            </div>
            <button type="button" id="delay-report-cancel" class="p-2 rounded-full bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-600 dark:text-gray-300 transition focus:outline-none shrink-0" aria-label="Close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <input type="hidden" id="tr-route" value="" />
        <input type="hidden" id="tr-train" value="" />
        <input type="hidden" id="tr-dep" value="" />
        <input type="hidden" id="tr-arr" value="" />
        <input type="hidden" id="tr-station" value="" />
        <input type="hidden" id="tr-dest" value="" />
        <input type="hidden" id="tr-status" value="" />
        <input type="hidden" id="tr-late-bucket" value="" />

        <div class="p-5 overflow-y-auto flex-grow custom-scrollbar">
            <!-- Step 1: status -->
            <div id="tr-step-status" class="space-y-3">
                <div id="tr-ride-actions" class="hidden space-y-2 pb-3 mb-1 border-b border-gray-100 dark:border-gray-800">
                    <p class="text-[11px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Are you on it?</p>
                    <button type="button" id="tr-im-on-it" class="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold focus:outline-none">I’m on it</button>
                    <button type="button" id="tr-im-waiting" class="w-full py-2.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 text-sm font-bold focus:outline-none">I’m waiting</button>
                </div>
                <p class="text-sm font-bold text-gray-800 dark:text-gray-200">How was this train?</p>
                <button type="button" data-tr-status="early" class="tr-status-btn w-full text-left p-3.5 rounded-xl border border-amber-200 dark:border-amber-800/60 bg-amber-50/80 dark:bg-amber-950/30 hover:bg-amber-100 dark:hover:bg-amber-900/40 transition focus:outline-none">
                    <span class="block text-sm font-black text-amber-800 dark:text-amber-300">Came early</span>
                    <span class="block text-[11px] text-amber-700/80 dark:text-amber-400/80 mt-0.5">It arrived before the scheduled time.</span>
                </button>
                <button type="button" data-tr-status="on_time" class="tr-status-btn w-full text-left p-3.5 rounded-xl border border-green-200 dark:border-green-800/60 bg-green-50/80 dark:bg-green-950/30 hover:bg-green-100 dark:hover:bg-green-900/40 transition focus:outline-none">
                    <span class="block text-sm font-black text-green-800 dark:text-green-300">On time</span>
                    <span class="block text-[11px] text-green-700/80 dark:text-green-400/80 mt-0.5">It arrived around the scheduled time.</span>
                </button>
                <button type="button" data-tr-status="late" class="tr-status-btn w-full text-left p-3.5 rounded-xl border border-red-200 dark:border-red-800/60 bg-red-50/80 dark:bg-red-950/30 hover:bg-red-100 dark:hover:bg-red-900/40 transition focus:outline-none">
                    <span class="block text-sm font-black text-red-700 dark:text-red-300">Running late</span>
                    <span class="block text-[11px] text-red-600/80 dark:text-red-400/80 mt-0.5">It arrived after the scheduled time.</span>
                </button>
                <button type="button" data-tr-status="cancelled" class="tr-status-btn w-full text-left p-3.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/80 hover:bg-gray-100 dark:hover:bg-gray-800 transition focus:outline-none">
                    <span class="block text-sm font-black text-gray-800 dark:text-gray-200">Cancelled / no-show</span>
                    <span class="block text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">This train didn’t run or never arrived.</span>
                </button>
                <p id="tr-update-hint" class="hidden text-[10px] text-gray-500 dark:text-gray-400 pt-1"></p>
                <p class="text-[10px] text-gray-400 pt-1">Anonymous to other passengers. Helps build live updates for this train.</p>
            </div>

            <!-- Step 2: late detail -->
            <div id="tr-step-late" class="hidden space-y-3">
                <p class="text-sm font-bold text-gray-800 dark:text-gray-200">How late was the train?</p>
                <div class="grid grid-cols-1 gap-2">
                    <button type="button" data-tr-bucket="1-5" class="tr-bucket-btn w-full py-2.5 px-3 rounded-xl border border-gray-200 dark:border-gray-700 text-sm font-bold text-gray-800 dark:text-gray-200 hover:border-blue-500 focus:outline-none">1–5 min late</button>
                    <button type="button" data-tr-bucket="6-10" class="tr-bucket-btn w-full py-2.5 px-3 rounded-xl border border-gray-200 dark:border-gray-700 text-sm font-bold text-gray-800 dark:text-gray-200 hover:border-blue-500 focus:outline-none">6–10 min late</button>
                    <button type="button" data-tr-bucket="11-20" class="tr-bucket-btn w-full py-2.5 px-3 rounded-xl border border-gray-200 dark:border-gray-700 text-sm font-bold text-gray-800 dark:text-gray-200 hover:border-blue-500 focus:outline-none">11–20 min late</button>
                    <button type="button" data-tr-bucket="21+" class="tr-bucket-btn w-full py-2.5 px-3 rounded-xl border border-gray-200 dark:border-gray-700 text-sm font-bold text-gray-800 dark:text-gray-200 hover:border-blue-500 focus:outline-none">21+ min late</button>
                    <button type="button" data-tr-bucket="unsure" class="tr-bucket-btn w-full py-2.5 px-3 rounded-xl border border-gray-200 dark:border-gray-700 text-sm font-bold text-gray-800 dark:text-gray-200 hover:border-blue-500 focus:outline-none">Not sure</button>
                </div>
                <div>
                    <label for="tr-note" class="block text-[11px] font-bold text-gray-500 uppercase mb-1.5 tracking-wider">Add a note (optional)</label>
                    <textarea id="tr-note" rows="2" maxlength="280" class="w-full p-3 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none resize-none" placeholder="Anything else we should know?"></textarea>
                </div>
                <p id="tr-error" class="text-xs font-bold text-red-600 dark:text-red-400 min-h-[1rem]"></p>
                <div class="flex gap-2 pt-1">
                    <button type="button" id="tr-late-back" class="flex-1 py-3 rounded-xl bg-gray-200 dark:bg-gray-700 text-sm font-bold text-gray-800 dark:text-gray-200 focus:outline-none">Back</button>
                    <button type="button" id="tr-late-submit" class="flex-1 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold focus:outline-none flex items-center justify-center">
                        <span id="tr-late-submit-text">Submit report</span>
                        <svg id="tr-spinner" class="w-4 h-4 ml-2 animate-spin hidden" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Step 3: done -->
            <div id="tr-step-done" class="hidden text-center py-6 space-y-3">
                <div class="mx-auto w-14 h-14 rounded-full bg-green-100 dark:bg-green-900/40 flex items-center justify-center">
                    <svg class="w-8 h-8 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <p class="text-lg font-black text-gray-900 dark:text-white">Thanks! Report submitted.</p>
                <p id="tr-done-summary" class="text-sm text-gray-600 dark:text-gray-400"></p>
                <button type="button" id="tr-done-btn" class="mt-2 w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold focus:outline-none">Done</button>
            </div>
        </div>
    </div>
</div>

<!-- Corroboration prompt: overdue at this station, or on that train — never behind it -->
<div id="delay-ask-sheet" class="hidden fixed inset-x-0 bottom-0 z-[125] px-3 pb-[calc(5.5rem+env(safe-area-inset-bottom))] pointer-events-none" aria-hidden="true">
    <div class="pointer-events-auto mx-auto max-w-md rounded-2xl border border-amber-200 dark:border-amber-800/60 bg-white dark:bg-gray-900 shadow-2xl p-4">
        <p class="text-[10px] font-black uppercase tracking-widest text-amber-700 dark:text-amber-400">Live report</p>
        <p id="delay-ask-title" class="text-sm font-black text-gray-900 dark:text-white mt-0.5">Train</p>
        <p id="delay-ask-body" class="text-[12px] text-gray-600 dark:text-gray-300 mt-1 leading-snug">A commuter reported this train. Still true from where you are?</p>
        <div class="mt-3 grid grid-cols-3 gap-2">
            <button type="button" id="delay-ask-confirm" class="py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-[11px] font-black focus:outline-none">Confirm</button>
            <button type="button" id="delay-ask-update" class="py-2.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-100 text-[11px] font-black focus:outline-none">Update</button>
            <button type="button" id="delay-ask-dismiss" class="py-2.5 rounded-xl text-gray-500 dark:text-gray-400 text-[11px] font-bold focus:outline-none">Not me</button>
        </div>
    </div>
</div>

<!-- ABOUT -->
<div id="about-modal" class="fixed inset-0 bg-white dark:bg-gray-900 z-[120] hidden flex flex-col items-center p-0 full-screen transition-opacity duration-300 overflow-y-auto">
    <div class="w-full max-w-2xl px-4 pt-3 pb-2 flex justify-end sticky top-0 bg-white dark:bg-gray-900 z-20">
        <button type="button" id="close-about-btn" class="p-2 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition shadow-sm focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>
    <div class="w-full max-w-md px-6 pb-12 flex flex-col items-center text-center">
        <img src={withBase('icons/loading-logo.png')} class="w-20 h-20 mb-4 rounded-full" alt="Next Train Logo" onerror="this.style.display='none'">
        <h2 id="about-app-title" class="text-3xl font-black text-gray-900 dark:text-white mb-2 select-none cursor-pointer">Next Train</h2>
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-100 text-xs font-bold uppercase tracking-wider mb-6 border border-gray-300 dark:border-gray-600">Unofficial & Independent</div>
        <div class="text-center space-y-4 text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-8">
            <div class="flex flex-col items-center mb-3">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 mb-2 border border-gray-200 dark:border-gray-700" aria-hidden="true">
                    <svg class="w-7 h-7" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <!-- Head -->
                        <circle cx="24" cy="18" r="7" stroke="currentColor" stroke-width="2.5"/>
                        <!-- Compact baseball cap (sits on top of head) -->
                        <path d="M18.5 13.5c1.2-3.2 3.6-4.8 5.5-4.8s4.3 1.6 5.5 4.8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                        <path d="M17.5 13.8h13" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                        <path d="M27 13.8h5.5c1.4 0 2.4.6 2.4 1.4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                        <!-- Shoulders -->
                        <path d="M10 40c2.5-7 8-11 14-11s11.5 4 14 11" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    </svg>
                </span>
            </div>
            <p>The idea for <strong>Next Train</strong> first sparked in 2023 while I was a student at the University of Pretoria, travelling via Rissik Station and looking for low-cost, affordable transport. Building began in mid-November 2025 with a simple mission: to replace blurry notice photos and crowded station boards with clear, digital accuracy.</p>
            <p>What began as a tool for family has grown to help thousands of commuters. While this remains an <strong>independent passion project</strong> (not an official PRASA tool), it is built with the reliability our community deserves.</p>
        </div>
        <div class="w-full bg-gray-50 dark:bg-gray-800 rounded-xl p-4 mb-6 shadow-inner border border-gray-100 dark:border-gray-700">
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-3">Built & Maintained By</p>
            <div class="space-y-2.5 mb-4">
                <div class="text-center">
