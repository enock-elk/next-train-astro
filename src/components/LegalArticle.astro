---
/**
 * Public legal pages. Same header chrome as the rest of Next Train.
 * Back to Account uses /#account so the hash is a real in-app return.
 * The footer omits the page you are already on.
 */
import { withBase } from '../lib/config.js';

interface Props {
  title: string;
  current?: 'privacy' | 'terms' | 'delete';
}

const { title, current = '' } = Astro.props;
const fromAccount = Astro.url.searchParams.get('from') === 'account';
const fromQ = fromAccount ? '?from=account' : '';
const homeHref = withBase('');
const accountHref = `${homeHref}#account`;
const backHref = fromAccount ? accountHref : homeHref;
const backLabel = fromAccount ? 'Back to Account' : 'Open in Next Train';
const links = [
  { id: 'privacy', href: `${withBase('privacy.html')}${fromQ}`, label: 'Privacy Policy' },
  { id: 'terms', href: `${withBase('terms.html')}${fromQ}`, label: 'Terms of Use' },
  { id: 'delete', href: `${withBase('account-delete.html')}${fromQ}`, label: 'Delete Account' },
].filter((link) => link.id !== current);
---

<div class="nt-legal-shell min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white">
  <header id="app-header" class="app-header shrink-0 px-3 py-2.5 z-30 relative flex items-start justify-between gap-2 border-b">
    <div class="min-w-0 header-brand-block">
      <a href={homeHref} class="block rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70" aria-label="Next Train home">
        <p id="app-title" class="header-title text-[2.55rem] sm:text-[2.75rem] font-black select-none tracking-[-0.035em] leading-none">Next Train</p>
      </a>
      <p id="current-day" class="header-meta mt-1.5 text-[11px] sm:text-xs font-medium leading-tight">{title}</p>
    </div>
  </header>

  <main class="px-4 pt-4 pb-28 space-y-4 max-w-md mx-auto">
    <section class="nt-legal-doc rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-sm px-4 py-4 text-[15px] leading-relaxed text-gray-800 dark:text-gray-200">
      <h1 class="text-xl font-black tracking-tight text-gray-900 dark:text-white mb-3">{title}</h1>
      <slot />
    </section>
    {links.length > 0 && (
      <nav class="rounded-xl overflow-hidden bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-sm divide-y divide-gray-200 dark:divide-gray-700 text-[15px]">
        {links.map((link) => (
          <a href={link.href} class="flex justify-between items-center px-4 py-3 text-gray-900 dark:text-white">
            <span>{link.label}</span>
            <span class="text-gray-300 dark:text-gray-600" aria-hidden="true">&gt;</span>
          </a>
        ))}
      </nav>
    )}
  </main>
  <a class="seo-open-bar" href={backHref}>{backLabel}</a>
</div>

<style is:global>
  .nt-legal-doc h4,
  .nt-legal-doc h2 {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 1.1rem 0 0.4rem;
    color: inherit;
  }
  .nt-legal-doc h4:first-child,
  .nt-legal-doc h2:first-child {
    margin-top: 0;
  }
  .nt-legal-doc p,
  .nt-legal-doc li {
    font-size: 15px;
    line-height: 1.45;
    font-weight: 400;
  }
  .nt-legal-doc ol {
    list-style: decimal;
    padding-left: 1.25rem;
    margin: 0 0 0.75rem;
  }
  .nt-legal-doc a {
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  html.dark .nt-legal-doc a {
    color: #60a5fa;
  }
  .seo-open-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.85rem 1rem calc(0.85rem + env(safe-area-inset-bottom));
    background: var(--nt-chrome-nav, #163d96);
    color: var(--nt-chrome-fg, #fff);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
</style>
