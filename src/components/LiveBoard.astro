---
// Next Train view shell — SPA-parity layout matching spa-reference / nexttrain.co.za
---

<div id="view-next-train" class="view-section active p-4 flex-grow bg-gray-50 dark:bg-gray-900/50">

    <!-- ROUTE PIN & TITLE -->
    <div class="text-center mb-5 flex flex-col justify-center items-center w-full">
        <div class="w-full grid grid-cols-[3rem_1fr_3rem] items-stretch bg-white dark:bg-gray-800 h-[46px] rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 mb-1 overflow-hidden transition-colors">

            <button id="pin-route-btn" class="relative flex items-center justify-center w-full h-full text-gray-400 dark:text-gray-500 hover:text-blue-500 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors focus:outline-none group cursor-pointer" title="Pin this route" aria-label="Pin Route">
                <svg id="pin-outline" class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                <svg id="pin-filled" class="w-5 h-5 hidden text-blue-500 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24"><path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                <div class="absolute right-0 top-1/4 bottom-1/4 w-px bg-gray-200 dark:bg-gray-700"></div>
            </button>

            <button type="button" id="route-selector-btn" class="flex flex-col items-center justify-center w-full h-full px-2 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors focus:outline-none group">
                <h2 id="route-subtitle-text" class="text-base sm:text-lg font-medium text-gray-700 dark:text-gray-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate w-full text-center">
                    Loading Route...
                </h2>
            </button>

            <button type="button" id="route-selector-chevron" class="flex items-center justify-center w-full h-full text-blue-500 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors focus:outline-none group cursor-pointer" title="Change route" aria-label="Change route">
                <svg class="w-5 h-5 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
        </div>
        <p id="last-updated-date" class="text-[10px] text-gray-400 dark:text-gray-500 font-medium uppercase tracking-wide mt-1">Schedule Effective from: --</p>
    </div>

    <!-- Commuter delay reports (kept; hidden until hydrated) -->
    <div id="delay-report-banner" class="hidden shrink-0 mb-4 px-3 py-2.5 rounded-xl border border-amber-200 dark:border-amber-800/60 bg-amber-50/90 dark:bg-amber-950/40 text-left relative">
        <span id="delay-report-badge" class="hidden absolute -top-2 -right-1 z-10 bg-amber-500 text-white text-[9px] font-black px-1.5 py-0.5 rounded-full shadow-sm min-w-[1.25rem] text-center">0</span>
        <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
                <p class="text-[10px] font-black uppercase tracking-widest text-amber-700 dark:text-amber-400 mb-0.5">Commuter reports</p>
                <p id="delay-report-banner-text" class="text-xs font-bold text-gray-800 dark:text-gray-200 leading-snug"></p>
            </div>
            <button type="button" id="delay-report-banner-cta" class="shrink-0 text-[10px] font-bold text-amber-800 dark:text-amber-300 underline underline-offset-2 focus:outline-none">Report</button>
        </div>
    </div>

    <!-- STATION SELECTOR & GPS -->
    <div class="mb-5 relative z-20" id="station-field-hit">
        <label for="station-select" class="sr-only">From Station</label>
        <div class="flex items-center gap-2">
            <div class="relative flex-grow shadow-sm rounded-xl cursor-pointer" id="station-field-wrap" role="button" tabindex="0" aria-label="Select station">
                <select id="station-select" class="hidden w-full p-4 rounded-xl bg-white dark:bg-gray-800 border-2 border-gray-200 dark:border-gray-700 text-lg font-medium text-gray-900 dark:text-white shadow-sm focus:border-blue-50 focus:ring-blue-500 transition-colors">
                    <option value="">Loading stations...</option>
                </select>
                <input type="text" readonly id="station-search-input" placeholder="Select Station..." class="block w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl shadow-sm p-3 text-lg font-medium focus:ring-blue-500 focus:border-blue-500 transition-colors h-[54px] appearance-none pr-12 cursor-pointer select-none truncate">
                <div id="next-train-chevron" class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-400 cursor-pointer p-2 hover:text-blue-500 z-10 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
            </div>
            <button id="locate-btn" class="bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-xl shadow-md transition-colors flex-shrink-0 h-[54px] w-[54px] flex items-center justify-center focus:outline-none" title="Find my nearest station" aria-label="Find Nearest Station">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="18" y2="12"/><line x1="6" y1="12" x2="2" y2="12"/><line x1="12" y1="6" x2="12" y2="2"/><line x1="12" y1="22" x2="12" y2="18"/></svg>
            </button>
        </div>
    </div>

    <!-- LIVE BOARDS -->
    <div class="space-y-4 mb-6">
        <div class="bg-white dark:bg-gray-800 rounded-xl p-3 shadow-sm border border-gray-200 dark:border-gray-700">
            <h2 id="pretoria-header" class="text-base font-semibold text-gray-900 dark:text-white mb-2 text-center">Next train to <span class="text-blue-500 dark:text-blue-400">Dest A</span></h2>
            <div id="pretoria-time" class="text-center flex items-center justify-center">
                <div class="animate-pulse flex space-x-4 w-full justify-center opacity-50"><div class="rounded-full bg-slate-200 dark:bg-slate-700 h-10 w-10"></div><div class="flex-1 space-y-3 py-1 max-w-[200px]"><div class="h-2 bg-slate-200 dark:bg-slate-700 rounded"></div><div class="h-2 bg-slate-200 dark:bg-slate-700 rounded"></div></div></div>
            </div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl p-3 shadow-sm border border-gray-200 dark:border-gray-700">
            <h2 id="pienaarspoort-header" class="text-base font-semibold text-gray-900 dark:text-white mb-2 text-center">Next train to <span class="text-blue-500 dark:text-blue-400">Dest B</span></h2>
            <div id="pienaarspoort-time" class="text-center flex items-center justify-center">
                <div class="animate-pulse flex space-x-4 w-full justify-center opacity-50"><div class="rounded-full bg-slate-200 dark:bg-slate-700 h-10 w-10"></div><div class="flex-1 space-y-3 py-1 max-w-[200px]"><div class="h-2 bg-slate-200 dark:bg-slate-700 rounded"></div><div class="h-2 bg-slate-200 dark:bg-slate-700 rounded"></div></div></div>
            </div>
        </div>
    </div>

    <!-- Full timetable (shown when route is active — same IDs the SPA JS toggles) -->
    <div id="grid-trigger-container" class="hidden mb-4 mt-2 px-1">
        <button type="button" id="view-full-timetable-btn" class="w-full flex items-center justify-center space-x-3 bg-blue-600 hover:bg-blue-700 text-white font-black py-3.5 rounded-xl shadow-lg ring-4 ring-blue-100 dark:ring-blue-900 transition-all transform active:scale-95 group focus:outline-none">
            <span class="text-xl" aria-hidden="true">📅</span>
            <span class="tracking-wide">VIEW FULL TIMETABLE</span>
        </button>
    </div>

    <!-- Fare box (compact; SPA chrome with tighter height) -->
    <div id="fare-container" class="mb-4 py-2 px-3 bg-blue-50 dark:bg-gray-800 rounded-xl flex items-center justify-between gap-2 shadow-sm border border-blue-100 dark:border-gray-700 hidden min-h-[44px] pr-9 relative group">
        <div class="flex flex-col items-start justify-center min-w-0 flex-1 overflow-hidden">
            <div class="flex items-center space-x-1 flex-wrap leading-none">
                <span class="text-[10px] text-gray-500 dark:text-gray-400 uppercase font-bold tracking-wider">Estimated</span>
                <span id="passenger-type-label" class="text-[10px] text-blue-500 dark:text-blue-400 uppercase font-black tracking-widest">Adult</span>
                <span class="text-[10px] text-gray-500 dark:text-gray-400 uppercase font-bold tracking-wider">Fare</span>
            </div>
            <span id="fare-type" class="hidden text-[10px] font-bold text-gray-500 dark:text-gray-400 bg-gray-200 dark:bg-gray-700 px-1.5 py-0.5 rounded-full mt-0.5 max-w-full truncate"></span>
        </div>
        <div class="text-right flex items-center justify-center shrink-0">
            <span id="fare-amount" class="text-xl font-black text-gray-900 dark:text-white leading-none">R--.--</span>
        </div>
        <div id="fare-chevron" class="absolute right-2.5 top-1/2 transform -translate-y-1/2 opacity-50 group-hover:opacity-100 transition-opacity flex items-center justify-center shrink-0 pointer-events-none" aria-hidden="true">
            <svg class="w-4 h-4 text-blue-500 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </div>
    </div>

    <!-- Footer actions (SPA) -->
    <div class="mt-4 border-t border-gray-200 dark:border-gray-700 pt-4">
        <div class="grid grid-cols-2 gap-2 mb-3">
            <button type="button" id="share-app-btn" class="flex items-center justify-center w-full bg-transparent border-2 border-gray-200 dark:border-gray-700 text-gray-800 dark:text-gray-200 font-medium py-2 px-3 rounded-lg shadow-sm hover:border-blue-50 hover:text-blue-600 dark:hover:text-blue-400 transition-all text-sm focus:outline-none">
                <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 105.953-1.68l-4.94-2.47a3.027 3.027 0 000-.979l4.94-2.47A3 3 0 0015 8z"></path></svg> Share App
            </button>
            <a href="#" id="feedback-btn" class="flex items-center justify-center w-full bg-transparent border-2 border-gray-200 dark:border-gray-700 text-gray-800 dark:text-gray-200 font-medium py-2 px-3 rounded-lg shadow-sm hover:border-blue-50 hover:text-blue-600 dark:hover:text-blue-400 transition-all text-sm focus:outline-none">
                <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg> Feedback
            </a>
        </div>
        <div class="mt-3 mb-3">
            <button type="button" id="install-app-btn" class="hidden flex items-center justify-center w-full bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded-lg shadow-md transition-colors text-sm">
                <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg> Install App In Background (&lt; 1 MB)
            </button>
        </div>
        <div id="copied-message" class="hidden text-center text-green-500 font-medium mt-2 text-xs">Link copied to clipboard!</div>

        <div class="flex justify-center items-center space-x-4 mt-4">
            <button type="button" class="hub-legal-link text-[10px] text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 font-medium transition-colors cursor-pointer underline underline-offset-2 decoration-gray-300 dark:decoration-gray-600 focus:outline-none" data-legal="terms">Terms of Use</button>
            <span class="text-gray-300 dark:text-gray-600 text-[10px]">|</span>
            <button type="button" class="hub-legal-link text-[10px] text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 font-medium transition-colors cursor-pointer underline underline-offset-2 decoration-gray-300 dark:decoration-gray-600 focus:outline-none" data-legal="privacy">Privacy Policy</button>
        </div>
        <p class="text-[10px] text-gray-400 dark:text-gray-500 text-center mt-1">2026 &copy; Kazembe CodeWorks.</p>
    </div>
</div>
