---
// src/components/LiveBoard.astro
// Next Train view shell — behavior lives in live-board-ui.js (Phase 2)
---

<div id="view-next-train" class="view-section active p-4 bg-gray-50 dark:bg-gray-900/50 overflow-y-auto custom-scrollbar">

    <!-- ROUTE PIN & TITLE -->
    <div class="text-center mb-5 flex flex-col justify-center items-center w-full shrink-0">
        <div class="w-full grid grid-cols-[3rem_1fr_3rem] items-stretch bg-white dark:bg-gray-800 h-[46px] rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 mb-1 overflow-hidden transition-colors">

            <button id="pin-route-btn" class="relative flex items-center justify-center w-full h-full text-gray-400 dark:text-gray-500 hover:text-blue-500 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors focus:outline-none group cursor-pointer" title="Pin this route">
                <svg id="pin-outline" class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                <svg id="pin-filled" class="w-5 h-5 hidden text-blue-500 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24"><path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                <div class="absolute right-0 top-1/4 bottom-1/4 w-px bg-gray-200 dark:bg-gray-700"></div>
            </button>

            <button id="route-selector-btn" class="flex flex-col items-center justify-center w-full h-full px-2 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors focus:outline-none group">
                <h2 id="route-subtitle-text" class="text-base sm:text-lg font-medium text-gray-700 dark:text-gray-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate w-full text-center">
                    Loading Route...
                </h2>
            </button>

            <button id="route-selector-chevron" class="flex items-center justify-center w-full h-full text-blue-500 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors focus:outline-none group cursor-pointer" type="button" title="Change route">
                <svg class="w-5 h-5 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
        </div>
    </div>

    <!-- Commuter delay reports (crowd surface) -->
    <div id="delay-report-banner" class="hidden shrink-0 mb-4 px-3 py-2.5 rounded-xl border border-amber-200 dark:border-amber-800/60 bg-amber-50/90 dark:bg-amber-950/40 text-left relative">
        <span id="delay-report-badge" class="hidden absolute -top-2 -right-1 z-10 bg-amber-500 text-white text-[9px] font-black px-1.5 py-0.5 rounded-full shadow-sm min-w-[1.25rem] text-center">0</span>
        <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
                <p class="text-[10px] font-black uppercase tracking-widest text-amber-700 dark:text-amber-400 mb-0.5">Commuter reports</p>
                <p id="delay-report-banner-text" class="text-xs font-bold text-gray-800 dark:text-gray-200 leading-snug"></p>
            </div>
            <button type="button" id="delay-report-banner-cta" class="shrink-0 text-[10px] font-bold text-amber-800 dark:text-amber-300 underline underline-offset-2 focus:outline-none">Report</button>
        </div>
    </div>

    <!-- STATION SELECTOR & GPS -->
    <div class="mb-5 relative z-20 shrink-0">
        <label for="station-select" class="sr-only">From Station</label>
        <div class="flex items-center gap-2">
            <div class="relative flex-grow shadow-sm rounded-xl cursor-pointer">
                <select id="station-select" class="hidden w-full p-4 rounded-xl bg-white dark:bg-gray-800 border-2 border-gray-200 dark:border-gray-700 text-lg font-medium text-gray-900 dark:text-white shadow-sm focus:border-blue-50 focus:ring-blue-500 transition-colors">
                    <option value="">Loading stations...</option>
                </select>
                <input type="text" readonly id="station-search-input" placeholder="Select Station..." class="block w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl shadow-sm p-3 text-base sm:text-lg font-medium focus:ring-blue-500 focus:border-blue-500 transition-colors h-[54px] appearance-none pr-12 cursor-pointer select-none truncate">
                <div id="next-train-chevron" class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-400 cursor-pointer p-2 hover:text-blue-500 z-10 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
            </div>
            <button id="locate-btn" class="bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-xl shadow-md transition-colors flex-shrink-0 h-[54px] w-[54px] flex items-center justify-center focus:outline-none" title="Find my nearest station">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="18" y2="12"/><line x1="6" y1="12" x2="2" y2="12"/><line x1="12" y1="6" x2="12" y2="2"/><line x1="12" y1="22" x2="12" y2="18"/></svg>
            </button>
        </div>
    </div>

    <!-- LIVE BOARDS -->
    <div class="space-y-4 mb-4 shrink-0">
        <div class="bg-white dark:bg-gray-800 rounded-xl p-3 shadow-sm border border-gray-200 dark:border-gray-700 min-h-[120px]">
            <h2 id="pretoria-header" class="text-base font-semibold text-gray-900 dark:text-white mb-2 text-center">Next train to <span class="text-blue-500 dark:text-blue-400">Dest A</span></h2>
            <div id="pretoria-time" class="text-center flex items-center justify-center">
                <div class="animate-pulse flex space-x-4 w-full justify-center opacity-50"><div class="rounded-full bg-slate-200 dark:bg-slate-700 h-10 w-10"></div><div class="flex-1 space-y-3 py-1 max-w-[200px]"><div class="h-2 bg-slate-200 dark:bg-slate-700 rounded"></div><div class="h-2 bg-slate-200 dark:bg-slate-700 rounded"></div></div></div>
            </div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-xl p-3 shadow-sm border border-gray-200 dark:border-gray-700 min-h-[120px]">
            <h2 id="pienaarspoort-header" class="text-base font-semibold text-gray-900 dark:text-white mb-2 text-center">Next train to <span class="text-blue-500 dark:text-blue-400">Dest B</span></h2>
            <div id="pienaarspoort-time" class="text-center flex items-center justify-center">
                <div class="animate-pulse flex space-x-4 w-full justify-center opacity-50"><div class="rounded-full bg-slate-200 dark:bg-slate-700 h-10 w-10"></div><div class="flex-1 space-y-3 py-1 max-w-[200px]"><div class="h-2 bg-slate-200 dark:bg-slate-700 rounded"></div><div class="h-2 bg-slate-200 dark:bg-slate-700 rounded"></div></div></div>
            </div>
        </div>
    </div>

    <!-- Full timetable CTA (always under boards) -->
    <div class="mb-5 shrink-0">
        <button type="button" id="view-full-timetable-btn" class="w-full flex flex-col items-center justify-center gap-0.5 px-3.5 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-500 text-center shadow-md transition-colors focus:outline-none group border border-blue-700/40 dark:border-blue-400/30">
            <span class="block text-sm font-black uppercase tracking-wide text-white leading-tight">View full timetable</span>
            <span id="last-updated-date" class="block text-[11px] font-bold text-blue-100 tracking-wide truncate max-w-full">Effective from: —</span>
        </button>
        <div id="grid-trigger-container" class="hidden" aria-hidden="true"></div>
    </div>

    <!-- Trip tools: fare -->
    <div id="trip-tools" class="mb-2 space-y-2 shrink-0">
        <button type="button" id="fare-container" class="w-full text-left px-3.5 py-3 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-sm flex items-center gap-3 focus:outline-none transition-colors hover:border-blue-300 dark:hover:border-blue-700 group min-h-[52px] cursor-pointer">
            <div class="min-w-0 flex-1">
                <p class="text-[10px] font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500">
                    <span id="passenger-type-label" class="text-blue-600 dark:text-blue-400">Adult</span> fare
                </p>
                <p id="fare-type" class="hidden text-[11px] font-medium text-gray-500 dark:text-gray-400 truncate mt-0.5"></p>
            </div>
            <div class="text-right shrink-0">
                <span id="fare-amount" class="text-xl font-black text-gray-900 dark:text-white tabular-nums">R--.--</span>
            </div>
            <svg id="fare-chevron" class="w-4 h-4 text-gray-300 dark:text-gray-600 group-hover:text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
    </div>

    <!-- Absorbs leftover height only; collapses first so real UI never shrinks away -->
    <div id="next-train-spacer" class="flex-1 basis-0 min-h-0" aria-hidden="true"></div>

    <!-- FOOTER ACTIONS -->
    <div class="pt-2 pb-1 space-y-2 shrink-0">
        <button id="install-app-btn" class="hidden flex items-center justify-center w-full bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded-lg shadow-md transition-colors text-sm mb-2">
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg> Install App
        </button>
    </div>
</div>
