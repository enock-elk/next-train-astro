---
// Live-board modals: route selector + upcoming schedule list (strict SPA clone)
---

<!-- ROUTE SELECTOR MODAL -->
<div id="route-modal" class="fixed inset-0 bg-black bg-opacity-80 z-[120] hidden flex items-start justify-center p-2 pt-2 sm:pt-8 backdrop-blur-sm transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-2xl w-full max-w-sm flex flex-col transform transition-all scale-100 max-h-[96dvh]">
        <div class="py-3 px-4 border-b border-gray-200 dark:border-gray-800 flex justify-between items-center bg-white dark:bg-gray-900 rounded-t-xl shadow-sm shrink-0 relative z-20">
            <h3 class="text-lg font-black text-gray-900 dark:text-white tracking-tight">Select Route</h3>
            <button type="button" onclick="if(typeof window.closeSmoothModal==='function') window.closeSmoothModal('route-modal')" class="p-1.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition focus:outline-none" aria-label="Close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        
        <div class="p-3 bg-gray-50 dark:bg-gray-800/80 border-b border-gray-200 dark:border-gray-700 shrink-0 z-10 relative" id="route-modal-region-container">
            <div class="relative shadow-sm rounded-lg cursor-pointer group" onclick="if(window.toggleDropdownScrim) window.toggleDropdownScrim('route-modal-region-list', 'route-modal-region-chevron');">
                <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none z-10 text-green-500">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M2 12h20"/><path d="M12 2a15 15 0 014 10 15 15 0 01-4 10 15 15 0 01-4-10 15 15 0 014-10z"/></svg>
                </div>
                <select id="route-modal-region-select" class="hidden">
                    <option value="GP">Gauteng</option>
                    <option value="WC">Western Cape</option>
                    <option value="KZN">KwaZulu-Natal</option>
                    <option value="EC">Eastern Cape</option>
                </select>
                <div class="block w-full bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 py-2.5 pl-10 pr-10 rounded-lg text-sm font-bold text-gray-900 dark:text-white transition-colors shadow-sm group-hover:border-blue-400 dark:group-hover:border-blue-500 flex items-center justify-between">
                    <span id="route-modal-region-display" class="truncate">Gauteng</span>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-500 dark:text-gray-400">
                        <svg id="route-modal-region-chevron" class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                </div>
                <ul id="route-modal-region-list" class="absolute z-[200] w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-2xl hidden mt-1 flex-col overflow-hidden text-left">
                    <li data-region-target="GP" data-region-name="Gauteng" class="px-4 py-3 text-sm font-bold hover:bg-blue-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-colors border-b border-gray-100 dark:border-gray-700 cursor-pointer">Gauteng</li>
                    <li data-region-target="WC" data-region-name="Western Cape" class="px-4 py-3 text-sm font-bold hover:bg-blue-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-colors border-b border-gray-100 dark:border-gray-700 cursor-pointer">Western Cape</li>
                    <li data-region-target="KZN" data-region-name="KwaZulu-Natal" class="px-4 py-3 text-sm font-bold hover:bg-blue-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-colors border-b border-gray-100 dark:border-gray-700 cursor-pointer">KwaZulu-Natal</li>
                    <li data-region-target="EC" data-region-name="Eastern Cape" class="px-4 py-3 text-sm font-bold hover:bg-blue-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-colors cursor-pointer">Eastern Cape</li>
                </ul>
            </div>
        </div>

        <div class="p-4 pb-24 overflow-y-auto flex-grow bg-gray-50 dark:bg-gray-900/50 w-full custom-scrollbar rounded-b-xl">
            <ul id="route-list" class="space-y-2"></ul>
        </div>
    </div>
</div>

<!-- UPCOMING TRAINS / SCHEDULE MODAL -->
<div id="schedule-modal" class="fixed inset-0 bg-black bg-opacity-70 z-[90] hidden flex items-center justify-center p-4 backdrop-blur-sm transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-2xl w-full max-w-md max-h-[95dvh] flex flex-col transform transition-transform duration-300 scale-95" id="modal-content">
        <div class="p-4 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center bg-gray-50 dark:bg-gray-900 rounded-t-xl">
            <h3 id="modal-title" class="text-lg font-bold text-gray-900 dark:text-white">Full Schedule</h3>
            <button id="close-modal-btn" type="button" class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 transition" aria-label="Close Schedule">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div id="modal-list" class="p-2 overflow-y-auto flex-grow space-y-2 bg-gray-100 dark:bg-gray-800"></div>
        <div class="p-4 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 rounded-b-xl">
            <button id="close-modal-btn-2" type="button" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg shadow-md transition-colors">Close</button>
        </div>
    </div>
</div>

<!-- PROFILE SETUP MODAL -->
<div id="profile-modal" class="fixed inset-0 bg-black bg-opacity-90 z-[130] hidden flex items-center justify-center p-4 backdrop-blur-md transition-opacity duration-300">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-2xl w-full max-w-sm p-6 transform transition-all scale-100">
        <div class="text-center">
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-blue-100 dark:bg-blue-900 mb-4">
                <svg class="h-8 w-8 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Welcome Commuter!</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Select your profile to see correct fares.</p>
            <div class="space-y-3">
                <button type="button" onclick="window.selectProfile && window.selectProfile('Adult')" class="w-full bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-900 dark:text-white font-bold py-3 px-4 rounded-lg flex items-center justify-between group transition-colors">
                    <span>Adult</span><span class="text-xs font-normal text-gray-500 group-hover:text-gray-700 dark:text-gray-400">Standard Fare</span>
                </button>
                <button type="button" onclick="window.selectProfile && window.selectProfile('Scholar')" class="w-full bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-900 dark:text-white font-bold py-3 px-4 rounded-lg flex items-center justify-between group transition-colors">
                    <span>Scholar</span><span class="text-xs font-normal text-gray-500 group-hover:text-gray-700 dark:text-gray-400">Student Rate</span>
                </button>
                <button type="button" onclick="window.selectProfile && window.selectProfile('Pensioner')" class="w-full bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-900 dark:text-white font-bold py-3 px-4 rounded-lg flex items-center justify-between group transition-colors">
                    <span>Pensioner</span><span class="text-xs font-normal text-gray-500 group-hover:text-gray-700 dark:text-gray-400">Senior Rate</span>
                </button>
                <button type="button" onclick="window.selectProfile && window.selectProfile('Military')" class="w-full bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-900 dark:text-white font-bold py-3 px-4 rounded-lg flex items-center justify-between group transition-colors">
                    <span>Military / Vets</span><span class="text-xs font-normal text-gray-500 group-hover:text-gray-700 dark:text-gray-400">Special Rate</span>
                </button>
            </div>
        </div>
    </div>
</div>
