---
/**
 * Interactive network map as a primary tab (Leaflet via /map embed).
 * Behaviour: src/lib/map-tab.js
 */
import { withBase, APP_VERSION } from '../lib/config.js';
/**
 * Use map.html so the PWA navigateFallback (index.html) cannot paint the
 * full SPA inside this iframe. `/map` is a document navigation that missed
 * the old denylist and stacked a second header + bottom bar.
 */
const mapSrc = `${withBase('/map.html')}?embed=1&v=${APP_VERSION}`;
---

<div id="view-map" class="view-section bg-gray-50 dark:bg-gray-900/50 p-0">
    <div class="map-tab-pane flex flex-col flex-1 min-h-0 h-full">
        <div class="shrink-0 px-3 py-2.5 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 flex items-center justify-between gap-2">
            <div class="min-w-0">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Network map</p>
                <p id="map-tab-status" class="text-[11px] font-semibold text-gray-600 dark:text-gray-300 truncate">Network overview</p>
            </div>
            <div class="flex items-center gap-1.5 shrink-0 flex-wrap justify-end">
                <button
                    type="button"
                    id="map-tab-stop-btn"
                    class="hidden inline-flex items-center gap-1 px-2.5 py-2 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-[11px] font-bold text-red-700 dark:text-red-300 hover:bg-red-100 dark:hover:bg-red-900/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500"
                    hidden
                    aria-hidden="true"
                    title="Stop sharing your location as this train"
                >
                    Stop sharing
                </button>
                <button
                    type="button"
                    id="map-tab-nearby-btn"
                    class="inline-flex items-center gap-1 px-2.5 py-2 rounded-xl bg-gray-100 dark:bg-gray-900 border border-gray-200 dark:border-gray-600 text-[11px] font-bold text-gray-700 dark:text-gray-200 hover:border-blue-300 dark:hover:border-blue-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
                    title="See timetable trains near you"
                >
                    Trains near you
                </button>
            </div>
        </div>

        <div class="relative flex-1 min-h-0 bg-gray-100 dark:bg-gray-950">
            <iframe
                id="map-tab-frame"
                title="Metrorail network map"
                class="absolute inset-0 w-full h-full border-0"
                data-map-src={mapSrc}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allow="geolocation"
            ></iframe>
            <div id="map-tab-placeholder" class="hidden absolute inset-0 pointer-events-none" aria-hidden="true"></div>
            <div id="map-tab-fallback" class="hidden absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center bg-gray-100 dark:bg-gray-950">
                <p data-fallback-title class="text-sm font-black text-gray-900 dark:text-white">Map didn’t load</p>
                <p data-fallback-body class="text-[11px] text-gray-500 dark:text-gray-400 leading-snug">The map could not be opened. Reload it when you have a signal, or open the full map in a new tab.</p>
                <div class="flex items-center gap-2">
                    <button type="button" id="map-tab-retry" class="px-3 py-2 rounded-xl bg-blue-600 text-white text-[11px] font-bold focus:outline-none">Reload map</button>
                    <a id="map-tab-open-full" href={mapSrc.replace('&embed=1', '').replace('?embed=1&', '?').replace('?embed=1', '')} target="_blank" rel="noopener" class="px-3 py-2 rounded-xl border border-gray-300 dark:border-gray-600 text-[11px] font-bold text-gray-700 dark:text-gray-200">Open full map</a>
                </div>
            </div>
            <section id="map-tracking-card" class="hidden absolute z-10 inset-x-3 bottom-3 max-w-md mx-auto rounded-2xl border border-blue-200 dark:border-blue-800 bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl shadow-2xl overflow-hidden" aria-live="polite" aria-label="Your train tracking status">
                <div class="flex items-start justify-between gap-3 px-4 pt-3 pb-2">
                    <div class="min-w-0">
                        <div class="flex items-center gap-2">
                            <span id="map-tracking-state" class="px-2 py-0.5 rounded-full bg-green-100 dark:bg-green-950 text-green-700 dark:text-green-300 text-[9px] font-black uppercase tracking-wider">Active</span>
                            <h3 id="map-tracking-title" class="text-sm font-black text-gray-900 dark:text-white truncate">Tracking train</h3>
                        </div>
                        <p id="map-tracking-last-seen" class="mt-1 text-[11px] font-semibold text-gray-500 dark:text-gray-400 truncate">Waiting for a GPS fix</p>
                    </div>
                    <div class="flex items-center gap-1 shrink-0">
                        <button type="button" id="map-tracking-minimize" class="p-1.5 rounded-lg text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" aria-label="Minimize tracking status">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14"/></svg>
                        </button>
                        <button type="button" id="map-tracking-dismiss" class="p-1.5 rounded-lg text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" aria-label="Dismiss tracking status">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                        </button>
                    </div>
                </div>
                <div id="map-tracking-card-body" class="px-4 pb-3">
                    <dl class="grid grid-cols-3 gap-2 py-2 border-y border-gray-100 dark:border-gray-800">
                        <div><dt class="text-[9px] font-bold uppercase text-gray-400">Speed</dt><dd id="map-tracking-speed" class="text-xs font-black text-gray-800 dark:text-gray-100">-</dd></div>
                        <div><dt class="text-[9px] font-bold uppercase text-gray-400">Heading</dt><dd id="map-tracking-heading" class="text-xs font-black text-gray-800 dark:text-gray-100">-</dd></div>
                        <div><dt class="text-[9px] font-bold uppercase text-gray-400">GPS</dt><dd id="map-tracking-gps" class="text-xs font-black text-gray-800 dark:text-gray-100">-</dd></div>
                        <div><dt class="text-[9px] font-bold uppercase text-gray-400">On rail</dt><dd id="map-tracking-rail" class="text-xs font-black text-gray-800 dark:text-gray-100">-</dd></div>
                        <div><dt class="text-[9px] font-bold uppercase text-gray-400">Accuracy</dt><dd id="map-tracking-accuracy" class="text-xs font-black text-gray-800 dark:text-gray-100">-</dd></div>
                        <div><dt class="text-[9px] font-bold uppercase text-gray-400">Riders</dt><dd id="map-tracking-count" class="text-xs font-black text-gray-800 dark:text-gray-100">-</dd></div>
                    </dl>
                    <button type="button" id="map-tracking-stop" class="mt-2.5 w-full py-2 rounded-xl bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-300 text-[11px] font-black border border-red-200 dark:border-red-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500">Stop sharing</button>
                </div>
            </section>
            <button type="button" id="map-tracking-restore" class="hidden absolute z-10 left-3 bottom-3 max-w-[calc(100%_-_1.5rem)] px-3 py-2 rounded-full bg-gray-900/95 dark:bg-white/95 text-white dark:text-gray-900 shadow-xl text-[11px] font-black focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" aria-label="Show tracking status">
                <span id="map-tracking-restore-label">Tracking active</span>
            </button>
        </div>
    </div>
</div>
