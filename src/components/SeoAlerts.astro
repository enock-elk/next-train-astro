---
/**
 * In-app Alerts sheet on route, region, and corridor landings.
 * Scope is this page: one route, or every route on a region or corridor.
 * The bell stays hidden until a live notice exists.
 */
import AlertsChannel from './AlertsChannel.astro';
import ZoomControls from './ZoomControls.astro';

interface Props {
  region: string;
  routeIds?: string[];
}

const region = Astro.props.region || '';
const routeIds = (Astro.props.routeIds || []).filter(Boolean);
const routeIdAttr = routeIds.join(',');
---

<div id="nt-seo-alerts" data-region={region} data-route-ids={routeIdAttr} hidden></div>
<div id="toast" class=""></div>
<AlertsChannel />
<div id="alert-image-lightbox" class="fixed inset-0 bg-black z-[160] hidden flex-col [touch-action:none]" role="dialog" aria-modal="true" aria-label="Image Preview">
  <div id="alert-image-lightbox-stage" class="relative flex-1 min-h-0 overflow-hidden flex items-center justify-center [touch-action:none]">
    <img id="alert-image-lightbox-img" alt="Image Preview" draggable="false" decoding="sync" class="max-w-full max-h-full object-contain select-none pointer-events-none">
    <ZoomControls />
  </div>
  <button type="button" id="alert-image-lightbox-close" class="absolute top-[max(0.75rem,env(safe-area-inset-top))] right-3 z-20 w-11 h-11 rounded-full bg-black/55 text-white flex items-center justify-center border border-white/20 focus:outline-none [touch-action:manipulation]" aria-label="Close">
    <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
  </button>
  <div id="alert-image-lightbox-dock" class="hidden absolute inset-x-0 bottom-0 z-10 shrink-0 px-3 pt-8 pb-[max(1rem,env(safe-area-inset-bottom))] bg-gradient-to-t from-black via-black/70 to-transparent pointer-events-none [touch-action:manipulation]">
    <form id="alert-image-lightbox-form" class="pointer-events-auto flex flex-col gap-2 [touch-action:manipulation]">
      <div id="alert-image-lightbox-quote" class="hidden items-stretch overflow-hidden rounded-xl bg-white text-gray-900">
        <span class="w-1 shrink-0 bg-[#25D366]" aria-hidden="true"></span>
        <div class="min-w-0 flex-1 py-2 pl-2 pr-1">
          <div id="alert-image-lightbox-quote-title" class="truncate text-[13px] font-semibold text-[#128C7E]"></div>
          <div class="text-[12px] text-gray-500">Photo</div>
        </div>
        <img id="alert-image-lightbox-quote-img" alt="" class="m-1 h-12 w-12 shrink-0 rounded object-cover">
      </div>
      <div class="flex items-center gap-2">
        <input id="alert-image-lightbox-reply" type="text" enterkeyhint="send" autocomplete="off" maxlength="2000" placeholder="Reply" class="min-w-0 flex-1 rounded-full border border-white/15 bg-white/10 px-4 py-2.5 text-[16px] text-white placeholder:text-white/70 focus:outline-none [touch-action:manipulation]">
        <div id="alert-image-lightbox-react" class="flex shrink-0 items-center gap-1.5" role="group" aria-label="Reactions"></div>
        <button type="submit" id="alert-image-lightbox-send" class="hidden h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#25D366] text-white focus:outline-none [touch-action:manipulation]" aria-label="Send">
          <svg class="pointer-events-none h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.4 20.6 21 12 3.4 3.4l2.2 7.2L16 12l-10.4 1.4-2.2 7.2z"></path></svg>
        </button>
      </div>
    </form>
  </div>
</div>

<style is:global>
  body.modal-active { overflow: hidden !important; overscroll-behavior: none; }
  @keyframes nt-seo-shake {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-10deg); }
    75% { transform: rotate(10deg); }
  }
  #notice-bell.animate-shake { animation: nt-seo-shake 0.5s ease-in-out infinite; }
</style>

<script>
  const host = document.getElementById('nt-seo-alerts');
  const region = host?.getAttribute('data-region') || '';
  const routeIds = (host?.getAttribute('data-route-ids') || '').split(',').map((id) => id.trim()).filter(Boolean);
  const w = window as any;

  async function bootSeoAlerts() {
    if (!region || w.__ntSeoAlertsBooted) return;
    w.__ntSeoAlertsBooted = true;
    const alerts = await import('../lib/alerts-channel.js');
    const ui = await import('../lib/ui.js');
    alerts.useNoticeScope(region, routeIds);
    alerts.initAlertsChannel();

    if (!w.__ntSeoAlertsHistory) {
      w.__ntSeoAlertsHistory = true;
      window.addEventListener('popstate', () => {
        const hashNow = location.hash || '';
        if (w._isLightboxMode && hashNow !== '#lightbox') {
          ui.closeLightbox(true);
        }
        const alertsEl = document.getElementById('alerts-channel');
        const alertsOpen = (alertsEl && !alertsEl.classList.contains('hidden'))
          || w.__ntAlertsOpen
          || w.__ntAlertsParkHome;
        if (alertsOpen && hashNow !== '#alerts' && hashNow !== '#lightbox' && hashNow !== '#feedback') {
          ui.closeSmoothModal('alerts-channel', true);
          w.__ntAlertsOpen = false;
          w.__ntAlertsParkHome = false;
        }
      });
    }

    const notices = await alerts.fetchUnionNotices(region, routeIds[0] || '');
    alerts.setCachedLiveNotices(notices);
    alerts.applyBellFromNotices(notices);
    if (location.hash === '#alerts') alerts.openAlertsChannel({ notices, resetVisible: true });

    const bootAuth = () => {
      import('../lib/firebase-boot.js').then((m) => m.bootFirebase()).catch(() => {});
    };
    if (window.requestIdleCallback) window.requestIdleCallback(bootAuth, { timeout: 4000 });
    else setTimeout(bootAuth, 1500);
  }

  const start = () => { bootSeoAlerts().catch(() => {}); };
  if (location.hash === '#alerts') start();
  else if (window.requestIdleCallback) window.requestIdleCallback(start, { timeout: 2000 });
  else setTimeout(start, 800);
</script>
