---
import { withBase } from '../lib/config.js';
import { listFeaturedSeoRoutes, stationLabel } from '../lib/seo-routes.js';

const featured = listFeaturedSeoRoutes();
const compact = Astro.props.compact === true;
---

{featured.length > 0 && (
  compact ? (
    <nav class="mt-3 text-center text-[10px] leading-relaxed text-gray-500 dark:text-gray-400" aria-label="Route timetables">
      <a href={withBase('routes.html')} class="font-semibold text-blue-600 dark:text-blue-400 hover:underline">Route timetables</a>
      <span class="text-gray-300 dark:text-gray-600"> · </span>
      {featured.map(({ seed, route }, i) => (
        <>
          {i > 0 && <span class="text-gray-300 dark:text-gray-600"> · </span>}
          <a
            href={withBase(`routes/${seed.slug}.html`)}
            class="hover:underline hover:text-blue-600 dark:hover:text-blue-400"
          >
            {stationLabel(route.destB)}
          </a>
        </>
      ))}
    </nav>
  ) : (
    <section class="mt-8">
      <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">Route timetables</h2>
      <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
        Weekday first and last trains plus the full grid for high-traffic corridors.
      </p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        {featured.map(({ seed, route }) => (
          <li>
            <a
              href={withBase(`routes/${seed.slug}.html`)}
              class="block rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 px-4 py-3 hover:border-blue-500 dark:hover:border-blue-700 transition-colors"
            >
              <span class="block text-sm font-bold text-slate-900 dark:text-white">
                {stationLabel(route.destA)} to {stationLabel(route.destB)}
              </span>
              <span class="block text-xs text-slate-500 mt-0.5">
                {stationLabel(route.destB)} to {stationLabel(route.destA)}
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-sm">
        <a href={withBase('routes.html')} class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">
          All Metrorail route timetables
        </a>
      </p>
    </section>
  )
)}
