---
import { withBase } from '../lib/config.js';

const { region = 'GP', regionLabel = '' } = Astro.props;
const REGION_MAP_IMAGES = {
  GP: 'images/network-map.png',
  WC: 'images/network-map_wc.png',
  KZN: 'images/network-map_kzn.png',
  EC: 'images/network-map_ec.png',
};
const mapImageSrc = withBase(REGION_MAP_IMAGES[region] || REGION_MAP_IMAGES.GP);
const mapHref = withBase(`map.html?region=${encodeURIComponent(region)}`);
const label = regionLabel || region;
---

<section class="mt-8" id="seo-network-map">
  <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">
    {label} network map
  </h2>
  <figure class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60">
    <img
      src={mapImageSrc}
      alt={`${label} Metrorail network map`}
      class="w-full h-auto object-cover bg-slate-100 dark:bg-slate-900 aspect-[3/2]"
      loading="lazy"
      decoding="async"
      width="1200"
      height="800"
    />
    <figcaption class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">
      Static network map for {label}. Use the button below for the full map.
    </figcaption>
  </figure>
  <a
    href={mapHref}
    class="mt-3 flex w-full items-center justify-center rounded-xl border border-blue-600 text-blue-700 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-950/40 font-bold py-3.5 transition-colors"
  >
    Interactive map · {region}
  </a>
</section>
