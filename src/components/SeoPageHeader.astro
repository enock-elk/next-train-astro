---
/**
 * Crawlable landings use the in-app header chrome: Next Train left,
 * Open Next Train · region on the right (bell slot). No logo, no theme toggle.
 */
import { withBase } from '../lib/config.js';

interface Props {
  region?: string;
  regionLabel?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const region = ['GP', 'WC', 'KZN', 'EC'].includes(Astro.props.region || '')
  ? Astro.props.region
  : '';
const regionLabel = Astro.props.regionLabel || '';
const homeHref = region
  ? withBase(`/?region=${encodeURIComponent(region)}`)
  : withBase('/');
const ctaHref = Astro.props.ctaHref || homeHref;
const ctaLabel =
  Astro.props.ctaLabel ||
  (regionLabel ? `Open Next Train · ${regionLabel}` : 'Open Next Train');
---

<header id="app-header" class="app-header shrink-0 px-3 py-2.5 z-30 relative flex items-start justify-between gap-2 border-b">
  <div class="min-w-0 shrink header-brand-block">
    <a
      href={homeHref}
      class="block rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
      aria-label={regionLabel ? `Next Train home - ${regionLabel}` : 'Next Train home'}
    >
      <p id="app-title" class="header-title text-[2.55rem] sm:text-[2.75rem] font-black select-none tracking-[-0.035em] leading-none">
        Next Train
      </p>
    </a>
    <div class="header-meta mt-1.5 min-w-0">
      <p id="current-day" class="text-[11px] sm:text-xs font-medium leading-tight truncate">Getting schedules…</p>
    </div>
  </div>
  <a
    href={ctaHref}
    class="seo-open-app shrink-0 mt-1 max-w-[9.5rem] sm:max-w-none text-[11px] sm:text-xs font-bold text-right leading-tight underline-offset-2 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70 rounded-sm"
  >
    {ctaLabel}
  </a>
</header>

<script is:inline>
  (function () {
    try {
      var el = document.getElementById('current-day');
      if (!el) return;
      var names = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      var d = new Date();
      var day = d.getDay();
      var type = day === 0 ? 'No Service' : (day === 6 ? 'Saturday Schedule' : 'Weekday Schedule');
      var typeClass = day === 0
        ? 'font-bold text-red-600 dark:text-red-400'
        : 'font-bold text-blue-600 dark:text-blue-400';
      el.innerHTML = names[day] + ' · <span class="' + typeClass + '">' + type + '</span>';
    } catch (e) { /* keep Getting schedules… */ }
  })();
</script>
