---
/**
 * Crawlable landings use the in-app header chrome: Next Train left.
 * The region shortcut stays off this row. No logo, no theme toggle.
 */
import { withBase } from '../lib/config.js';

interface Props {
  region?: string;
  regionLabel?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const region = ['GP', 'WC', 'KZN', 'EC'].includes(Astro.props.region || '')
  ? Astro.props.region
  : '';
const regionLabel = Astro.props.regionLabel || '';
const homeHref = region
  ? withBase(`/?region=${encodeURIComponent(region)}`)
  : withBase('/');
const ctaHref = Astro.props.ctaHref || homeHref;
---

<header id="app-header" class="app-header shrink-0 px-3 py-2.5 z-30 relative flex items-start justify-between gap-2 border-b">
  <div class="min-w-0 shrink-0 header-brand-block">
    <a
      href={homeHref}
      class="block rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
      aria-label={regionLabel ? `Next Train home - ${regionLabel}` : 'Next Train home'}
    >
      <p id="app-title" class="header-title text-[2.55rem] sm:text-[2.75rem] font-black select-none tracking-[-0.035em] leading-none">
        Next Train
      </p>
    </a>
    <div class="header-meta mt-1.5 min-w-0">
      <p id="current-day" class="text-[11px] sm:text-xs font-medium text-gray-500 dark:text-gray-400 leading-tight">Getting schedules…</p>
    </div>
  </div>
</header>
<a id="seo-open-bar" class="seo-open-bar" href={ctaHref}>Open in Next Train</a>

<style is:global>
  .seo-open-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.85rem 1rem calc(0.85rem + env(safe-area-inset-bottom));
    background: #1d4ed8;
    color: #fff;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-decoration: none;
    box-shadow: 0 -10px 28px rgba(15, 23, 42, 0.16);
  }
  .seo-open-bar:hover { background: #1e40af; }
  body:has(#seo-open-bar) {
    padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
  }
  #app-header ~ main h1 {
    font-size: clamp(1.35rem, 0.85rem + 2.2vw, 2.15rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  @media (min-width: 1024px) {
    #app-header ~ main {
      max-width: 76rem;
      margin-inline: auto;
    }
    #app-header ~ main .max-w-2xl,
    #app-header ~ main .max-w-6xl {
      max-width: none;
    }
    #app-header ~ main h2 {
      font-size: 1.35rem;
      letter-spacing: -0.02em;
    }
  }
  #app-header ~ main .rounded-2xl,
  #app-header ~ main .rounded-xl {
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
  }
</style>

<script is:inline>
  (function () {
    try {
      var el = document.getElementById('current-day');
      if (!el) return;
      var names = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      var d = new Date();
      var day = d.getDay();
      var type = day === 0 ? 'No Service' : (day === 6 ? 'Saturday Schedule' : 'Weekday Schedule');
      var typeClass = day === 0
        ? 'font-bold text-red-600 dark:text-red-400'
        : 'font-bold text-blue-600 dark:text-blue-400';
      el.innerHTML = names[day] + ' · <span class="' + typeClass + '">' + type + '</span>';
      if (typeof window.fitHeaderDayLabel === 'function') window.fitHeaderDayLabel();
      else {
        var title = document.getElementById('app-title');
        var avail = title ? title.scrollWidth : 0;
        var sm = window.matchMedia && window.matchMedia('(min-width: 640px)').matches;
        var basePx = sm ? 12 : 11;
        var maxPx = sm ? 13 : 12;
        el.style.whiteSpace = 'nowrap';
        if (avail <= 8) { el.style.fontSize = basePx + 'px'; }
        else {
          var lo = 10, hi = maxPx, best = 10;
          for (var i = 0; i < 16; i++) {
            var mid = (lo + hi) / 2;
            el.style.fontSize = mid + 'px';
            if (el.scrollWidth <= avail + 0.75) { best = mid; lo = mid; }
            else hi = mid;
          }
          el.style.fontSize = Math.max(10, Math.min(best, maxPx)) + 'px';
        }
      }
    } catch (e) { /* keep Getting schedules… */ }
  })();
</script>
