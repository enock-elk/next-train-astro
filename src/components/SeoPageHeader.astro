---
/**
 * Shared chrome for crawlable SEO landings: logo (home + region hint),
 * primary Open Next Train CTA, and the theme toggle in document flow
 * so titles never slide under a fixed moon button.
 */
import { withBase } from '../lib/config.js';
import SeoThemeToggle from './SeoThemeToggle.astro';

interface Props {
  region?: string;
  regionLabel?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const region = ['GP', 'WC', 'KZN', 'EC'].includes(Astro.props.region || '')
  ? Astro.props.region
  : '';
const regionLabel = Astro.props.regionLabel || '';
const homeHref = region
  ? withBase(`/?region=${encodeURIComponent(region)}`)
  : withBase('/');
const ctaHref = Astro.props.ctaHref || homeHref;
const ctaLabel =
  Astro.props.ctaLabel ||
  (regionLabel ? `Open Next Train · ${regionLabel}` : 'Open Next Train');
const logoSrc = withBase('icons/icon-48.png');
---

<header class="border-b border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-950/95">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center gap-2 sm:gap-3">
    <a
      href={homeHref}
      class="shrink-0 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
      aria-label={regionLabel ? `Next Train home — ${regionLabel}` : 'Next Train home'}
    >
      <img
        src={logoSrc}
        alt="Next Train"
        width="40"
        height="40"
        class="h-10 w-10 rounded-lg"
      />
    </a>
    <a
      href={ctaHref}
      class="min-w-0 flex-1 inline-flex items-center justify-center rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs sm:text-sm py-2.5 px-3 text-center leading-tight shadow-sm"
    >
      {ctaLabel}
    </a>
    <div class="shrink-0">
      <SeoThemeToggle variant="inline" />
    </div>
  </div>
</header>
