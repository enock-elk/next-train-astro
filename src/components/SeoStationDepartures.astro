---
/**
 * Static full-day departure list for a station direction.
 * Mirrors the upcoming-trains modal: time, train id, Direct / To {short} badge.
 */
interface Props {
  title: string;
  trains: Array<{
    trainId: string;
    departureTime: string;
    badge: string;
    badgeLabel: string;
  }>;
  emptyLabel?: string;
}

const { title, trains, emptyLabel = 'No trains on this sheet.' } = Astro.props;
---

<section class="rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/80 overflow-hidden">
  <h3 class="px-4 py-3 text-sm font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800">
    {title}
  </h3>
  {trains.length === 0 ? (
    <p class="px-4 py-6 text-sm text-slate-500">{emptyLabel}</p>
  ) : (
    <ul class="divide-y divide-slate-100 dark:divide-slate-800">
      {trains.map((t) => (
        <li class="px-4 py-3 flex justify-between items-center gap-3">
          <div>
            <p class="text-lg font-bold text-slate-900 dark:text-white tabular-nums">{t.departureTime}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">Train {t.trainId}</p>
          </div>
          {t.badge === 'direct' ? (
            <span class="text-[10px] font-bold text-green-700 bg-green-100 dark:text-green-300 dark:bg-green-900 px-2 py-0.5 rounded-full uppercase whitespace-nowrap">
              Direct
            </span>
          ) : (
            <span class="text-[10px] font-bold text-orange-700 bg-orange-100 dark:text-orange-300 dark:bg-orange-900 px-2 py-0.5 rounded-full uppercase whitespace-nowrap text-right">
              {t.badgeLabel}
            </span>
          )}
        </li>
      ))}
    </ul>
  )}
</section>
