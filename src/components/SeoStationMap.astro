---
/**
 * Station SEO: Leaflet GPS map preview (map.html) that expands into a full-view
 * overlay matching the in-app Network Map sheet — not browser fullscreen.
 */
import { withBase } from '../lib/config.js';
import { buildStationMapPath } from '../lib/seo-stations.js';

const {
  station,
  regionLabel = '',
} = Astro.props;

const name = station?.name || 'Station';
const previewSrc = withBase(buildStationMapPath(station, { embed: true }));
const fullSrc = withBase(buildStationMapPath(station, { embed: false }));
const label = regionLabel || station?.region || '';
const title = `${name} on the GPS map`;
---

<section class="seo-station-map" id="seo-station-map" data-seo-station-map>
  <div class="mb-3">
    <h2 class="text-lg font-bold text-slate-900 dark:text-white">
      {name} on the map
    </h2>
  </div>

  <figure class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-900/60 shadow-sm">
    <button
      type="button"
      class="relative block w-full text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-inset"
      data-seo-station-map-open
      aria-label={`Expand ${name} GPS map`}
    >
      <div class="relative w-full aspect-[4/3] sm:aspect-[16/10] lg:aspect-[5/3] bg-slate-200 dark:bg-slate-900">
        <iframe
          title={`${name} Metrorail GPS map`}
          class="absolute inset-0 w-full h-full border-0 pointer-events-none"
          src={previewSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          tabindex="-1"
          aria-hidden="true"
        ></iframe>
        <span class="absolute inset-x-0 bottom-0 flex items-center justify-center gap-2 bg-gradient-to-t from-slate-900/70 to-transparent px-3 pt-10 pb-3 text-white text-xs font-bold pointer-events-none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4" />
          </svg>
          Tap to open full map
        </span>
      </div>
    </button>
    <figcaption class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300">
      {name} on the GPS map{label ? ` · ${label}` : ''}. Pan along the line, or expand for the full network map.
    </figcaption>
  </figure>
</section>

{/* Full-view overlay — same chrome as in-app #map-modal / Network Map sheet. */}
<div
  id="seo-station-map-lightbox"
  class="fixed inset-0 bg-black/90 z-[115] hidden flex-col items-stretch justify-center p-0 backdrop-blur-md"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="seo-station-map-lightbox-title"
  data-seo-station-map-lightbox
  data-map-src={fullSrc}
>
  <div class="bg-white dark:bg-gray-900 w-full h-full flex flex-col overflow-hidden">
    <div class="p-4 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center bg-gray-100 dark:bg-gray-800 z-20 shrink-0">
      <h3 id="seo-station-map-lightbox-title" class="text-lg font-bold text-gray-900 dark:text-white">{title}</h3>
      <button
        type="button"
        data-seo-station-map-close
        class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 transition focus:outline-none"
        aria-label="Close Map"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <div class="relative flex-1 min-h-0 overflow-hidden bg-gray-200 dark:bg-gray-950">
      <iframe
        id="seo-station-map-frame"
        title={`${name} GPS network map`}
        class="absolute inset-0 w-full h-full border-0"
        referrerpolicy="no-referrer-when-downgrade"
        allow="geolocation"
      ></iframe>
    </div>
    <div class="p-4 border-t border-gray-200 dark:border-gray-700 bg-gray-100 dark:bg-gray-800 z-20 shrink-0">
      <button
        type="button"
        data-seo-station-map-close
        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg shadow-md transition-colors focus:outline-none"
      >
        Close Map
      </button>
    </div>
  </div>
</div>

<script>
  function bindSeoStationMap() {
    const overlay = document.getElementById('seo-station-map-lightbox');
    const frame = document.getElementById('seo-station-map-frame');
    if (!overlay || !frame || overlay.dataset.bound === '1') return;
    overlay.dataset.bound = '1';

    let open = false;
    const mapSrc = overlay.getAttribute('data-map-src') || '';

    const lockScroll = () => document.body.classList.add('modal-active');
    const unlockScroll = () => {
      if (document.getElementById('alerts-channel')?.classList.contains('hidden') === false) return;
      document.body.classList.remove('modal-active');
    };

    const close = (fromPopState = false) => {
      if (!open) return;
      if (!fromPopState && location.hash === '#station-map') {
        try { history.back(); return; } catch { /* fall through */ }
      }
      open = false;
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      overlay.setAttribute('aria-hidden', 'true');
      unlockScroll();
    };

    const openMap = () => {
      if (!mapSrc) return;
      if (!frame.getAttribute('src')) frame.setAttribute('src', mapSrc);
      open = true;
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      overlay.setAttribute('aria-hidden', 'false');
      lockScroll();
      if (location.hash !== '#station-map') {
        try { history.pushState({ modal: 'station-map' }, '', '#station-map'); } catch { /* ignore */ }
      }
    };

    document.querySelectorAll('[data-seo-station-map-open]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openMap();
      });
    });
    overlay.querySelectorAll('[data-seo-station-map-close]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        close();
      });
    });
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });
    document.addEventListener('keydown', (e) => {
      if (!open || e.key !== 'Escape') return;
      e.preventDefault();
      close();
    });
    window.addEventListener('popstate', () => {
      if (open && location.hash !== '#station-map') close(true);
    });
  }

  bindSeoStationMap();
</script>
