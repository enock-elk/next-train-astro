---
/**
 * Crawlable timetable grid styled like the in-app sheet (light first-paint).
 * Ghost stations are already dropped by extractSeoGrid. A skip is the text EXPR.
 * Sticky Station column; train columns ~70px so phones show a few + scroll.
 * Toolbar: schedule effective-from + optional Download sit above the grid.
 */
const { grid, caption, downloadHref } = Astro.props;
const trainIds = grid?.trainIds || [];
const stations = grid?.stations || [];
const cells = grid?.cells || [];
const effectiveFrom = grid?.effectiveFrom || '';
---

{grid && stations.length > 0 && trainIds.length > 0 && (
  <div class="seo-tt">
    <div class="seo-tt-toolbar">
      {effectiveFrom ? (
        <p class="seo-tt-effective">Schedule effective from: {effectiveFrom}</p>
      ) : (
        <span class="seo-tt-effective-spacer" aria-hidden="true"></span>
      )}
      {downloadHref && (
        <a
          href={downloadHref}
          class="seo-tt-download inline-flex items-center justify-center rounded-xl border border-blue-600 text-blue-700 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-950/40 font-bold px-4 py-2.5 text-sm transition-colors shrink-0"
        >Download</a>
      )}
    </div>
    <div class="seo-tt-wrap">
      <table>
        {caption && <caption class="sr-only">{caption}</caption>}
        <thead>
          <tr>
            <th scope="col">Station</th>
            {trainIds.map((id: string) => (
              <th scope="col">{id}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {stations.map((station: string, r: number) => (
            <tr>
              <th scope="row">{station}</th>
              {trainIds.map((_id: string, c: number) => (
                <td>{cells[r]?.[c] || '-'}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
)}

<style is:global>
  .seo-tt { margin-top: 0.5rem; }
  .seo-tt-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.5rem;
  }
  .seo-tt-effective {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    line-height: 1.3;
  }
  .dark .seo-tt-effective { color: #94a3b8; }
  .seo-tt-effective-spacer { flex: 1 1 auto; min-width: 0; }
  .seo-tt-wrap {
    max-height: min(80vh, 56rem);
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: #fff;
  }
  .dark .seo-tt-wrap {
    border-color: #1e293b;
    background: #111827;
  }
  .seo-tt table {
    border-collapse: separate;
    border-spacing: 0;
    font-variant-numeric: tabular-nums;
    font-size: 13px;
    line-height: 1.25;
    min-width: 100%;
  }
  .seo-tt caption { caption-side: top; }
  .seo-tt th,
  .seo-tt td {
    white-space: nowrap;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid #d1d5db;
    border-right: 1px solid #e5e7eb;
    text-align: center;
  }
  .dark .seo-tt th,
  .dark .seo-tt td {
    border-bottom-color: #374151;
    border-right-color: #1f2937;
  }
  .seo-tt thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #f3f4f6;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #111827;
  }
  .seo-tt thead th:not(:first-child),
  .seo-tt td {
    min-width: 70px;
  }
  .dark .seo-tt thead th {
    background: #1f2937;
    color: #e5e7eb;
  }
  .seo-tt tbody th,
  .seo-tt thead th:first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    text-align: left;
    font-weight: 700;
    color: #111827;
    background: #f3f4f6;
    min-width: 140px;
    max-width: 140px;
    box-shadow: 1px 0 0 #d1d5db;
  }
  .seo-tt thead th:first-child {
    z-index: 3;
    background: #e5e7eb;
  }
  .dark .seo-tt tbody th,
  .dark .seo-tt thead th:first-child {
    color: #f9fafb;
    background: #1f2937;
    box-shadow: 1px 0 0 #374151;
  }
  .dark .seo-tt thead th:first-child { background: #111827; }
  .seo-tt tbody tr:nth-child(even) td {
    background: #f9fafb;
  }
  .seo-tt tbody tr:nth-child(even) th {
    background: #e5e7eb;
  }
  .dark .seo-tt tbody tr:nth-child(even) td {
    background: #1f2937;
  }
  .dark .seo-tt tbody tr:nth-child(even) th {
    background: #111827;
  }
  .seo-tt td { color: #1f2937; }
  .dark .seo-tt td { color: #d1d5db; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
