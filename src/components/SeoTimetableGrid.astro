---
/**
 * Compact crawlable timetable grid. All rows stay in the DOM; humans scroll
 * inside max-height ~22rem. Sticky station column; train columns follow
 * MANUAL_GRID_ORDER (same as the in-app sheet).
 */
const { grid, caption } = Astro.props;
const trainIds = grid?.trainIds || [];
const stations = grid?.stations || [];
const cells = grid?.cells || [];
---

{grid && stations.length > 0 && trainIds.length > 0 && (
  <div class="seo-tt">
    <div class="seo-tt-wrap">
      <table>
        {caption && <caption class="sr-only">{caption}</caption>}
        <thead>
          <tr>
            <th scope="col">Station</th>
            {trainIds.map((id) => (
              <th scope="col">{id}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {stations.map((station, r) => (
            <tr>
              <th scope="row">{station}</th>
              {trainIds.map((_, c) => (
                <td>{cells[r]?.[c] || ''}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
)}

<style is:global>
  .seo-tt { margin-top: 0.75rem; }
  .seo-tt-wrap {
    max-height: 22rem;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    background: #fff;
  }
  .dark .seo-tt-wrap {
    border-color: #1e293b;
    background: #0f172a;
  }
  .seo-tt table {
    border-collapse: separate;
    border-spacing: 0;
    font-variant-numeric: tabular-nums;
    font-size: 11px;
    line-height: 1.25;
    min-width: 100%;
  }
  .seo-tt caption { caption-side: top; }
  .seo-tt th,
  .seo-tt td {
    white-space: nowrap;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid #e2e8f0;
    text-align: center;
  }
  .dark .seo-tt th,
  .dark .seo-tt td { border-bottom-color: #1e293b; }
  .seo-tt thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #f8fafc;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #64748b;
  }
  .dark .seo-tt thead th {
    background: #1e293b;
    color: #94a3b8;
  }
  .seo-tt tbody th,
  .seo-tt thead th:first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    text-align: left;
    font-weight: 700;
    color: #0f172a;
    background: #fff;
    box-shadow: 1px 0 0 #e2e8f0;
  }
  .seo-tt thead th:first-child {
    z-index: 3;
    background: #f8fafc;
  }
  .dark .seo-tt tbody th,
  .dark .seo-tt thead th:first-child {
    color: #f8fafc;
    background: #0f172a;
    box-shadow: 1px 0 0 #1e293b;
  }
  .dark .seo-tt thead th:first-child { background: #1e293b; }
  .seo-tt td { color: #334155; }
  .dark .seo-tt td { color: #cbd5e1; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
