---
// Settings hub — Profile · Region · Travel · Preferences · Support · About
import { APP_VERSION } from '../lib/config.js';
const versionLabel = String(APP_VERSION).replace(/^V/i, 'v').replace(/_/g, ' ');
---

<div id="sidenav-overlay" class="fixed inset-0 bg-black/60 z-[90] hidden opacity-0 transition-opacity duration-300 backdrop-blur-sm"></div>

<div id="sidenav" class="fixed inset-y-0 right-0 w-[90vw] sm:w-96 shadow-2xl bg-white dark:bg-gray-900 flex flex-col h-full z-[100] transform translate-x-full transition-transform duration-300 cubic-bezier(0.4, 0, 0.2, 1)" role="dialog" aria-label="Settings">
    
    <div class="flex items-center justify-between px-5 pt-5 pb-3 shrink-0 gap-3">
        <div class="min-w-0 flex items-center gap-2.5">
            <h2 class="text-xl font-black text-gray-900 dark:text-white tracking-tight shrink-0">Next Train</h2>
            <button type="button" id="settings-app-version" class="relative inline-flex items-center gap-1.5 shrink-0 text-[10px] text-blue-600 dark:text-blue-400 font-mono font-bold bg-blue-50 dark:bg-blue-900/30 hover:bg-blue-100 dark:hover:bg-blue-800 px-2 py-1 rounded-lg transition-colors focus:outline-none" aria-label="What's New" title="What's New">
                <span id="whats-new-badge" class="hidden absolute -top-0.5 -right-0.5 w-2 h-2 bg-red-500 rounded-full animate-pulse shadow-sm"></span>
                <span class="font-mono">{versionLabel}</span>
            </button>
        </div>
        <button type="button" id="sidenav-close-btn" class="p-2 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 focus:outline-none shrink-0" aria-label="Close settings">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>

    <div class="flex-grow overflow-y-auto w-full custom-scrollbar pb-28 px-1">

        <!-- Profile -->
        <section class="mt-2 mb-5">
            <h3 class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest px-5 mb-2">Profile</h3>
            <div class="bg-gray-50 dark:bg-gray-800/50 mx-3 rounded-2xl overflow-hidden">
                <button type="button" id="settings-account-btn" class="w-full flex justify-between items-center py-3.5 px-4 hover:bg-gray-100/80 dark:hover:bg-gray-700/40 transition-colors focus:outline-none group border-b border-gray-200/70 dark:border-gray-700/60">
                    <div class="flex items-center space-x-4 min-w-0">
                        <div id="settings-account-avatar" data-signed-in="false" class="w-9 h-9 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center overflow-hidden shrink-0 ring-1 ring-gray-200 dark:ring-gray-600">
                            <img id="settings-account-avatar-img" class="w-full h-full object-cover hidden" alt="" />
                            <span id="settings-account-avatar-ph" class="text-sm font-black text-gray-500 dark:text-gray-300">?</span>
                        </div>
                        <div class="text-left min-w-0">
                            <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight" id="settings-account-name">Account</p>
                            <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5 truncate" id="settings-account-sub">Guest · Sign in optional</p>
                        </div>
                    </div>
                    <svg class="w-4 h-4 text-gray-300 dark:text-gray-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>

                <button type="button" id="settings-profile-btn" class="w-full flex justify-between items-center py-3.5 px-4 hover:bg-gray-100/80 dark:hover:bg-gray-700/40 transition-colors focus:outline-none group">
                    <div class="flex items-center space-x-4">
                        <svg class="w-5 h-5 text-blue-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        <div class="text-left">
                            <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Passenger Type</p>
                            <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5" id="settings-profile-display">Adult</p>
                        </div>
                    </div>
                    <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
            </div>
        </section>

        <!-- Region -->
        <section class="mb-5 relative z-40">
            <h3 class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest px-5 mb-2">Region</h3>
            <div class="bg-gray-50 dark:bg-gray-800/50 mx-3 rounded-2xl overflow-visible relative z-40">
                <div class="relative z-50" id="sidenav-region-wrapper">
                    <button type="button" class="w-full flex justify-between items-center py-3.5 px-4 hover:bg-gray-100/80 dark:hover:bg-gray-700/40 transition-colors focus:outline-none group rounded-2xl" id="sidenav-region-container">
                        <div class="flex items-center space-x-4">
                            <svg class="w-5 h-5 text-green-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <div class="text-left">
                                <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Active Region</p>
                                <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5" id="sidenav-region-display">Gauteng</p>
                            </div>
                        </div>
                        <svg id="sidenav-region-chevron" class="w-4 h-4 text-gray-300 dark:text-gray-600 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                    <select id="app-hub-region-select" class="hidden">
                        <option value="GP">Gauteng</option>
                        <option value="WC">Western Cape</option>
                        <option value="KZN">KwaZulu-Natal</option>
                        <option value="EC">Eastern Cape</option>
                    </select>
                    <ul id="sidenav-region-list" class="absolute z-[220] w-[calc(100%-1rem)] left-2 top-[3.25rem] bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-2xl hidden flex-col overflow-hidden text-left">
                        <li data-region-target="GP" class="px-4 py-3 text-sm font-bold hover:bg-blue-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-colors border-b border-gray-100 dark:border-gray-700 cursor-pointer">Gauteng</li>
                        <li data-region-target="WC" class="px-4 py-3 text-sm font-bold hover:bg-blue-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-colors border-b border-gray-100 dark:border-gray-700 cursor-pointer">Western Cape</li>
                        <li data-region-target="KZN" class="px-4 py-3 text-sm font-bold hover:bg-blue-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-colors border-b border-gray-100 dark:border-gray-700 cursor-pointer">KwaZulu-Natal</li>
                        <li data-region-target="EC" class="px-4 py-3 text-sm font-bold hover:bg-blue-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-colors cursor-pointer">Eastern Cape</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Travel (includes Community) -->
        <section class="mb-5 relative z-10">
            <h3 class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest px-5 mb-2">Travel</h3>
            <div class="bg-gray-50 dark:bg-gray-800/50 mx-3 rounded-2xl overflow-hidden">
                <button type="button" id="sidenav-interactive-map-btn" class="w-full flex justify-between items-center py-3.5 px-4 hover:bg-gray-100/80 dark:hover:bg-gray-700/40 transition-colors focus:outline-none group border-b border-gray-200/70 dark:border-gray-700/60">
                    <div class="flex items-center space-x-4">
                        <svg class="w-5 h-5 text-blue-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        <div class="text-left">
                            <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">GPS Network Map</p>
                            <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">Interactive & Tracking</p>
                        </div>
                    </div>
                    <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
                <button type="button" id="view-map-btn" class="w-full flex justify-between items-center py-3.5 px-4 hover:bg-gray-100/80 dark:hover:bg-gray-700/40 transition-colors focus:outline-none group border-b border-gray-200/70 dark:border-gray-700/60">
                    <div class="flex items-center space-x-4">
                        <svg class="w-5 h-5 text-gray-400 dark:text-gray-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <div class="text-left">
                            <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">PRASA Route Map</p>
                            <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">Official Network Map</p>
                        </div>
                    </div>
                    <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
                <button type="button" id="sidenav-community-btn" class="w-full flex justify-between items-center py-3.5 px-4 hover:bg-gray-100/80 dark:hover:bg-gray-700/40 transition-colors focus:outline-none group">
                    <div class="flex items-center space-x-4">
                        <svg class="w-5 h-5 text-blue-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a2 2 0 01-2-2v-1"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v3l3.5-3H15a2 2 0 002-2V4a2 2 0 00-2-2z"></path></svg>
                        <div class="text-left">
                            <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Route Community</p>
                            <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">Feed for your active line</p>
                        </div>
                    </div>
                    <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
            </div>
        </section>

        <!-- Preferences -->
        <section class="mb-5">
            <h3 class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest px-5 mb-2">Preferences</h3>
            <div class="bg-gray-50 dark:bg-gray-800/50 mx-3 rounded-2xl overflow-hidden">
                <button type="button" id="settings-theme-toggle" class="w-full flex justify-between items-center py-3.5 px-4 hover:bg-gray-100/80 dark:hover:bg-gray-700/40 transition-colors focus:outline-none group border-b border-gray-200/70 dark:border-gray-700/60">
                    <div class="flex items-center space-x-4">
                        <svg class="w-5 h-5 text-indigo-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                        <div class="text-left">
                            <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Dark Mode</p>
                            <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">Light / dark</p>
                        </div>
                    </div>
                    <div class="relative inline-block w-10 align-middle select-none transition duration-200 ease-in">
                        <input type="checkbox" id="settings-theme-checkbox" class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 border-gray-300 appearance-none cursor-pointer outline-none"/>
                        <label for="settings-theme-checkbox" class="toggle-label block overflow-hidden h-5 rounded-full bg-gray-300 cursor-pointer"></label>
                    </div>
                </button>

                <div class="py-3.5 px-4 border-b border-gray-200/70 dark:border-gray-700/60">
                    <div class="flex items-center space-x-4 mb-3">
                        <svg class="w-5 h-5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
                        <div class="text-left">
                            <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Colour Pack</p>
                            <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5" id="settings-colour-pack-display">Classic</p>
                        </div>
                    </div>
                    <div id="colour-pack-picker" class="ml-9 grid grid-cols-3 gap-2 relative z-10" role="group" aria-label="Colour pack">
                        <button type="button" data-colour-pack-option="classic" class="colour-pack-option cursor-pointer" aria-pressed="true" style="--pack-accent:#2563eb">
                            <span class="colour-pack-swatch" style="--swatch-a:#eff6ff;--swatch-b:#2563eb;--swatch-c:#1e40af"></span>
                            <span class="pack-label">Classic</span>
                        </button>
                        <button type="button" data-colour-pack-option="midnight" class="colour-pack-option cursor-pointer" aria-pressed="false" style="--pack-accent:#0284c7">
                            <span class="colour-pack-swatch" style="--swatch-a:#f1f5f9;--swatch-b:#0ea5e9;--swatch-c:#0f172a"></span>
                            <span class="pack-label">Midnight</span>
                        </button>
                        <button type="button" data-colour-pack-option="contrast" class="colour-pack-option cursor-pointer" aria-pressed="false" style="--pack-accent:#0f172a">
                            <span class="colour-pack-swatch" style="--swatch-a:#f8fafc;--swatch-b:#0f172a;--swatch-c:#2563eb"></span>
                            <span class="pack-label">Contrast</span>
                        </button>
                        <button type="button" data-colour-pack-option="signal" class="colour-pack-option cursor-pointer" aria-pressed="false" style="--pack-accent:#059669">
                            <span class="colour-pack-swatch" style="--swatch-a:#ecfdf5;--swatch-b:#059669;--swatch-c:#064e3b"></span>
                            <span class="pack-label">Signal</span>
                        </button>
                        <button type="button" data-colour-pack-option="ember" class="colour-pack-option cursor-pointer" aria-pressed="false" style="--pack-accent:#d97706">
                            <span class="colour-pack-swatch" style="--swatch-a:#fffbeb;--swatch-b:#d97706;--swatch-c:#92400e"></span>
                            <span class="pack-label">Ember</span>
                        </button>
                    </div>
                    <p class="ml-9 mt-2 text-[10px] text-gray-400 dark:text-gray-500 leading-snug">Selected pack tints the chrome and CTAs. Alerts keep their colours.</p>
                </div>

                <div class="py-3.5 px-4 border-b border-gray-200/70 dark:border-gray-700/60">
                    <div class="flex items-center space-x-4 mb-3">
                        <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                        <div class="text-left">
                            <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Navigation</p>
                            <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">Top tabs or bottom bar</p>
                        </div>
                    </div>
                    <div class="ml-9 grid grid-cols-2 gap-2 p-1 bg-white/70 dark:bg-gray-900/50 rounded-xl" role="group" aria-label="Navigation style">
                        <button type="button" data-nav-style-option="top" class="text-xs font-bold py-2.5 px-2 rounded-lg transition-colors focus:outline-none bg-blue-600 text-white shadow-sm" aria-pressed="true">Top tabs</button>
                        <button type="button" data-nav-style-option="bottom" class="text-xs font-bold py-2.5 px-2 rounded-lg transition-colors focus:outline-none bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300" aria-pressed="false">Bottom bar</button>
                    </div>
                    <p class="ml-9 mt-2 text-[10px] text-gray-400 dark:text-gray-500 leading-snug">Bottom: Next Train · Trip Planner · Community · More. Applies immediately.</p>
                </div>

                <button type="button" id="settings-haptics-toggle" class="w-full flex justify-between items-center py-3.5 px-4 hover:bg-gray-100/80 dark:hover:bg-gray-700/40 transition-colors focus:outline-none group border-b border-gray-200/70 dark:border-gray-700/60">
                    <div class="flex items-center space-x-4">
                        <svg class="w-5 h-5 text-pink-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                        <div class="text-left">
                            <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Vibrations</p>
                            <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">Haptic feedback</p>
                        </div>
                    </div>
                    <div class="relative inline-block w-10 align-middle select-none transition duration-200 ease-in">
                        <input type="checkbox" id="settings-haptics-checkbox" class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 border-gray-300 appearance-none cursor-pointer outline-none"/>
                        <label for="settings-haptics-checkbox" class="toggle-label block overflow-hidden h-5 rounded-full bg-gray-300 cursor-pointer"></label>
                    </div>
                </button>

                <button type="button" id="settings-notify-toggle" class="w-full flex justify-between items-center py-3.5 px-4 hover:bg-gray-100/80 dark:hover:bg-gray-700/40 transition-colors focus:outline-none group">
                    <div class="flex items-center space-x-4">
                        <svg class="w-5 h-5 text-amber-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V4a2 2 0 10-4 0v1.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                        <div class="text-left">
                            <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Notifications</p>
                            <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5" id="settings-notify-hint">Room activity (coming soon)</p>
                        </div>
                    </div>
                    <div class="relative inline-block w-10 align-middle select-none transition duration-200 ease-in">
                        <input type="checkbox" id="settings-notify-checkbox" class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 border-gray-300 appearance-none cursor-pointer outline-none"/>
                        <label for="settings-notify-checkbox" class="toggle-label block overflow-hidden h-5 rounded-full bg-gray-300 cursor-pointer"></label>
                    </div>
                </button>
            </div>
        </section>

        <!-- Support -->
        <section class="mb-5">
            <h3 class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest px-5 mb-2">Support</h3>
            <div class="bg-gray-50 dark:bg-gray-800/50 mx-3 rounded-2xl overflow-hidden">
                <button type="button" id="check-updates-btn" class="w-full flex justify-between items-center py-3.5 px-4 hover:bg-gray-100/80 dark:hover:bg-gray-700/40 transition-colors focus:outline-none group border-b border-gray-200/70 dark:border-gray-700/60">
                    <div class="flex items-center space-x-4">
                        <svg class="w-5 h-5 text-orange-500 group-hover:rotate-180 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m-15.357-2a8.001 8.001 0 0015.357 2m0 0H15"></path></svg>
                        <span class="text-sm font-bold text-gray-900 dark:text-white">Check for Updates</span>
                    </div>
                    <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
                <button type="button" id="settings-help-btn" class="w-full flex justify-between items-center py-3.5 px-4 hover:bg-gray-100/80 dark:hover:bg-gray-700/40 transition-colors focus:outline-none border-b border-gray-200/70 dark:border-gray-700/60">
                    <span class="text-sm font-bold text-gray-900 dark:text-white px-1">User Guide & Tips</span>
                    <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
