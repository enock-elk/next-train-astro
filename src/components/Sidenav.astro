---
/**
 * SPA-parity App Hub — flat left drawer matching metrorail-app / spa-reference.
 * Sections: Preferences · Network Maps · Data & Sync · About & Updates
 */
import { APP_VERSION } from '../lib/config.js';
const versionBadge = String(APP_VERSION);
---

<div id="sidenav-overlay" class="fixed inset-0 bg-black/50 z-[90] hidden opacity-0 transition-opacity duration-300"></div>

<!-- APP HUB SIDENAV (Flat Native UI Edition — slides from left like live SPA) -->
<div
  id="sidenav"
  class="fixed inset-y-0 left-0 w-[80vw] sm:w-[21.5rem] shadow-2xl bg-white dark:bg-gray-900 flex flex-col h-full z-[100] -translate-x-full transition-transform duration-300"
  role="dialog"
  aria-label="App Hub"
  style="transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);"
>
  <div class="flex-grow overflow-y-auto w-full custom-scrollbar pb-24 pt-0">

    <!-- PREFERENCES -->
    <div>
      <h3 class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest px-5 mb-2 mt-4">Preferences</h3>
      <div class="flex flex-col border-t border-gray-100 dark:border-gray-800">

        <div class="relative" id="sidenav-region-wrapper">
          <button
            type="button"
            class="w-full flex justify-between items-center py-3 px-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors border-b border-gray-100 dark:border-gray-800 focus:outline-none group"
            id="sidenav-region-container"
          >
            <div class="flex items-center space-x-4">
              <svg class="w-5 h-5 text-green-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <div class="text-left">
                <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Active Region</p>
                <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5" id="sidenav-region-display">Gauteng</p>
              </div>
            </div>
            <svg id="sidenav-region-chevron" class="w-4 h-4 text-gray-300 dark:text-gray-600 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>

          <select id="app-hub-region-select" class="hidden" tabindex="-1" aria-hidden="true">
            <option value="GP">Gauteng</option>
            <option value="WC">Western Cape</option>
            <option value="KZN">KwaZulu-Natal</option>
            <option value="EC">Eastern Cape</option>
          </select>

          <ul id="sidenav-region-list" class="absolute z-[200] w-[calc(100%-2rem)] left-4 top-[2.75rem] bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-xl hidden flex-col overflow-hidden text-left">
            <li data-region-target="GP" class="px-4 py-3 text-sm font-bold hover:bg-blue-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-colors border-b border-gray-100 dark:border-gray-700 cursor-pointer">Gauteng</li>
            <li data-region-target="WC" class="px-4 py-3 text-sm font-bold hover:bg-blue-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-colors border-b border-gray-100 dark:border-gray-700 cursor-pointer">Western Cape</li>
            <li data-region-target="KZN" class="px-4 py-3 text-sm font-bold hover:bg-blue-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-colors border-b border-gray-100 dark:border-gray-700 cursor-pointer">KwaZulu-Natal</li>
            <li data-region-target="EC" class="px-4 py-3 text-sm font-bold hover:bg-blue-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition-colors cursor-pointer">Eastern Cape</li>
          </ul>
        </div>

        <button type="button" id="settings-profile-btn" class="w-full flex justify-between items-center py-3 px-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors border-b border-gray-100 dark:border-gray-800 focus:outline-none group">
          <div class="flex items-center space-x-4">
            <svg class="w-5 h-5 text-blue-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            <div class="text-left">
              <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Passenger Type</p>
              <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5" id="settings-profile-display">Adult</p>
            </div>
          </div>
          <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>

        <button type="button" id="settings-theme-toggle" class="w-full flex justify-between items-center py-3 px-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors border-b border-gray-100 dark:border-gray-800 focus:outline-none group">
          <div class="flex items-center space-x-4">
            <svg class="w-5 h-5 text-indigo-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            <div class="text-left">
              <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Dark Mode</p>
            </div>
          </div>
          <div class="relative inline-block w-10 align-middle select-none transition duration-200 ease-in">
            <input type="checkbox" id="settings-theme-checkbox" class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 border-gray-300 appearance-none cursor-pointer outline-none" />
            <label for="settings-theme-checkbox" class="toggle-label block overflow-hidden h-5 rounded-full bg-gray-300 cursor-pointer"></label>
          </div>
        </button>

        <button type="button" id="settings-haptics-toggle" class="w-full flex justify-between items-center py-3 px-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors border-b border-gray-100 dark:border-gray-800 focus:outline-none group">
          <div class="flex items-center space-x-4">
            <svg class="w-5 h-5 text-pink-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
            <div class="text-left">
              <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Vibrations</p>
            </div>
          </div>
          <div class="relative inline-block w-10 align-middle select-none transition duration-200 ease-in">
            <input type="checkbox" id="settings-haptics-checkbox" class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 border-gray-300 appearance-none cursor-pointer outline-none" />
            <label for="settings-haptics-checkbox" class="toggle-label block overflow-hidden h-5 rounded-full bg-gray-300 cursor-pointer"></label>
          </div>
        </button>
      </div>
    </div>

    <!-- NETWORK MAPS -->
    <div class="pt-5">
      <h3 class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest px-5 mb-2">Network Maps</h3>
      <div class="flex flex-col border-t border-gray-100 dark:border-gray-800">
        <button type="button" id="sidenav-interactive-map-btn" class="w-full flex justify-between items-center py-3 px-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors border-b border-gray-100 dark:border-gray-800 focus:outline-none group">
          <div class="flex items-center space-x-4">
            <svg class="w-5 h-5 text-blue-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <div class="text-left">
              <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">GPS Network Map</p>
              <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">Interactive &amp; Tracking</p>
            </div>
          </div>
          <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
        <button type="button" id="view-map-btn" class="w-full flex justify-between items-center py-3 px-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors border-b border-gray-100 dark:border-gray-800 focus:outline-none group">
          <div class="flex items-center space-x-4">
            <svg class="w-5 h-5 text-gray-400 dark:text-gray-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <div class="text-left">
              <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">PRASA Route Map</p>
              <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">Official Network Map</p>
            </div>
          </div>
          <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>

    <!-- DATA & SYNC -->
    <div class="pt-5">
      <h3 class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest px-5 mb-2">Data &amp; Sync</h3>
      <div class="flex flex-col border-t border-gray-100 dark:border-gray-800">
        <button type="button" id="check-updates-btn" class="w-full flex justify-between items-center py-3 px-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors border-b border-gray-100 dark:border-gray-800 focus:outline-none group">
          <div class="flex items-center space-x-4">
            <svg class="w-5 h-5 text-orange-500 group-hover:rotate-180 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m-15.357-2a8.001 8.001 0 0015.357 2m0 0H15"></path></svg>
            <div class="text-left">
              <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Check for Updates</p>
            </div>
          </div>
          <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
        <button type="button" id="reload-app-btn" class="w-full flex justify-between items-center py-3 px-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors border-b border-gray-100 dark:border-gray-800 focus:outline-none group">
          <div class="flex items-center space-x-4">
            <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m-15.357-2a8.001 8.001 0 0015.357 2m0 0H15"></path></svg>
            <div class="text-left">
              <p class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Reload App</p>
              <p class="text-[10px] text-gray-400 dark:text-gray-500 leading-tight mt-0.5">Soft refresh — keeps offline schedules</p>
            </div>
          </div>
          <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>

    <!-- ABOUT & UPDATES -->
    <div class="pt-5">
      <h3 class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest px-5 mb-2">About &amp; Updates</h3>
      <div class="flex flex-col">
        <button type="button" id="settings-about-btn" class="w-full flex justify-between items-center py-3 px-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors border-b border-gray-100 dark:border-gray-800 focus:outline-none">
          <span class="text-sm font-bold text-gray-900 dark:text-white">About Next Train</span>
          <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
        <button type="button" id="settings-help-btn" class="w-full flex justify-between items-center py-3 px-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors border-b border-gray-100 dark:border-gray-800 focus:outline-none">
          <span class="text-sm font-bold text-gray-900 dark:text-white">User Guide &amp; Tips</span>
          <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
        <button type="button" id="settings-app-version" class="w-full flex justify-between items-center py-3 px-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors focus:outline-none group">
          <span class="text-sm font-bold text-gray-900 dark:text-white">What's New</span>
          <div class="flex items-center space-x-2">
            <span id="whats-new-badge" class="hidden w-2.5 h-2.5 bg-red-500 rounded-full animate-pulse shadow-sm mr-1"></span>
            <span class="font-mono text-[10px] text-blue-600 dark:text-blue-400 font-bold bg-blue-50 dark:bg-blue-900/30 px-2 py-0.5 rounded group-hover:bg-blue-100 dark:group-hover:bg-blue-800 transition-colors">{versionBadge}</span>
            <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  import { $userRegion } from '../store.js';

  const closeNav = () => {
    if (typeof window.closeAppHub === 'function') window.closeAppHub();
  };

  document.getElementById('sidenav-overlay')?.addEventListener('click', closeNav);

  // Swipe right→left inside the open drawer to dismiss (does not touch home tab swipes)
  const sidenavEl = document.getElementById('sidenav');
  if (sidenavEl && sidenavEl.dataset.swipeCloseBound !== '1') {
    sidenavEl.dataset.swipeCloseBound = '1';
    let startX = 0;
    let startY = 0;
    let tracking = false;
    sidenavEl.addEventListener('touchstart', (e) => {
      if (!sidenavEl.classList.contains('open')) return;
      const t = e.changedTouches?.[0];
      if (!t) return;
      startX = t.clientX;
      startY = t.clientY;
      tracking = true;
    }, { passive: true });
    sidenavEl.addEventListener('touchend', (e) => {
      if (!tracking || !sidenavEl.classList.contains('open')) { tracking = false; return; }
      tracking = false;
      const t = e.changedTouches?.[0];
      if (!t) return;
      const dx = t.clientX - startX;
      const dy = t.clientY - startY;
      // Horizontal swipe left, not a vertical scroll
      if (dx < -56 && Math.abs(dx) > Math.abs(dy) * 1.25) closeNav();
    }, { passive: true });
  }

  const regionContainer = document.getElementById('sidenav-region-container');
  const regionList = document.getElementById('sidenav-region-list');
  const regionChevron = document.getElementById('sidenav-region-chevron');

  regionContainer?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (typeof window.toggleDropdownScrim === 'function') {
      window.toggleDropdownScrim('sidenav-region-list', 'sidenav-region-chevron');
    } else {
      regionList?.classList.toggle('hidden');
      regionChevron?.classList.toggle('rotate-180');
    }
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('#sidenav-region-wrapper') && regionList && !regionList.classList.contains('hidden')) {
      regionList.classList.add('hidden');
      regionChevron?.classList.remove('rotate-180');
    }
  });

  $userRegion.subscribe((region) => {
    import('../lib/logic.js').then(({ syncRegionDisplayDom }) => {
      syncRegionDisplayDom(region || 'GP');
    }).catch(() => {
      const regionNames = { GP: 'Gauteng', WC: 'Western Cape', KZN: 'KwaZulu-Natal', EC: 'Eastern Cape' };
      const disp = document.getElementById('sidenav-region-display');
      if (disp) disp.textContent = regionNames[region] || 'Gauteng';
      const sel = document.getElementById('app-hub-region-select');
      if (sel) sel.value = region || 'GP';
    });
  });

  document.querySelectorAll('#sidenav-region-list [data-region-target]').forEach((item) => {
    item.addEventListener('click', async (e) => {
      const target = e.currentTarget.getAttribute('data-region-target');
      if (!target) return;
      regionList?.classList.add('hidden');
      regionChevron?.classList.remove('rotate-180');
      if (typeof window.toggleDropdownScrim === 'function') window.toggleDropdownScrim();
      const { handleRegionChange } = await import('../lib/logic.js');
      await handleRegionChange(target);
      closeNav();
    });
  });

  const themeToggle = document.getElementById('settings-theme-toggle');
  const themeCheckbox = document.getElementById('settings-theme-checkbox');
  const applyTheme = (isDark) => {
    document.documentElement.classList.toggle('dark', isDark);
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (err) { /* Safari private / WebView Access Denied */ }
    if (themeCheckbox) themeCheckbox.checked = isDark;
  };
  if (themeCheckbox) themeCheckbox.checked = document.documentElement.classList.contains('dark');
  themeToggle?.addEventListener('click', (e) => {
    if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'LABEL') {
      applyTheme(!document.documentElement.classList.contains('dark'));
    }
  });
  themeCheckbox?.addEventListener('change', (e) => applyTheme(e.target.checked));
</script>

<style>
  /* Mirror SPA JIT bypass so open class wins over Tailwind translate utilities */
  #sidenav {
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }
  #sidenav.open {
    transform: translateX(0) !important;
  }

  .toggle-checkbox:checked { right: 0; border-color: #3b82f6; }
  .toggle-checkbox:checked + .toggle-label { background-color: #3b82f6; }
  .toggle-checkbox { right: 20px; transition: all 0.3s; }
</style>
