---
// Strict visual clone of old SPA #view-trip-planner
---

<div id="view-trip-planner" class="view-section p-4 pb-6 bg-gray-50 dark:bg-gray-900/50 flex flex-col flex-grow min-h-0">
    <div class="planner-title-block text-center mb-5 flex flex-col justify-center items-center w-full shrink-0">
        <button id="planner-info-btn" class="w-full grid grid-cols-[3rem_1fr_3rem] items-center bg-white dark:bg-gray-800 h-[46px] rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 mb-1 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors overflow-hidden group focus:outline-none">
            <div class="w-full h-full"></div>
            <h2 class="text-sm sm:text-base font-medium text-gray-700 dark:text-gray-200 group-hover:opacity-80 transition-colors truncate w-full px-1 text-center">
                Advanced Multi-Transfer Routing
            </h2>
            <div class="w-full h-full flex items-center justify-center">
                <svg class="w-5 h-5 text-blue-500 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </button>
        <!-- Phantom line matches Live Board “Schedule updated” height on the search form only -->
        <p class="planner-schedule-phantom text-[10px] text-transparent font-medium uppercase tracking-wide select-none mt-1">Schedule updated: --</p>
    </div>
    
    <div id="planner-input-section" class="space-y-7 shrink-0">
        <!-- FROM SECTION — same slot as Next Train #station-field-hit so the field does not jump on tab switch -->
        <div class="nt-from-station-slot mb-5 relative z-20" id="planner-from-field-hit">
            <label for="planner-from-search" class="sr-only">From Station</label>
            <div class="flex items-center gap-2">
                <div class="relative flex-grow shadow-sm rounded-xl">
                    <input type="text" id="planner-from-search" name="planner_origin_search_ignore" autocomplete="off" autocorrect="off" spellcheck="false" placeholder="Select From Station..." class="block w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl shadow-sm p-3 text-lg font-medium focus:ring-blue-500 focus:border-blue-500 transition-colors h-[54px] appearance-none pr-12 truncate">
                    <select id="planner-from" class="hidden w-full p-4 rounded-xl bg-white dark:bg-gray-800 border-2 border-gray-200 dark:border-gray-700 text-lg font-medium text-gray-900 dark:text-white shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors">
                        <option value="">Loading stations...</option>
                    </select>
                </div>
                <button id="planner-locate-btn" class="bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-xl shadow-md transition-colors flex-shrink-0 h-[54px] w-[54px] flex items-center justify-center focus:outline-none" title="Find my nearest station" aria-label="Find Nearest Station">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="18" y2="12"/><line x1="6" y1="12" x2="2" y2="12"/><line x1="12" y1="6" x2="12" y2="2"/><line x1="12" y1="22" x2="12" y2="18"/></svg>
                </button>
            </div>
        </div>

        <!-- SWAP BUTTON -->
        <div class="flex justify-center -my-2 relative z-10">
            <button id="planner-swap-btn" type="button" class="bg-blue-100 dark:bg-blue-900 p-2.5 rounded-full text-blue-600 dark:text-blue-400 border-4 border-gray-50 dark:border-gray-900 shadow-md hover:scale-110 transition-transform focus:outline-none" aria-label="Swap Stations">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l-4-4m4 4l4-4"></path></svg>
            </button>
        </div>

        <!-- TO SECTION -->
        <div class="relative">
            <label for="planner-to-search" class="sr-only">To Station</label>
            <input type="text" id="planner-to-search" name="planner_dest_search_ignore" autocomplete="off" autocorrect="off" spellcheck="false" placeholder="Select To Station..." class="w-full mb-2 p-3 rounded-xl bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white text-lg font-medium shadow-sm h-[54px] pr-12 truncate">
            <select id="planner-to" class="hidden w-full p-4 rounded-xl bg-white dark:bg-gray-800 border-2 border-gray-200 dark:border-gray-700 text-lg font-medium text-gray-900 dark:text-white shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors">
                <option value="">Loading stations...</option>
            </select>
        </div>

        <button id="planner-search-btn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-xl shadow-lg text-lg transition-transform active:scale-95 flex justify-center items-center focus:outline-none">
            Plan Trip
        </button>
    </div>

    <!-- Results Section -->
    <div id="planner-results-section" class="hidden mt-0 space-y-3 shrink-0">
        <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 mb-3 min-h-[32px]">
            <div class="justify-self-start">
                <button id="planner-back-btn" type="button" class="inline-flex items-center text-sm font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2 py-1.5 rounded-lg hover:bg-blue-100 dark:hover:bg-blue-900 transition-colors group shadow-sm border border-blue-100 dark:border-blue-800 focus:outline-none h-8">
                    <svg class="w-4 h-4 mr-1 transform group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7-7h18"></path></svg>
                    Back
                </button>
            </div>
            <h4 class="text-lg font-bold text-gray-900 dark:text-white m-0 justify-self-center text-center px-1">Your Journey</h4>
            <div class="planner-share-slot justify-self-end min-h-[32px] flex items-center justify-end"></div>
        </div>
        <div id="planner-results-list" class="space-y-4"></div>
    </div>

    <div id="planner-spacer" class="flex-1 basis-0 min-h-0" aria-hidden="true"></div>

    <!-- Footer actions (parity with Live Board / SPA planner) -->
    <div class="mt-auto border-t border-gray-200 dark:border-gray-700 pt-4 shrink-0">
        <div class="grid grid-cols-2 gap-2.5 mb-3">
            <button type="button" id="share-app-btn-planner" class="group flex items-center justify-center gap-2 w-full bg-gray-50 dark:bg-gray-800/80 border border-gray-200 dark:border-gray-700 text-gray-800 dark:text-gray-100 font-semibold py-2.5 px-3 rounded-xl shadow-sm hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:border-blue-200 dark:hover:border-blue-800 hover:text-blue-700 dark:hover:text-blue-300 transition-colors text-sm focus:outline-none">
                <svg class="w-4 h-4 text-gray-500 dark:text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98"/></svg>
                <span>Share App</span>
            </button>
            <button type="button" id="feedback-btn-planner" class="group flex items-center justify-center gap-2 w-full bg-gray-50 dark:bg-gray-800/80 border border-gray-200 dark:border-gray-700 text-gray-800 dark:text-gray-100 font-semibold py-2.5 px-3 rounded-xl shadow-sm hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:border-blue-200 dark:hover:border-blue-800 hover:text-blue-700 dark:hover:text-blue-300 transition-colors text-sm focus:outline-none">
                <svg class="w-4 h-4 text-gray-500 dark:text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                <span>Feedback</span>
            </button>
        </div>
        <div class="mt-3 mb-3">
            <button type="button" id="install-app-btn-planner" class="hidden flex items-center justify-center w-full bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded-lg shadow-md transition-colors text-sm">
                <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg> Install App In Background (&lt; 1 MB)
            </button>
        </div>
        <div class="flex justify-center items-center space-x-4 mt-4">
            <button type="button" class="hub-legal-link text-[10px] text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 font-medium transition-colors cursor-pointer underline underline-offset-2 decoration-gray-300 dark:decoration-gray-600 focus:outline-none" data-legal="terms">Terms of Use</button>
            <span class="text-gray-300 dark:text-gray-600 text-[10px]">|</span>
            <button type="button" class="hub-legal-link text-[10px] text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 font-medium transition-colors cursor-pointer underline underline-offset-2 decoration-gray-300 dark:decoration-gray-600 focus:outline-none" data-legal="privacy">Privacy Policy</button>
        </div>
        <p class="text-[10px] text-gray-400 dark:text-gray-500 text-center mt-1">2026 &copy; Kazembe CodeWorks.</p>
    </div>
</div>
