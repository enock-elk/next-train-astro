---
/**
 * SEO-first layout for standalone content pages (map, guide, status).
 * Safe for cold visitors — no app store hydration required.
 */
import '../styles/appearance.css';
import { MANIFEST_FILENAME, normalizeBase, withBase } from '../lib/config.js';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: string;
  ogImage?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  twitterCard?: string;
  themeColor?: string;
  forceDark?: boolean;
  /** Opt out of the theme script entirely — for print assets with a fixed light design. */
  forceLight?: boolean;
  bodyClass?: string;
  htmlClass?: string;
  robots?: string;
}

const base = normalizeBase(import.meta.env.BASE_URL);
const siteOrigin = Astro.site ? Astro.site.origin : 'https://enock-elk.github.io';
const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  ogImage: ogImageProp,
  ogImageWidth = '512',
  ogImageHeight = '512',
  twitterCard = 'summary',
  themeColor = '#1d4ed8',
  forceDark = false,
  forceLight = false,
  bodyClass = '',
  htmlClass = '',
  robots = 'index, follow',
} = Astro.props;

const pathForCanonical = canonicalPath === '/'
  ? base
  : withBase(canonicalPath);
const canonical = new URL(pathForCanonical, Astro.site || siteOrigin).href;
const ogImage = ogImageProp || new URL(withBase('icons/loading-logo.png'), Astro.site || siteOrigin).href;
const resolvedHtmlClass = [forceDark ? 'dark' : '', htmlClass].filter(Boolean).join(' ');
---

<!DOCTYPE html>
<html lang="en" class={resolvedHtmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColor} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:site_name" content="Next Train" />
    <meta property="og:locale" content="en_ZA" />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={withBase('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('icons/icon-192.png')} />
    <link rel="apple-touch-icon" href={withBase('icons/icon-192.png')} />
    {import.meta.env.PROD && <link rel="manifest" href={withBase(MANIFEST_FILENAME)} />}
    <script is:inline define:vars={{ base }}>
      window.__NT_BASE__ = base;
    </script>
    <meta name="application-name" content="Next Train" />
    <meta name="apple-mobile-web-app-title" content="Next Train" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet" />

    <script is:inline define:vars={{ forceDark, forceLight }}>
      try {
        if (forceLight) {
          document.documentElement.classList.remove('dark');
        } else if (forceDark) {
          document.documentElement.classList.add('dark');
        } else {
          let theme = null;
          try { theme = localStorage.getItem('theme'); } catch (e) {}
          const isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (isDark) document.documentElement.classList.add('dark');
          else document.documentElement.classList.remove('dark');
        }
        let pack = null;
        try { pack = localStorage.getItem('colourPack'); } catch (e) {}
        const valid = pack === 'midnight' || pack === 'contrast' || pack === 'classic' || pack === 'signal' || pack === 'ember';
        document.documentElement.setAttribute('data-colour-pack', valid ? pack : 'classic');
        try {
          if (!localStorage.getItem('next_train_device_id')) {
            localStorage.setItem('next_train_device_id', 'usr_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now());
          }
        } catch (e) {}
        // Strip numeric cache-bust ?v=123… only — keep share flags like ?v=g
        var params = new URLSearchParams(window.location.search);
        var vParam = params.get('v');
        if (vParam && /^\d{8,}$/.test(vParam)) {
          params.delete('v');
          var clean = window.location.pathname + (params.toString() ? '?' + params.toString() : '') + window.location.hash;
          window.history.replaceState({}, '', clean);
        }
      } catch (e) {}
    </script>

    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JM5DH6ERVX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      var gaConfig = {};
      var isDevAnalytics = false;
      var userRegion = 'GP';
      try {
        isDevAnalytics = localStorage.getItem('analytics_ignore') === 'true';
        var saved = localStorage.getItem('userRegion');
        if (saved === 'GP' || saved === 'WC' || saved === 'KZN' || saved === 'EC') userRegion = saved;
      } catch(e) {}
      if (isDevAnalytics) gaConfig['traffic_type'] = 'internal';
      // Selected app region (not IP) — keeps SEO pages in the same regional buckets
      gaConfig['user_properties'] = { crm_region: userRegion };
      gtag('config', 'G-JM5DH6ERVX', gaConfig);
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline>
      var blockClarity = false;
      try { blockClarity = localStorage.getItem('analytics_ignore') === 'true'; } catch(e) {}
      if (!blockClarity) {
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          t.crossOrigin="anonymous";
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "v1aj19921i");
      }
    </script>

    <!-- GUARDIAN: Sentry (deferred — SPA parity on secondary pages) -->
    <script is:inline>
      window.addEventListener('load', function () {
        setTimeout(function () {
          window.sentryOnLoad = function () {
            Sentry.init({
              dsn: 'https://ae241b469e4c06ae7644f55c2a796782@o4511038845222912.ingest.us.sentry.io/4511039214518272',
              sampleRate: 0.3,
              ignoreErrors: [
                'ResizeObserver loop limit exceeded',
                'Network request failed',
                'Failed to fetch',
                'Load failed',
                'QuotaExceededError',
                'UnknownError: Connection is closing because of: IO error',
                'Internal error opening backing store',
                'DOMException',
                'TimeoutError',
                'UnknownError',
                'Failed to update a ServiceWorker',
                'AbortError',
                'window.webkit.messageHandlers',
                'Request timeout',
                '/api/webviewClick'
              ]
            });
          };
          var sentryScript = document.createElement('script');
          sentryScript.src = 'https://js.sentry-cdn.com/ae241b469e4c06ae7644f55c2a796782.min.js';
          sentryScript.crossOrigin = 'anonymous';
          sentryScript.async = true;
          document.head.appendChild(sentryScript);
        }, 3500);
      });
    </script>

    <slot name="head" />
  </head>
  <body class:list={['font-[Inter,sans-serif] antialiased text-gray-800 dark:text-gray-200 transition-colors duration-300', bodyClass]}>
    <slot />
  </body>
</html>
