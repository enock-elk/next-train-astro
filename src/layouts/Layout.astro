---
// --- METRORAIL NEXT TRAIN - ASTRO MASTER LAYOUT ---
import '../styles/appearance.css';
import { APP_VERSION, MANIFEST_FILENAME, normalizeBase, withBase } from '../lib/config.js';

const {
  /** Full SEO brand — SPA default. Short "Next Train" stays for PWA homescreen only. */
  title = "Metrorail Next Train | 2026 Train Schedules for South Africa",
  description = "Check live train schedules, download offline timetable images, and check fares for Metrorail South Africa.",
  canonicalPath = "/",
  /** Optional social overrides (SPA used slightly different og/twitter copy on home). */
  ogTitle = null,
  ogDescription = null,
  twitterTitle = null,
  twitterDescription = null,
  /** Home shell: skip full-screen boot gate for returning sessions (map→home, etc.). */
  unlockShellEarly = false,
} = Astro.props;

const base = normalizeBase(import.meta.env.BASE_URL);
const siteOrigin = Astro.site ? Astro.site.origin : "https://enock-elk.github.io";
const pathForCanonical = canonicalPath === "/"
  ? base
  : withBase(canonicalPath);
const canonical = new URL(pathForCanonical, Astro.site || siteOrigin).href;
const ogImage = new URL(withBase('icons/loading-logo.png'), Astro.site || siteOrigin).href;
const resolvedOgTitle = ogTitle || title;
const resolvedOgDescription = ogDescription || description;
const resolvedTwitterTitle = twitterTitle || resolvedOgTitle;
const resolvedTwitterDescription = twitterDescription || resolvedOgDescription;
const labModeBoot = import.meta.env.PUBLIC_LAB_MODE === 'true';
---

<!DOCTYPE html>
<html lang="en" class="dark" data-lab-mode={labModeBoot ? 'true' : 'false'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0, viewport-fit=cover" />
    
    <!-- SEO & Identity — SEO entity = Metrorail Next Train; short name for iOS home screen -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="application-name" content="Metrorail Next Train" />
    <meta name="apple-mobile-web-app-title" content="Next Train" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1d4ed8" />
    <meta name="app-version" content={APP_VERSION} />
    <link rel="icon" href={withBase('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('icons/icon-192.png')} />
    <link rel="apple-touch-icon" href={withBase('icons/icon-192.png')} />
    
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:site_name" content="Metrorail Next Train" />
    <meta property="og:locale" content="en_ZA" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={resolvedTwitterTitle} />
    <meta name="twitter:description" content={resolvedTwitterDescription} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />

    <!-- PWA Manifest — always under base with trailing slash. Dev has no PWA
         plugin output, so linking it there only produces 404 noise. -->
    <!-- Manifest + SW only exist after build (astro preview / deploy). Dev has no SW on purpose. -->
    {import.meta.env.PROD && <link rel="manifest" href={withBase(MANIFEST_FILENAME)} />}
    <!-- Early, HTML-static SW register so PWABuilder HTML-parse + short Puppeteer
         windows can discover /sw.js. Emit URL/scope as string literals (not
         define:vars) so HTML parsers see register('/…/sw.js', …). Update UX
         still uses virtual:pwa-register below. -->
    {import.meta.env.PROD && (
      <script
        is:inline
        set:html={`
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.register('${withBase('sw.js')}', { scope: '${base}' }).catch(function () {});
        }
      `}
      />
    )}
    <!-- Legacy WebView shields (SPA: globalThis + Array/String.at for CleverAds on Chrome 88) -->
    <script is:inline>
      if (typeof globalThis === 'undefined') { window.globalThis = window; }
      (function () {
        function atPolyfill(n) {
          n = Math.trunc(n) || 0;
          if (n < 0) n += this.length;
          if (n < 0 || n >= this.length) return undefined;
          return this[n];
        }
        if (!Array.prototype.at) {
          Object.defineProperty(Array.prototype, 'at', { value: atPolyfill, writable: true, enumerable: false, configurable: true });
        }
        if (!String.prototype.at) {
          Object.defineProperty(String.prototype, 'at', { value: atPolyfill, writable: true, enumerable: false, configurable: true });
        }
      })();
    </script>
    {unlockShellEarly && (
      <>
        <script is:inline>
          // Returning users / same-session navigations (e.g. map.html → home) must not
          // sit behind "Loading schedules…". Decide before first paint.
          (function () {
            try {
              var seen = localStorage.getItem('welcomeSeen') === 'true';
              var warm = sessionStorage.getItem('nt_shell_warm') === '1';
              if (seen || warm) document.documentElement.classList.add('nt-shell-ready');
            } catch (e) {}
          })();
        </script>
        <style is:inline>
          html.nt-shell-ready #loading-overlay { display: none !important; }
          html.nt-shell-ready #main-content.app-shell { visibility: visible !important; }
        </style>
      </>
    )}
    <script is:inline>
      // Capture install prompt as early as the old SPA (before module scripts / SW race)
      window.deferredInstallPrompt = null;
      window.addEventListener('beforeinstallprompt', function (e) {
        e.preventDefault();
        window.deferredInstallPrompt = e;
        window.__ntDeferredInstallPrompt = e;
        console.log('✅ PWA Install Event captured successfully in HEAD.');
        try { window.dispatchEvent(new Event('pwa-install-ready')); } catch (_) {}
      });
    </script>
    <!-- Black Box: capture console into localStorage before app modules boot -->
    <script is:inline>
      (function () {
        var MAX_LOGS = 500;
        var LOG_KEY = 'nt_blackbox_logs';
        function saveLog(type, args) {
          try {
            var msg = Array.prototype.map.call(args, function (a) {
              if (a instanceof Error) return a.message + ' ' + (a.stack || '');
              return typeof a === 'object' ? JSON.stringify(a) : String(a);
            }).join(' ');
            var logs = [];
            try { logs = JSON.parse(localStorage.getItem(LOG_KEY) || '[]'); } catch (e) {}
            logs.push({ t: Date.now(), type: type, msg: msg });
            var cutoff = Date.now() - (72 * 60 * 60 * 1000);
            logs = logs.filter(function (l) { return l.t > cutoff; });
            if (logs.length > MAX_LOGS) logs = logs.slice(logs.length - MAX_LOGS);
            localStorage.setItem(LOG_KEY, JSON.stringify(logs));
          } catch (e) { /* quota / recursion guard */ }
        }
        var origLog = console.log, origWarn = console.warn, origError = console.error;
        console.log = function () { saveLog('LOG', arguments); return origLog.apply(console, arguments); };
        console.warn = function () { saveLog('WARN', arguments); return origWarn.apply(console, arguments); };
        console.error = function () { saveLog('ERROR', arguments); return origError.apply(console, arguments); };
      })();
    </script>
    <script is:inline define:vars={{ base }}>
      window.__NT_BASE__ = base;
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">

    <!-- CRITICAL: GA4 + device identity (SPA-parity — same key, format, uid bridge, user_id) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JM5DH6ERVX" crossorigin="anonymous"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      var gaConfig = {};
      var isDevAnalytics = false;
      var deviceId = null;

      try {
        isDevAnalytics = localStorage.getItem('analytics_ignore') === 'true';

        // SPA Identity Bridge: WebView → Chrome handoff via ?uid=
        var urlParams = new URLSearchParams(window.location.search);
        var transferredUid = urlParams.get('uid');
        var urlDirty = false;
        if (transferredUid) {
          deviceId = transferredUid;
          localStorage.setItem('next_train_device_id', deviceId);
          urlParams.delete('uid');
          urlDirty = true;
        } else {
          deviceId = localStorage.getItem('next_train_device_id');
          if (!deviceId) {
            deviceId = 'usr_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now();
            localStorage.setItem('next_train_device_id', deviceId);
          }
        }
        // Cache-bust (?v=1234567890) only — never strip short share view flags (?v=g / ?v=f)
        var vParam = urlParams.get('v');
        if (vParam && /^\d{8,}$/.test(vParam)) {
          urlParams.delete('v');
          urlDirty = true;
        }
        if (urlDirty) {
          var cleanUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '') + window.location.hash;
          window.history.replaceState({}, '', cleanUrl);
        }
      } catch (e) {}

      if (isDevAnalytics) gaConfig['traffic_type'] = 'internal';
      if (deviceId) gaConfig['user_id'] = deviceId;

      // Selected app region is telemetry truth; IP guess fills userRegion for new users before paint when available
      var userRegion = 'GP';
      try {
        var savedRegion = localStorage.getItem('userRegion');
        if (savedRegion === 'GP' || savedRegion === 'WC' || savedRegion === 'KZN' || savedRegion === 'EC') {
          userRegion = savedRegion;
        }
      } catch (e) {}
      gaConfig['user_properties'] = { crm_region: userRegion, custom_device_id: deviceId };

      gtag('config', 'G-JM5DH6ERVX', gaConfig);
      window.NEXT_TRAIN_DEVICE_ID = deviceId;
      window.__ntCrmRegion = userRegion;
    </script>

    <!-- Clarity — deferred + identify with same device id (SPA Growth Mode) -->
    <script is:inline>
      window.addEventListener('load', function () {
        setTimeout(function () {
          var blockClarity = false;
          try { blockClarity = localStorage.getItem('analytics_ignore') === 'true'; } catch (e) {}
          if (blockClarity) return;
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
            t.crossOrigin = 'anonymous';
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', 'v1aj19921i');
          try {
            var id = window.NEXT_TRAIN_DEVICE_ID || localStorage.getItem('next_train_device_id');
            if (id && typeof clarity === 'function') {
              clarity('identify', id);
              clarity('set', 'custom_id', id);
            }
          } catch (e) {}
        }, 2500);
      });
    </script>

    <!-- GUARDIAN: Sentry (deferred post-Clarity — SPA parity) -->
    <script is:inline>
      window.addEventListener('load', function () {
        setTimeout(function () {
          window.sentryOnLoad = function () {
            Sentry.init({
              dsn: 'https://ae241b469e4c06ae7644f55c2a796782@o4511038845222912.ingest.us.sentry.io/4511039214518272',
              sampleRate: 0.3,
              ignoreErrors: [
                'ResizeObserver loop limit exceeded',
                'Network request failed',
                'Failed to fetch',
                'Load failed',
                'QuotaExceededError',
                'UnknownError: Connection is closing because of: IO error',
                'Internal error opening backing store',
                'DOMException',
                'TimeoutError',
                'UnknownError',
                'Failed to update a ServiceWorker',
                'AbortError',
                'window.webkit.messageHandlers',
                'Request timeout',
                '/api/webviewClick'
              ]
            });
            console.log('🛡️ Guardian: Sentry initialized (Deferred).');
          };
          var sentryScript = document.createElement('script');
          sentryScript.src = 'https://js.sentry-cdn.com/ae241b469e4c06ae7644f55c2a796782.min.js';
          sentryScript.crossOrigin = 'anonymous';
          sentryScript.async = true;
          document.head.appendChild(sentryScript);
        }, 3500);
      });
    </script>

    <!-- 🛡️ GUARDIAN: Inline Pre-Boot Script -->
    <!-- Runs instantly before DOM loads to prevent FOUC (Flash of Unstyled Content) and ensure IDs exist -->
    <script is:inline>
      try {
        // try/catch: Safari Private Mode / locked-down WebViews throw on localStorage
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        const isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');

        // Lab / ?pack=ember: seed Ember (yellow/orange brand) so restored chrome is obvious
        try {
          var params = new URLSearchParams(location.search);
          var packParam = params.get('pack') || params.get('colourPack');
          if (packParam === 'paper') packParam = 'earthy';
          if (packParam === 'ember' || packParam === 'classic' || packParam === 'midnight'
              || packParam === 'contrast' || packParam === 'signal' || packParam === 'earthy') {
            localStorage.setItem('colourPack', packParam);
            localStorage.setItem('ntLabEmberSeededV1', '1');
          }
          var host = String(location.hostname || '').toLowerCase();
          var isLab = document.documentElement.getAttribute('data-lab-mode') === 'true'
            || host === 'lab.nexttrain.co.za' || host.indexOf('lab.') === 0;
          if (isLab && !localStorage.getItem('ntLabEmberSeededV1')) {
            var cur = localStorage.getItem('colourPack');
            if (!cur || cur === 'classic') localStorage.setItem('colourPack', 'ember');
            localStorage.setItem('ntLabEmberSeededV1', '1');
          }
        } catch (e) {}
        var pack = null;
        try { pack = localStorage.getItem('colourPack'); } catch (e) {}
        if (pack === 'paper') { pack = 'earthy'; try { localStorage.setItem('colourPack', 'earthy'); } catch (e) {} }
        var valid = pack === 'midnight' || pack === 'contrast' || pack === 'classic' || pack === 'signal' || pack === 'ember' || pack === 'earthy';
        var fallbackPack = document.documentElement.getAttribute('data-lab-mode') === 'true' ? 'ember' : 'classic';
        document.documentElement.setAttribute('data-colour-pack', valid ? pack : fallbackPack);

        if (!localStorage.getItem('next_train_device_id')) {
          localStorage.setItem('next_train_device_id', 'usr_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now());
        }
      } catch (e) {}
    </script>

    <!-- Global CSS Overrides -->
    <style is:global>
      /* SPA FOUC rule: .hidden must beat utility display:flex on install CTAs */
      .hidden { display: none !important; }

      body { font-family: 'Inter', sans-serif; }
      body.modal-active { overflow: hidden !important; touch-action: none !important; overscroll-behavior: none !important; }
      
      .custom-scrollbar::-webkit-scrollbar { width: 6px; }
      .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
      .custom-scrollbar::-webkit-scrollbar-thumb { background-color: rgba(156, 163, 175, 0.5); border-radius: 20px; }
      .dark .custom-scrollbar::-webkit-scrollbar-thumb { background-color: rgba(75, 85, 99, 0.5); }

      /* Admin custom dropdowns: grow to widest option, never narrower than the trigger */
      #alert-target-list,
      #alert-severity-list,
      #disr-route-list,
      #disr-tier-list,
      #disr-station-a-list,
      #disr-station-b-list,
      #excl-route-list,
      #excl-direction-list {
        width: max-content;
        min-width: 100%;
      }
      
      /* Utilities */
      .animate-fade-in-up { animation: fadeInUp 0.4s ease-out forwards; }
      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* --- TAB & VIEW STYLES (strict clone from old SPA custom.css) --- */
      .tab-btn {
        flex: 1;
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
        text-align: center;
        font-size: 0.875rem;
        font-weight: 700;
        color: #6b7280;
        border-bottom-width: 2px;
        border-color: transparent;
        transition: all 0.2s;
        cursor: pointer;
        background: transparent;
      }
      .dark .tab-btn { color: #9ca3af; }
      /* SPA custom.css parity — not colour-pack tokens */
      .tab-btn.active { color: #2563eb; border-color: #2563eb; }
      .dark .tab-btn.active { color: #60a5fa; border-color: #60a5fa; }
      /* Sliding indicator owns the underline visually */
      .tab-btn, .tab-btn.active { border-bottom-color: transparent !important; }

      .view-section {
        display: none;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.3s ease-out, transform 0.3s ease-out;
      }
      .view-section.active {
        display: block;
        /* Fill leftover shell height so short tabs don't collapse */
        flex: 1 1 auto;
        min-height: 0;
        overflow: visible;
        opacity: 1;
        transform: translateY(0);
      }

      /* Planner: column flex so #planner-spacer can pin Share/Feedback to the shell bottom
         when error cards are short; tall trips still grow the page and scroll normally. */
      #view-trip-planner.view-section.active {
        display: flex;
        flex-direction: column;
        min-height: calc(100dvh - 9.5rem);
      }

      /* Community + Map: flex-fill leftover shell (header / optional top tabs /
         bottom nav are shrink-0 siblings — no magic 11rem viewport math). */
      #view-community.view-section.active,
      #view-map.view-section.active {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
        height: auto;
        max-height: none;
        overflow: hidden;
        padding: 0;
      }
      #view-community .community-pane,
      #view-map .map-tab-pane {
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
      }
      #main-content.app-shell:has(#view-map.active),
      #main-content.app-shell:has(#view-community.active) {
        height: max(600px, calc(100dvh - 2rem));
        max-height: max(600px, calc(100dvh - 2rem));
        overflow: hidden;
      }
      @media (min-width: 640px) {
        #main-content.app-shell:has(#view-map.active),
        #main-content.app-shell:has(#view-community.active) {
          height: max(600px, calc(100dvh - 4rem));
          max-height: max(600px, calc(100dvh - 4rem));
        }
      }

      #view-next-train.view-section.active {
        min-height: calc(100dvh - 9.5rem);
      }
      body.nav-bottom #view-next-train.view-section.active,
      body.nav-bottom #view-trip-planner.view-section.active {
        min-height: calc(100dvh - 11rem);
      }

      /* Travel Day / inline menus must paint below the trigger without clipping */
      .view-section.active.dropdown-escape {
        overflow: visible !important;
      }
      #main-content.app-shell.dropdown-escape {
        overflow: visible !important;
      }

      /* Shell fills the device; flex children (tabs) can stretch into leftover space */
      #main-content.app-shell {
        min-height: max(600px, calc(100dvh - 2rem));
        height: max(600px, calc(100dvh - 2rem));
        max-height: none;
      }
      @media (min-width: 640px) {
        #main-content.app-shell {
          /* body: pt-12 + pb-4 */
          min-height: max(600px, calc(100dvh - 4rem));
          height: max(600px, calc(100dvh - 4rem));
        }
      }
      /* Tall Next Train / Planner content: grow the shell and scroll the page */
      #main-content.app-shell:has(#view-next-train.active),
      #main-content.app-shell:has(#view-trip-planner.active) {
        height: auto;
        min-height: max(600px, calc(100dvh - 2rem));
      }
      @media (min-width: 640px) {
        #main-content.app-shell:has(#view-next-train.active),
        #main-content.app-shell:has(#view-trip-planner.active) {
          min-height: max(600px, calc(100dvh - 4rem));
        }
      }

      #map-modal.full-screen, #about-modal.full-screen, #full-schedule-modal.full-screen {
        padding: 0 !important;
      }
      #map-modal.full-screen > div, #about-modal.full-screen > div, #full-schedule-modal.full-screen > div {
        border-radius: 0 !important;
        max-height: none !important;
      }

      /* SPA custom.css motion primitives */
      @keyframes shake {
        0%, 100% { transform: rotate(0deg); }
        25% { transform: rotate(-10deg); }
        75% { transform: rotate(10deg); }
      }
      @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      @keyframes pop {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.1); }
      }
      @keyframes moveTrain {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
      }
      .animate-shake { animation: shake 0.5s ease-in-out infinite; }
      /* Used by #locate-btn / #reload-btn (live-board.js & logic.js) */
      .spinning { animation: spin 1s linear infinite; }
      .pop-loader { animation: pop 1.5s infinite; }
      .moving-icon { animation: moveTrain 2s linear infinite; }

      /* Modal cards: spring scale open/close (native app feel) */
      [id$="-modal"].fixed > div {
        transition: transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s ease;
      }
      [id$="-modal"].fixed.opacity-0 > div {
        transform: scale(0.95);
      }

      /* Compact header (returning users) — slim WhatsApp-style bar */
      .chrome-compact .app-header,
      body.chrome-compact .app-header {
        padding-top: 0.45rem !important;
        padding-bottom: 0.45rem !important;
      }
      .chrome-compact .header-title,
      body.chrome-compact .header-title {
        font-size: 2rem !important;
        letter-spacing: -0.035em !important;
      }
      .chrome-compact .header-meta #current-day,
      body.chrome-compact .header-meta #current-day {
        font-size: 0.65rem !important;
      }

      #bottom-nav.bottom-nav-bar {
        padding-bottom: max(0.25rem, env(safe-area-inset-bottom, 0px));
      }
      #bottom-nav .bottom-nav-item {
        transition: color 0.15s ease, transform 0.12s ease;
      }
      #bottom-nav .bottom-nav-item:active {
        transform: scale(0.96);
      }
      body.nav-bottom #offline-toast {
        bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
      }

      /* CleverAds containment — never cover welcome / go fullscreen */
      #clever-core {
        max-height: 100px !important;
        overflow: hidden !important;
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
        pointer-events: none;
      }
      #clever-core iframe {
        max-height: 100px !important;
      }
      #clever-core.ad-cloaked {
        transform: translateY(150%) !important;
        pointer-events: none !important;
        opacity: 0;
      }
      .ad-active-padding {
        padding-bottom: 108px !important;
      }
      .view-section {
        transition: padding-bottom 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
    </style>
  </head>

  <body class="bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100 flex items-start justify-center min-h-screen p-2 sm:p-4 pt-4 sm:pt-12 pb-4 transition-colors duration-300">

    <!-- Offline drop-tab lives inside Header (SPA parity). Toast stays page-level. -->

    <!-- GUARDIAN: Lie-Fi / offline transition toast (auto-dismiss) -->
    <div id="offline-toast" class="fixed bottom-4 left-1/2 transform -translate-x-1/2 bg-gray-900/95 dark:bg-gray-800/95 border border-gray-700 dark:border-gray-600 text-white px-4 py-3 rounded-xl shadow-2xl z-[150] transition-all duration-500 translate-y-[150%] opacity-0 flex items-center space-x-3 w-max max-w-[90%] pointer-events-none backdrop-blur-md">
      <span class="text-xl flex-shrink-0 animate-pulse">📡</span>
      <div class="flex flex-col">
        <span class="text-sm font-bold tracking-wide">You are offline.</span>
        <span class="text-[10px] text-gray-300 leading-snug">Pull down to refresh when signal returns.</span>
      </div>
    </div>

    <!-- Page Content Injected Here -->
    <slot />

    <!-- CleverAds host slot (cloaked until safe zone; contained max-height) -->
    <div id="clever-core" class="ad-cloaked fixed bottom-0 left-0 w-full z-[80] flex justify-center items-end" aria-hidden="true"></div>

    <!-- Client-Side Bootstrapper -->
    <script>
      // @ts-nocheck
      import { hydrateStores, $isOffline } from '../store.js';
      import { registerSW } from 'virtual:pwa-register';
      import { bindPwaInstallPrompt } from '../lib/ui.js';
      import { initCleverAds } from '../lib/clever-ads.js';
      import {
        bindAppUpdateLifecycle,
        cleanupLegacySpaShell,
        enforceAppVersion,
        initNetworkStruggleModal,
      } from '../lib/app-update.js';

      // Capture installability before SW registration can race the event
      bindPwaInstallPrompt();

      // 1. Hydrate Nano Stores from LocalStorage
      hydrateStores();

      // 2. React to Offline State changes visually
      $isOffline.subscribe((offline) => {
        const indicator = document.getElementById('offline-indicator');
        if (indicator) indicator.style.display = offline ? 'flex' : 'none';
      });

      // 3. SW update lifecycle immediately (PROD) — do not wait on legacy cleanup.
      // Head also registers /sw.js statically for PWABuilder discovery; Workbox
      // coalesces the same script URL.
      if (import.meta.env.PROD) {
        bindAppUpdateLifecycle(registerSW);
      }

      // 4. Drop legacy SPA worker/caches, then version-enforce + ads
      cleanupLegacySpaShell().finally(() => {
        initNetworkStruggleModal();
        enforceAppVersion();
        initCleverAds();
      });
    </script>
  </body>
</html>