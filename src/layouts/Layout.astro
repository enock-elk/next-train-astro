      /* ]]> */
    </script>
  </head>

  <body class="bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen transition-colors duration-300">

    <!-- Offline drop-tab lives inside Header (SPA parity). Toast stays page-level. -->

    <!-- GUARDIAN: Lie-Fi / offline transition toast (auto-dismiss) -->
    <div id="offline-toast" class="fixed bottom-4 left-1/2 transform -translate-x-1/2 bg-gray-900/95 dark:bg-gray-800/95 border border-gray-700 dark:border-gray-600 text-white px-4 py-3 rounded-xl shadow-2xl z-[150] transition-all duration-500 translate-y-[150%] opacity-0 flex items-center space-x-3 w-max max-w-[90%] pointer-events-none backdrop-blur-md">
      <span class="text-xl flex-shrink-0 animate-pulse">📡</span>
      <div class="flex flex-col">
        <span class="text-sm font-bold tracking-wide">You are offline.</span>
        <span class="text-[10px] text-gray-300 leading-snug">Pull down to refresh when signal returns.</span>
      </div>
    </div>

    <!-- App chrome only. Vendor ad nodes append to body and must not be flex siblings of the board. -->
    <div id="nt-shell" class="flex items-start justify-center min-h-screen p-2 sm:p-4 pt-4 sm:pt-12 pb-4">
      <slot />
    </div>

    <!-- Client-Side Bootstrapper -->
    <script>
      // @ts-nocheck
      import { hydrateStores } from '../store.js';
      import { registerSW } from 'virtual:pwa-register';
      import { bindPwaInstallPrompt } from '../lib/ui.js';
      import { initCleverAds } from '../lib/clever-ads.js';
      import {
        bindAppUpdateLifecycle,
        cleanupLegacySpaShell,
        enforceAppVersion,
        initNetworkStruggleModal,
      } from '../lib/app-update.js';

      // Capture installability before SW registration can race the event
      bindPwaInstallPrompt();

      // 1. Hydrate Nano Stores from LocalStorage
      hydrateStores();

      // 2. React to Offline State changes visually
      // Offline chrome is owned by ui.js (visible + a few seconds without
      // internet). Do not paint WORKING OFFLINE from the raw navigator event —
      // Android fires `offline` when the screen locks.

      // 3. SW update lifecycle immediately (PROD) — do not wait on legacy cleanup.
      // Head also registers /sw.js statically for PWABuilder discovery; Workbox
      // coalesces the same script URL.
      if (import.meta.env.PROD) {
        bindAppUpdateLifecycle(registerSW);
      }

      // 4. Drop legacy SPA worker/caches, then version-enforce + ads
      cleanupLegacySpaShell().finally(() => {
        initNetworkStruggleModal();
        enforceAppVersion();
        initCleverAds();
      });
    </script>
  </body>
</html>