---
/**
 * User-data deletion instructions. Paste this URL into Meta as
 * "User data deletion" / "Callback URL". It is a real HTML page so
 * Facebook's crawler can read it without JavaScript.
 */
import ContentLayout from '../layouts/ContentLayout.astro';
import LegalArticle from '../components/LegalArticle.astro';
import { SUPPORT_EMAIL } from '../lib/config.js';

const title = 'Delete your Next Train account';
const description = 'How to delete a Next Train commuter account and ask us to remove your data.';
const mail = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent('Please delete my Next Train account')}`;
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath="/account-delete.html"
  seoPageType="account_delete"
  bodyClass="bg-[#f2f2f7] dark:bg-black text-gray-900 min-h-screen"
>
  <LegalArticle title="Delete your account">
    <p class="mb-3">You can remove a commuter Next Train account in the app, or by email. We do not need Facebook to finish the request.</p>

    <h2>In the app</h2>
    <ol class="space-y-2 mb-3">
      <li>Open Next Train and tap <strong>Options</strong> (the menu).</li>
      <li>Tap <strong>Account</strong>.</li>
      <li>Tap <strong>Delete account</strong>, then confirm.</li>
    </ol>
    <p class="mb-3">That flags the profile for the operators. You are signed out. The login is removed when they process the request.</p>

    <h2>By email</h2>
    <p class="mb-3">
      Send a message from the email on the account to
      <a href={mail}>{SUPPORT_EMAIL}</a>.
      Write <strong>Please delete my Next Train account</strong> and include the name or Facebook/Google address you used.
    </p>

    <h2>Operator logins</h2>
    <p>The two operator emails that run the service cannot use Delete account in the app. Email the same address if a record must be closed.</p>
  </LegalArticle>
</ContentLayout>
