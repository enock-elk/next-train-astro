---
import ContentLayout from '../../layouts/ContentLayout.astro';
import SeoThemeToggle from '../../components/SeoThemeToggle.astro';
import { withBase } from '../../lib/config.js';
import {
  listSeoCorridors,
  getSeoCorridorBySlug,
  listSeoRegions,
  displayRouteName,
  stationLabel,
  regionName,
} from '../../lib/seo-routes.js';

export function getStaticPaths() {
  return listSeoCorridors().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const entry = getSeoCorridorBySlug(slug);
if (!entry) return Astro.redirect('/routes.html');

const province = regionName(entry.region);
const title = `${entry.label} Train Schedule Today | ${province} Metrorail`;
const description = `${entry.blurb} Check live ${province} Metrorail train times and schedules today offline in Metrorail Next Train.`;
const canonicalPath = `/corridors/${entry.slug}.html`;
const routesIndexHref = withBase('routes.html');
const regionEntry = listSeoRegions().find((r) => r.region === entry.region);
const regionHref = regionEntry ? withBase(`regions/${regionEntry.slug}.html`) : routesIndexHref;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  about: entry.label,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Metrorail Next Train',
    alternateName: 'Next Train',
    url: 'https://nexttrain.co.za/',
  },
};
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  themeColor="#1d4ed8"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <SeoThemeToggle />

  <main class="min-h-screen bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <div class="max-w-2xl mx-auto px-4 py-10 sm:py-14">
      <p class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 mb-3">
        <a href={routesIndexHref} class="hover:underline">Metrorail routes</a>
        <span class="text-slate-400 dark:text-slate-500"> / </span>
        <a href={regionHref} class="hover:underline">{province}</a>
        <span class="text-slate-400 dark:text-slate-500"> / </span>
        {entry.label}
      </p>

      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
        {entry.label} train schedule today
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        {entry.blurb}
      </p>
      <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        Browse routes on this {province} line, then open the live board for today’s departures and the full weekday / Saturday grid.
      </p>

      <section class="mt-10">
        <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">Routes on this line</h2>
        <ul class="space-y-2">
          {entry.routes.map(({ seed, route }) => (
            <li>
              <a
                href={withBase(`routes/${seed.slug}.html`)}
                class="block rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 px-4 py-4 hover:border-blue-500 dark:hover:border-blue-700 transition-colors"
              >
                <span class="block text-base font-bold text-slate-900 dark:text-white">
                  {stationLabel(route.destA)} to {stationLabel(route.destB)}
                </span>
                <span class="block text-sm text-slate-500 dark:text-slate-400 mt-1">{displayRouteName(route)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <a
        href={withBase(`/?rt=${encodeURIComponent(entry.routes[0]?.route.id || '')}`)}
        class="mt-10 flex w-full items-center justify-center rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 transition-colors"
      >
        Open live board
      </a>
      <p class="mt-2 text-center text-[11px] text-slate-500">
        Returning visitors keep their saved region &amp; route.
      </p>
      <p class="mt-6 text-sm text-slate-500 text-center">
        <a href={regionHref} class="text-blue-600 dark:text-blue-400 hover:underline">All {province} routes</a>
        ·
        <a href={withBase('/')} class="text-blue-600 dark:text-blue-400 hover:underline ml-1">Home</a>
      </p>
    </div>
  </main>
</ContentLayout>
