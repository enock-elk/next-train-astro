                                </div>

                                <div class="bg-white dark:bg-gray-900 p-3 rounded-lg border border-gray-200 dark:border-gray-700 mb-3 shadow-sm">
                                    <p class="font-bold text-xs uppercase tracking-wider text-gray-500 mb-2">KwaZulu-Natal:</p>
                                    <ul class="space-y-1 text-sm">
                                        <li><strong>Customer Service desk:</strong> <a href="tel:0318130456" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">031 813 0456</a></li>
                                    </ul>
                                </div>

                                <div class="bg-white dark:bg-gray-900 p-3 rounded-lg border border-gray-200 dark:border-gray-700 mb-3 shadow-sm">
                                    <p class="font-bold text-xs uppercase tracking-wider text-gray-500 mb-2">Eastern Cape:</p>
                                    <ul class="space-y-1 text-sm">
                                        <li><strong>PRASA EC East London:</strong> <a href="tel:0437002030" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">043 700 2030</a></li>
                                        <li><strong>Email:</strong> <a href="mailto:ntombikayise.katsio@prasa.com" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">ntombikayise.katsio@prasa.com</a></li>
