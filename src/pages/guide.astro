---
import ContentLayout from '../layouts/ContentLayout.astro';
import SeoFeaturedRoutes from '../components/SeoFeaturedRoutes.astro';
import { FARE_CONFIG, normalizeBase, withBase } from '../lib/config.js';
import { WC_PUBLIC_HOLIDAYS_PATH } from '../lib/seo-routes.js';

const title = "User Guide & FAQ | Metrorail Next Train (Updated for 2026)";
const description = "Updated for 2026. Learn how to use Metrorail Next Train to find train times near me. Check live timetables, ticket prices, and routes for Pretoria, Johannesburg, Cape Town, Durban, and East London.";
const base = normalizeBase(import.meta.env.BASE_URL);

function zar(n) {
    return `R${Number(n).toFixed(2)}`;
}

const fareRows = [
    { code: 'Z1', label: 'Zone 1' },
    { code: 'Z2', label: 'Zone 2' },
    { code: 'Z3', label: 'Zone 3' },
    { code: 'Z4', label: 'Zone 4' },
].map(({ code, label }) => {
    const prices = FARE_CONFIG.zones_detailed[code];
    return {
        label,
        single: zar(prices.single),
        returnFare: zar(prices.return),
        weeklyMonFri: zar(prices.weekly_mon_fri),
        weeklyMonSat: zar(prices.weekly_mon_sat),
        monthly: zar(prices.monthly),
    };
});

const holidayFaqText =
    "Metrorail generally does not operate train services on Sundays. Public holidays are not always the same as Saturday. In Gauteng, KZN, and Eastern Cape, some holidays follow a Saturday/holiday timetable; others (such as Christmas Day or National Women's Day in 2026) have no service. Western Cape public holidays may use a Public Holiday sheet or the Saturday timetable. PRASA announces which. Check Next Train: https://nexttrain.co.za/regions/western-cape-public-holidays.html. A few routes, including Hercules / Koedoespoort and Eastern Cape, also have no Saturday service. December is different again: most regions use a dedicated scaled-down festive timetable, not the usual weekday, Saturday, or public holiday sheet. That timetable typically starts in the week of the early 20s of December and runs through the first week of January. Next Train does not have the 21 December 2026 to 1 January 2027 sheets yet, and will update the schedules when PRASA releases them. The home board and Trip Planner apply the correct 2026 holiday and route rules for the day you are viewing, including Pick a date in the planner.";

const monthlyTicketFaqText =
    "A monthly ticket bought during the month, for example on the 5th, is valid only for that calendar month. It does not last for the next 30 days. Monthly tickets for the current month stay on sale until about the 10th of that month.";

const festiveFaqText =
    "December schedules are not the usual weekday, Saturday, or public holiday sheets. Most regions have a dedicated scaled-down timetable for the festive season. It typically starts in the week of the early 20s of December and runs through the first week of January. Next Train does not have the 21 December 2026 to 1 January 2027 scaled-down timetables yet. The times published now stay the weekday, Saturday, and public holiday sheets. Next Train will update the schedules when PRASA releases the festive timetable.";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does this app work offline during loadshedding?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Next Train is an Offline-First app. Once you open it with an internet connection, it saves the schedules to your device. You can check times while underground or during loadshedding without using data. Furthermore, Metrorail trains operate on a high-voltage network that is often shielded from municipal loadshedding, though station lighting may be affected."
      }
    },
    {
      "@type": "Question",
      "name": "Do Metrorail trains run on Public Holidays and Sundays?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": holidayFaqText
      }
    },
    {
      "@type": "Question",
      "name": "How long is a Metrorail monthly ticket valid?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": monthlyTicketFaqText
      }
    },
    {
      "@type": "Question",
      "name": "Is there a Metrorail festive season or December scaled-down timetable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": festiveFaqText
      }
    },
    {
      "@type": "Question",
      "name": "How do Metrorail off-peak discounts work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Metrorail offers up to 40% off standard adult fares for off-peak travel on weekdays only, for trains departing strictly between 09:30 AM and 14:30 PM. There is no off-peak discount on weekends or public holidays. The Next Train app calculates this automatically."
      }
    },
    {
      "@type": "Question",
      "name": "Are there Metrorail discounts for students or pensioners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Scholars in uniform get 50% off single and return tickets. A scholar weekly or monthly pass is the same price as the adult pass. Pensioners and Military Veterans receive a flat 50% discount on standard fares. You can select your passenger type in the Next Train app settings to see the correct pricing."
      }
    },
    {
      "@type": "Question",
      "name": "Can I buy Metrorail tickets online or on the app?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Standard Metrorail tickets must be bought in person with cash at the station ticket office. Next Train is a planning tool designed to help you calculate the exact cash fare needed before you leave your house."
      }
    },
    {
      "@type": "Question",
      "name": "Which provinces and stations are supported?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Next Train maps active PRASA corridors in Gauteng (Pretoria, Johannesburg, Germiston, Kempton Park, Mabopane), Western Cape (Cape Town, Bellville, Simon's Town), KwaZulu-Natal (Durban, Umlazi, KwaMashu, Crossmoor), and Eastern Cape (East London)."
      }
    },
    {
      "@type": "Question",
      "name": "How do I download the Metrorail Next Train app?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Next Train installs from nexttrain.co.za. On iPhone, open the site in Safari, tap Share, then Add to Home Screen. On Android, open the site in Chrome and use Install Next Train when it appears. Android is also in Google Play testing."
      }
    }
  ]
};

const iconWave = `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 11c.5-2 1.5-3 3-3s2.5 1 3 3 1.5 3 3 3 2.5-1 3-3M4 14c.4 2.2 2.2 4 5 4h1c2.5 0 4-1.2 5-3"/><circle cx="9" cy="7" r="2.2"/><circle cx="15.5" cy="7.5" r="1.8"/></svg>`;
const iconRoute = `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="19" r="2.5"/><path stroke-linecap="round" d="M8.5 19H15a3 3 0 000-6H9a3 3 0 010-6h6.5"/><circle cx="18" cy="5" r="2.5"/></svg>`;
const iconBook = `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5.5A2.5 2.5 0 016.5 3H20v16.5H6.5A2.5 2.5 0 004 17V5.5z"/><path stroke-linecap="round" d="M8 7h8M8 11h6"/></svg>`;
const iconClock = `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5V12l3 2"/></svg>`;
const iconPhone = `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2"/><path stroke-linecap="round" d="M11 18.5h2"/></svg>`;
const iconFaq = `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path stroke-linecap="round" d="M9.8 9.6a2.4 2.4 0 114.2 1.6c-.7.7-1.5 1.1-1.5 2.3"/><circle cx="12" cy="16.8" r="0.8" fill="currentColor" stroke="none"/></svg>`;
const iconSupport = `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 13v-1a8 8 0 0116 0v1"/><path stroke-linecap="round" stroke-linejoin="round" d="M4 13a2 2 0 002 2h1v-5H6a2 2 0 00-2 2zm16 0a2 2 0 01-2 2h-1v-5h1a2 2 0 012 2z"/><path stroke-linecap="round" d="M18 17v1a3 3 0 01-3 3h-2"/></svg>`;
const iconTrain = `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="3" width="12" height="14" rx="2"/><path stroke-linecap="round" d="M6 12h12M9.5 16.5L8 20m6.5-3.5L16 20"/><circle cx="9" cy="8.5" r="1"/><circle cx="15" cy="8.5" r="1"/></svg>`;
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath="/guide.html"
  ogType="article"
  robots="index, follow"
  bodyClass="bg-slate-50 dark:bg-gray-900 selection:bg-blue-200 selection:text-blue-900"
  trackSeo={false}
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <style slot="head" is:global>
    .prose-custom p { margin-bottom: 1rem; line-height: 1.6; }
    .prose-custom ul { margin-bottom: 1.5rem; list-style-type: disc; padding-left: 1.25rem; }
    .prose-custom li { margin-bottom: 0.5rem; }
    .guide-ui-chip {
      display: inline;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #2563eb;
    }
    .dark .guide-ui-chip { color: #60a5fa; }
    /* Matches full-timetable grid Download control */
    .guide-ui-download {
      display: inline-flex;
      align-items: center;
      gap: 0.3em;
      vertical-align: middle;
      padding: 0.15em 0.45em;
      border-radius: 0.35rem;
      border: 1px solid #e5e7eb;
      background: #f3f4f6;
      color: #374151;
      font-weight: 700;
      font-size: inherit;
      line-height: inherit;
      text-transform: none;
      letter-spacing: normal;
    }
    .guide-ui-download svg {
      width: 0.95em;
      height: 0.95em;
      flex-shrink: 0;
      color: #4b5563;
    }
    .dark .guide-ui-download {
      background: #374151;
      border-color: #4b5563;
      color: #d1d5db;
    }
    .dark .guide-ui-download svg { color: #9ca3af; }
    .guide-ui-pill {
      display: inline-block;
      font-weight: 800;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      font-size: 0.85em;
      line-height: 1.25;
      padding: 0.05em 0.38em;
      border-radius: 0.3rem;
      vertical-align: baseline;
    }
    .guide-section-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      margin-right: 0.75rem;
      flex-shrink: 0;
      border-radius: 0.65rem;
      background: #eff6ff;
      color: #2563eb;
    }
    .dark .guide-section-icon {
      background: rgba(30, 58, 138, 0.45);
      color: #93c5fd;
    }
    .guide-section-icon svg {
      width: 1.15rem;
      height: 1.15rem;
    }
    .guide-inline-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.1em;
      height: 1.1em;
      margin-right: 0.35em;
      vertical-align: -0.15em;
      color: currentColor;
    }
    .guide-inline-icon svg {
      width: 100%;
      height: 100%;
    }
    .guide-sev {
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
    }
    .guide-sev-dot {
      width: 0.65em;
      height: 0.65em;
      border-radius: 9999px;
      flex-shrink: 0;
    }
    .guide-sev-info .guide-sev-dot { background: #3b82f6; }
    .guide-sev-warn .guide-sev-dot { background: #eab308; }
    .guide-sev-crit .guide-sev-dot { background: #ef4444; }
    .guide-ui-pill-direct {
      color: #1d4ed8;
      background: #dbeafe;
      border: 1px solid #93c5fd;
    }
    .dark .guide-ui-pill-direct {
      color: #93c5fd;
      background: rgba(30, 58, 138, 0.35);
      border-color: rgba(96, 165, 250, 0.35);
    }
    .guide-ui-pill-transfer {
      color: #a16207;
      background: #fef9c3;
      border: 1px solid #fde047;
    }
    .dark .guide-ui-pill-transfer {
      color: #fde047;
      background: rgba(113, 63, 18, 0.35);
      border-color: rgba(250, 204, 21, 0.4);
    }
    .guide-ui-pill-warn {
      color: #c2410c;
      background: #ffedd5;
      border: 1px solid #fdba74;
    }
    .dark .guide-ui-pill-warn {
      color: #fdba74;
      background: rgba(124, 45, 18, 0.35);
      border-color: rgba(251, 146, 60, 0.35);
    }
    .guide-ui-pill-danger {
      color: #b91c1c;
      background: #fee2e2;
      border: 1px solid #fca5a5;
    }
    .dark .guide-ui-pill-danger {
      color: #fca5a5;
      background: rgba(127, 29, 29, 0.4);
      border-color: rgba(248, 113, 113, 0.35);
    }
    .guide-ui-pill-muted {
      color: #4b5563;
      background: #e5e7eb;
      border: 1px solid #d1d5db;
    }
    .dark .guide-ui-pill-muted {
      color: #d1d5db;
      background: rgba(55, 65, 81, 0.6);
      border-color: rgba(107, 114, 128, 0.5);
    }
    .animate-fade-in-up { animation: fadeInUp 0.4s ease-out forwards; }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>

<!-- Back Button Overlay — closes in-app sheet when embedded; else goes home -->
    <div class="fixed top-4 left-4 z-50">
        <a id="guide-home-btn" href={base} class="bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-800 dark:text-white font-bold py-2.5 px-4 border border-gray-200 dark:border-gray-700 rounded-xl shadow-lg flex items-center transition-transform transform active:scale-95 text-sm backdrop-blur-md bg-opacity-90 dark:bg-opacity-90">
            <svg class="w-5 h-5 mr-2 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7-7h18"></path></svg>
            Home
        </a>
    </div>
    <script is:inline>
      (function () {
        function inAppSheet() {
          try {
            return !!(window.parent && window.parent !== window && typeof window.parent.__ntCloseInAppSheet === 'function');
          } catch (_) { return false; }
        }
        function pathOf(href) {
          try { return new URL(href, window.location.href).pathname.replace(/\/+$/, '') || '/'; }
          catch (_) { return String(href || ''); }
        }
        // Hide floating Home when the parent sheet already provides Back.
        if (inAppSheet()) {
          var homeWrap = document.getElementById('guide-home-btn')?.parentElement;
          if (homeWrap) homeWrap.classList.add('hidden');
        }
        document.addEventListener('click', function (e) {
          if (!inAppSheet()) return;
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          var href = a.getAttribute('href') || '';
          if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || a.target === '_blank') return;
          var path = pathOf(href);
          var isMap = /\/map\.html?$/i.test(path);
          var isGuide = /\/guide\.html?$/i.test(path);
          var isAppHome = path === '' || path === '/' || /\/index\.html?$/i.test(path)
            || path === String(window.__NT_BASE__ || '/').replace(/\/+$/, '')
            || path === String(window.__NT_BASE__ || '/');
          // Stay inside sheet for map. SEO landings leave the sheet and open
          // the implied /routes|/regions|/corridors page (not the pinned board).
          if (isMap && typeof window.parent.__ntNavigateInAppSheet === 'function') {
            e.preventDefault();
            window.parent.__ntNavigateInAppSheet(href, 'Network Map');
            return;
          }
          if (isGuide) return;
          var isSeoLanding = /\/routes(\/|\.html)/i.test(path) || /\/regions\//i.test(path) || /\/corridors\//i.test(path);
          if (isSeoLanding) {
            e.preventDefault();
            var dest = a.href;
            try {
              if (typeof window.parent.__ntOpenSeoPage === 'function') {
                window.parent.__ntOpenSeoPage(dest);
                return;
              }
            } catch (_) {}
            try { window.parent.location.assign(dest); } catch (_) { window.location.assign(dest); }
            return;
          }
          if (isAppHome || /\/status\.html?/i.test(path)) {
            e.preventDefault();
            window.parent.__ntCloseInAppSheet();
          }
        }, true);
      })();
    </script>

    <!-- Main Content Container -->
    <main class="max-w-3xl mx-auto px-5 pt-24 pb-16">
        
        <!-- Hero Header -->
        <header class="text-center mb-12 animate-fade-in-up">
            <div class="w-20 h-20 bg-white dark:bg-gray-800 rounded-full shadow-xl ring-4 ring-blue-50 dark:ring-gray-700 mx-auto flex items-center justify-center mb-6 p-3">
                <img src={withBase('icons/loading-logo.png')} class="w-full h-full object-contain" alt="Logo">
            </div>
            <h1 class="text-3xl sm:text-4xl font-black text-gray-900 dark:text-white tracking-tight mb-3">Commuter Guide & FAQ</h1>
            <p class="text-gray-500 dark:text-gray-400 text-base sm:text-lg max-w-xl mx-auto">Everything you need to know about how Metrorail Next Train routes your trips, processes data, and keeps you moving.</p>
            <p id="guide-first-visit-hint" class="hidden mt-3 text-xs text-gray-500 dark:text-gray-400 max-w-md mx-auto">
                First time here? The main app will walk you through picking your region - no account needed.
            </p>
        </header>

        <!-- Article Sections -->
        <article class="space-y-12">
            
            <!-- Section 1: Introduction -->
            <section class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center mb-4">
                    <span class="guide-section-icon" set:html={iconWave} />
                    <h2 class="text-xl font-black text-gray-900 dark:text-white">Built by Commuters, for Commuters</h2>
                </div>
                <div class="prose-custom text-sm sm:text-base text-gray-600 dark:text-gray-300">
                    <p>Metrorail Next Train is an <strong>independent, unofficial passion project</strong> and is not affiliated with PRASA (Passenger Rail Agency of South Africa) or Metrorail. I started this in late 2025 as a simple tool to help my own family avoid looking at blurry timetable photos, and it quickly grew into something much bigger.</p>
                    <p>My name is <strong>Enock Kazembe</strong>. I work as an Actuarial Analyst, but building this app is my real passion. I built Next Train to bring clear and reliable train times to the people who need it most. South African commuters deserve tools that just work and make daily travel a little bit easier. This App takes the guesswork out of planning your journey.</p>
                    <p>We are fully live across South Africa's major networks, indexing high-traffic corridors and hubs to help you plan your journey:</p>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-3 mb-4">
                        <li><strong>Gauteng:</strong> Pretoria, Johannesburg, Germiston, Kempton Park, Mabopane, and Saulsville.</li>
                        <li><strong>Western Cape:</strong> Cape Town Central Line, Southern Line (Simon's Town), Northern Line (Bellville), and Cape Flats.</li>
                        <li><strong>KwaZulu-Natal:</strong> Durban Yard, Umlazi, Bridge City / KwaMashu, and Crossmoor.</li>
                        <li><strong>Eastern Cape:</strong> East London and Berlin.</li>
                    </ul>
                    <p>The home board shows the next departure each way from your station, estimated fare for your passenger type, and a full timetable you can download. Shared corridors also list trains from neighbouring routes (for example From De Wildt while you are on Pretoria to Mabopane). Because we rely on crowdsourced data alongside official PRASA releases to keep these timetables accurate, we need your help to spot errors. Commuters can send a delay note, and some testers can share a trip location. Use Feedback in Options when something looks wrong.</p>
                </div>
                <SeoFeaturedRoutes />
            </section>

            <!-- Section 2: How Routing Works & GPS Map -->
            <section class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center mb-4">
                    <span class="guide-section-icon" set:html={iconRoute} />
                    <h2 class="text-xl font-black text-gray-900 dark:text-white">Home board, Map &amp; Locate</h2>
                </div>
                <div class="prose-custom text-sm sm:text-base text-gray-600 dark:text-gray-300">
                    <h3 class="font-bold text-gray-900 dark:text-white mt-4 mb-2">1. Directional naming (for example Next train to Kempton Park)</h3>
                    <p>When the board says <em>Next train to Kempton Park</em>, it is naming the <strong>direction</strong> toward that terminus. If you travel from Pretoria to Centurion, you board that train because Centurion sits on the Pretoria to Kempton Park corridor. Upcoming lists use green <strong>To …</strong> pills for the terminus, and purple <strong>From …</strong> pills when a neighbouring corridor also serves your station.</p>

                    <h3 class="font-bold text-gray-900 dark:text-white mt-6 mb-2">2. Network Map and Locate Me</h3>
                    <p>Open the <strong>Network Map</strong> from Options (or Map when it is available on your build) to see baked rail geometry for your region. On the home board, tap the blue crosshair next to the station picker to find the nearest station across active routes.</p>

                    <h3 class="font-bold text-gray-900 dark:text-white mt-6 mb-2">3. See upcoming trains and Check Tomorrow Schedule</h3>
                    <p>Tap a next-train card to open <strong>See upcoming trains</strong> for the rest of today, including shared-corridor trains. When there is no service today, <strong>Check Tomorrow Schedule</strong> opens the same style of list for the next running day, still including trains from other routes on that corridor.</p>

                    <h3 class="font-bold text-gray-900 dark:text-white mt-6 mb-2">4. Why Trip Planner hides some options</h3>
                    <p>The Trip Planner keeps the strongest options and drops slower ones (Pareto filtering). If Train A needs two transfers and takes three hours, but Train B leaves a little later, is direct, and arrives in one hour, Train A is hidden so you are not offered a worse ride.</p>
                </div>
            </section>

            <!-- Section 2b: Trip Planner -->
            <section class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center mb-4">
                    <span class="guide-section-icon" set:html={iconRoute} />
                    <h2 class="text-xl font-black text-gray-900 dark:text-white">Trip Planner</h2>
                </div>
                <div class="prose-custom text-sm sm:text-base text-gray-600 dark:text-gray-300">
                    <p>Open <strong>Trip Planner</strong> from the bottom navigation. Pick an origin and a destination (any timed stops in the same region). Results show departure, arrival, duration, and whether the trip is direct or needs a transfer.</p>
                    <h3 class="font-bold text-gray-900 dark:text-white mt-6 mb-2">Pick a travel day</h3>
                    <p>Use the day control on the planner to switch Weekday or Saturday, or open <strong>Pick a date</strong> and <strong>Set travel day</strong> for a specific calendar day. Public holidays and routes with no Saturday service follow the same rules as the home board, so Sunday and no-service days stay clear.</p>
                    <h3 class="font-bold text-gray-900 dark:text-white mt-6 mb-2">Reading a result</h3>
                    <ul class="list-disc pl-5 space-y-1 mb-4">
                        <li><span class="guide-ui-pill guide-ui-pill-direct">Direct Trip</span> stays on one train to your destination.</li>
                        <li><span class="guide-ui-pill guide-ui-pill-transfer">Transfer Trip</span> changes trains at a hub (for example Germiston or Koedoespoort).</li>
                        <li>Two or more changes are labelled Trip with 2 changes on the card.</li>
                        <li>Fare on the card uses your current <strong>Passenger Type</strong> from Options (Adult, Scholar, Pensioner, Military Veteran), including off-peak when it applies.</li>
                    </ul>
                    <h3 class="font-bold text-gray-900 dark:text-white mt-6 mb-2">If nothing connects</h3>
                    <p>When the planner cannot link your stops, you will see <strong>No Physical Connection</strong>. If you know a real transfer inside the province, use <strong>Report Missing Route</strong> so we can teach the graph that hub.</p>
                </div>
            </section>

            <!-- Section 3: Step-by-Step Tutorials & Glossary -->
            <section class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center mb-4">
                    <span class="guide-section-icon" set:html={iconBook} />
                    <h2 class="text-xl font-black text-gray-900 dark:text-white">Quick Tutorials & Glossary</h2>
                </div>
                <div class="prose-custom text-sm sm:text-base text-gray-600 dark:text-gray-300">
                    <h3 class="font-bold text-gray-900 dark:text-white mt-4 mb-2">How to Save Timetables for Offline Viewing</h3>
                    <p>You can save an entire day's timetable directly to your phone's gallery as a high-quality image:</p>
                    <ol class="list-decimal pl-5 space-y-1 mb-4">
                        <li>Tap the blue <span class="guide-ui-chip">View Full Timetable</span> control on your dashboard.</li>
                        <li>Select your preferred travel day (Weekday or Saturday) using the top-left dropdown.</li>
                        <li>Tap
                            <span class="guide-ui-download" aria-hidden="true">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                Download
                            </span>.
                            The app saves the timetable sheet as an image on your device.
                        </li>
                    </ol>

                    <h3 class="font-bold text-gray-900 dark:text-white mt-6 mb-2">Glossary of App Terms</h3>
                    <ul class="list-none pl-0 space-y-3 mb-3">
                        <li class="bg-gray-50 dark:bg-gray-900 p-3 rounded-lg border border-gray-100 dark:border-gray-700">
                            <span class="guide-ui-pill guide-ui-pill-direct">Direct Trip</span>
                            <span class="mx-1 text-gray-400">vs</span>
                            <span class="guide-ui-pill guide-ui-pill-transfer">Transfer Trip</span>
                            <span class="block mt-2">A direct trip means you stay on the same train until your destination. A transfer trip means the Trip Planner found a connection: you alight at a hub (like Koedoespoort or Germiston) and board a different line. Two or more connections are labelled Trip with 2 changes. The label on the trip card uses these same colours.</span>
                        </li>
                        <li class="bg-gray-50 dark:bg-gray-900 p-3 rounded-lg border border-gray-100 dark:border-gray-700">
                            <strong class="block mb-2">Service notices:</strong>
                            <ul class="list-none pl-0 space-y-2 mb-2">
                                <li class="guide-sev guide-sev-info"><span class="guide-sev-dot" aria-hidden="true"></span><span><strong>Info</strong> covers general PRASA updates and useful background for the corridor.</span></li>
                                <li class="guide-sev guide-sev-warn"><span class="guide-sev-dot" aria-hidden="true"></span><span><strong>Warning</strong> covers possible delays or interruptions.</span></li>
                                <li class="guide-sev guide-sev-crit"><span class="guide-sev-dot" aria-hidden="true"></span><span><strong>Critical</strong> covers serious updates such as a sinkhole, cancellation, or line severance.</span></li>
                            </ul>
                            <span class="block">When notices are available for your route or region, open them from the bell on the home header.</span>
                        </li>
                        <li class="bg-gray-50 dark:bg-gray-900 p-3 rounded-lg border border-gray-100 dark:border-gray-700">
                            <span class="guide-ui-pill guide-ui-pill-muted">No Svc</span>
                            <span class="block mt-2">If a train is greyed out and marked this way in the full timetable, Metrorail has temporarily cancelled or suspended that train number for the day.</span>
                        </li>
                        <li class="bg-gray-50 dark:bg-gray-900 p-3 rounded-lg border border-gray-100 dark:border-gray-700">
                            <span class="guide-ui-pill guide-ui-pill-danger">Line Severed</span>
                            <span class="block mt-2">A critical alert that the tracks are blocked (e.g. cable theft or a sinkhole). Trains may terminate early, and the Trip Planner will adjust your route when a detour exists.</span>
                        </li>
                        <li class="bg-gray-50 dark:bg-gray-900 p-3 rounded-lg border border-gray-100 dark:border-gray-700">
                            <span class="guide-ui-pill guide-ui-pill-warn">Extended Layover</span>
                            <span class="block mt-2">Shown when a transfer wait is very long (over about four hours). The trip is still listed, but the warning helps you plan around the platform wait.</span>
                        </li>
                    </ul>
                </div>
            </section>

            <!-- Section 4: Extended Layovers -->
            <section class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center mb-4">
                    <span class="guide-section-icon" set:html={iconClock} />
                    <h2 class="text-xl font-black text-gray-900 dark:text-white">Transfers & Extended Layovers</h2>
                </div>
                <div class="prose-custom text-sm sm:text-base text-gray-600 dark:text-gray-300">
                    <p>Our Trip Planner actively calculates multi-leg journeys across shared corridors (e.g., transferring at Germiston or Koedoespoort). However, sparse timetables (especially on weekends or holidays) can result in very long wait times.</p>
                    <p>If a calculated trip requires you to wait at a transfer hub for more than 4 hours for your connecting train, the app will flag this journey with an orange <span class="guide-ui-pill guide-ui-pill-warn">Extended Layover</span> warning. The trip will still be displayed as an option, but this warning ensures you aren't caught off guard by a long wait on the platform.</p>
                </div>
            </section>

            <!-- Section 4: Installation Guide -->
            <section class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center mb-4">
                    <span class="guide-section-icon" set:html={iconPhone} />
                    <h2 class="text-xl font-black text-gray-900 dark:text-white">How to Install Next Train</h2>
                </div>
                <div class="prose-custom text-sm sm:text-base text-gray-600 dark:text-gray-300">
                    <p>Next Train is a lightweight web app you install from the browser, so it stays small on your phone.</p>
                    
                    <h3 class="font-bold text-gray-900 dark:text-white mt-6 mb-2">For iPhone (iOS) Users</h3>
                    <p>Open <strong>nexttrain.co.za</strong> in <strong>Safari</strong>. Tap <strong>Share</strong> (the square with an arrow), then <strong>Add to Home Screen</strong>.</p>
                    
                    <h3 class="font-bold text-gray-900 dark:text-white mt-6 mb-2">For Android Users</h3>
                    <p>In Chrome, look for the green <strong>Install Next Train</strong> control (it may show the download size, for example 1 MB). Tap it to install. If you do not see it, your browser may not support web installs yet. Android is also in Google Play testing.</p>

                    <div class="mt-5 p-4 bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500 rounded-r-lg">
                        <p class="font-bold text-blue-800 dark:text-blue-300 mb-1">Install on your phone</p>
                        <p class="text-blue-700 dark:text-blue-200 opacity-90 mb-0">Next Train installs from this website: Add to Home Screen on iPhone, or Install Next Train on Android. Schedules then work offline after the first load.</p>
                    </div>

                </div>
            </section>

            <!-- Section 6: FAQ Accordions -->
            <section class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 dark:border-gray-700">
                <div class="flex items-center mb-6">
                    <span class="guide-section-icon" set:html={iconFaq} />
                    <h2 class="text-xl font-black text-gray-900 dark:text-white">Frequently Asked Questions</h2>
                </div>
                
                <div class="space-y-4">
                    
                    <details class="group bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300">
                        <summary class="cursor-pointer flex items-center justify-between p-4 font-bold text-gray-900 dark:text-white select-none focus:outline-none hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                            How do I check ticket prices and what are the discounts?
                            <svg class="w-5 h-5 text-gray-400 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </summary>
                        <div class="p-4 pt-1 border-t border-gray-200 dark:border-gray-700 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                            <p>Once you select your origin and destination, an <strong>Estimated Fare</strong> box will appear. Metrorail prices tickets based on distance "Zones" (Zone 1 to 4).</p>
                            
                            <h4 class="font-bold text-gray-900 dark:text-white mt-3 mb-2">Off-Peak & Special Discounts</h4>
                            <ul class="list-disc pl-5 space-y-1 mb-4">
                                <li><strong>Off-Peak Travel:</strong> Adults receive up to <strong>40% off</strong> on <strong>weekdays only</strong>, for trains departing strictly between 09:30 AM and 14:30 PM. No off-peak discount on weekends or public holidays.</li>
                                <li><strong>Special Profiles:</strong> Scholars in uniform get <strong>50% off single and return</strong> tickets. A scholar weekly or monthly pass is the same price as the adult pass. Pensioners and Military Veterans receive a flat <strong>50% discount</strong>. Change <strong>Passenger Type</strong> under Options (or Account when you are signed in). The home Estimated Fare and Ticket Prices sheet update for that session.</li>
                            </ul>

                            <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm mt-3 mb-2">
                                <table class="w-full text-left border-collapse text-xs sm:text-sm">
                                    <thead class="bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-200">
                                        <tr>
                                            <th class="py-2 px-3 border-b dark:border-gray-700 font-bold">Zone</th>
                                            <th class="py-2 px-3 border-b dark:border-gray-700 font-bold">Single</th>
                                            <th class="py-2 px-3 border-b dark:border-gray-700 font-bold">Return</th>
                                            <th class="py-2 px-3 border-b dark:border-gray-700 font-bold">Weekly<br /><span class="font-normal opacity-70">(Mon–Fri)</span></th>
                                            <th class="py-2 px-3 border-b dark:border-gray-700 font-bold">Weekly<br /><span class="font-normal opacity-70">(Mon–Sat)</span></th>
                                            <th class="py-2 px-3 border-b dark:border-gray-700 font-bold">Monthly</th>
                                        </tr>
                                    </thead>
                                    <tbody class="bg-white dark:bg-gray-900 divide-y divide-gray-100 dark:divide-gray-800">
                                        {fareRows.map((row) => (
                                            <tr>
                                                <td class="py-2 px-3 font-medium">{row.label}</td>
                                                <td class="py-2 px-3">{row.single}</td>
                                                <td class="py-2 px-3">{row.returnFare}</td>
                                                <td class="py-2 px-3">{row.weeklyMonFri}</td>
                                                <td class="py-2 px-3">{row.weeklyMonSat}</td>
                                                <td class="py-2 px-3">{row.monthly}</td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                            <p class="text-xs text-gray-500 mt-2"><em>Note: These are the same adult fares the app uses in Ticket Prices. The estimated fare shown for a trip is typically the maximum route cost (terminus-to-terminus). If you are traveling a shorter distance along the line, your actual ticket price at the station may be slightly cheaper. Tickets must be bought at the station.</em></p>
                            <p class="mt-3">A monthly ticket bought during the month, for example on the 5th, is valid only for that calendar month. It does not last for the next 30 days. Monthly tickets for the current month stay on sale until about the 10th of that month.</p>
                        </div>
                    </details>

                    <details class="group bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300">
                        <summary class="cursor-pointer flex items-center justify-between p-4 font-bold text-gray-900 dark:text-white select-none focus:outline-none hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                            Do trains run on Public Holidays or Sundays?
                            <svg class="w-5 h-5 text-gray-400 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </summary>
                        <div class="p-4 pt-1 border-t border-gray-200 dark:border-gray-700 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                            <p>Metrorail generally <strong>does not operate train services on Sundays</strong>.</p>
                            <p class="mt-2"><strong>Public holidays are not always the same as Saturday.</strong> In Gauteng, KZN, and Eastern Cape, some holidays follow a Saturday/holiday timetable; others (such as Christmas Day or National Women's Day in 2026) have <strong>no service</strong>.</p>
                            <p class="mt-2"><strong>Western Cape can use either sheet.</strong> Some holidays follow a dedicated <strong>Public Holiday</strong> timetable; others use the Saturday timetable when PRASA announces it. Check Next Train on the day. See the <a href={withBase(WC_PUBLIC_HOLIDAYS_PATH)} class="text-blue-600 dark:text-blue-400 underline">Western Cape public holiday timetable</a>.</p>
                            <p class="mt-2">A few routes, including Hercules / Koedoespoort and Eastern Cape, also have <strong>no Saturday service</strong> even when other lines are running.</p>
                            <p class="mt-2">You do not need to guess: the home board and Trip Planner apply the correct 2026 holiday and route rules for the day you are viewing, including <strong>Pick a date</strong> in the planner.</p>
                        </div>
                    </details>

                    <details class="group bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300">
                        <summary class="cursor-pointer flex items-center justify-between p-4 font-bold text-gray-900 dark:text-white select-none focus:outline-none hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                            Is there a festive season or December scaled-down timetable?
                            <svg class="w-5 h-5 text-gray-400 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </summary>
                        <div class="p-4 pt-1 border-t border-gray-200 dark:border-gray-700 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                            <p>December schedules are <strong>not</strong> the usual weekday, Saturday, or public holiday sheets. Most regions have a dedicated <strong>scaled-down timetable</strong> for the festive season.</p>
                            <p class="mt-2">That timetable typically starts in the week of the <strong>early 20s of December</strong> and runs through the <strong>first week of January</strong>.</p>
                            <p class="mt-2">Next Train does not have the <strong>21 December 2026 to 1 January 2027</strong> scaled-down timetables yet. The times on each route page stay the published weekday, Saturday, and public holiday sheets. Next Train will update the schedules when PRASA releases the festive timetable.</p>
                        </div>
                    </details>

                    <details class="group bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300">
                        <summary class="cursor-pointer flex items-center justify-between p-4 font-bold text-gray-900 dark:text-white select-none focus:outline-none hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                            How do I download the Metrorail Next Train app?
                            <svg class="w-5 h-5 text-gray-400 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </summary>
                        <div class="p-4 pt-1 border-t border-gray-200 dark:border-gray-700 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                            <p>Next Train installs from <strong>nexttrain.co.za</strong>. On iPhone, open the site in Safari, tap Share, then <strong>Add to Home Screen</strong>. On Android, open the site in Chrome and tap <strong>Install Next Train</strong> when it appears. Android is also in Google Play testing.</p>
                        </div>
                    </details>

                    <details class="group bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300">
                        <summary class="cursor-pointer flex items-center justify-between p-4 font-bold text-gray-900 dark:text-white select-none focus:outline-none hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                            Does the app work offline or during loadshedding?
                            <svg class="w-5 h-5 text-gray-400 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </summary>
                        <div class="p-4 pt-1 border-t border-gray-200 dark:border-gray-700 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                            <p><strong>Yes, Next Train is an Offline-First app.</strong> Once you open it with an internet connection, it saves the schedules directly to your device memory. You can check times while underground or during loadshedding without using any data.</p>
                            <p class="mt-2">Furthermore, Metrorail trains operate on a high-voltage traction network that is often shielded from municipal loadshedding, though station lighting and ticket offices may be affected.</p>
                        </div>
                    </details>

                    <details class="group bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300">
                        <summary class="cursor-pointer flex items-center justify-between p-4 font-bold text-gray-900 dark:text-white select-none focus:outline-none hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                            Why is my route showing "No Physical Connection"?
                            <svg class="w-5 h-5 text-gray-400 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </summary>
                        <div class="p-4 pt-1 border-t border-gray-200 dark:border-gray-700 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                            <p>If the Trip Planner fails to find a route, it means our system currently doesn't have a known transfer hub connecting your Origin and Destination (e.g., trying to route from Pretoria directly to Cape Town). If you know a valid transfer route within your province, please hit the <strong>Report Missing Route</strong> button to let us know!</p>
                        </div>
                    </details>
                    
                    <details class="group bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300">
                        <summary class="cursor-pointer flex items-center justify-between p-4 font-bold text-gray-900 dark:text-white select-none focus:outline-none hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                            I spotted an incorrect train time. How do I report it?
                            <svg class="w-5 h-5 text-gray-400 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </summary>
                        <div class="p-4 pt-1 border-t border-gray-200 dark:border-gray-700 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                            <p>Because we crowdsource our data alongside official PRASA releases, occasional changes happen! If you spot a train that is consistently early, late, or cancelled, tap the <strong>Feedback</strong> button in the app. We urgently and gladly fix all reported errors to keep the community moving.</p>
                        </div>
                    </details>

                    <!-- NEW: CONTACT SUPPORT ACCORDION -->
                    <details class="group bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-all duration-300">
                        <summary class="cursor-pointer flex items-center justify-between p-4 font-bold text-gray-900 dark:text-white select-none focus:outline-none hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                            How do I contact Metrorail or the App Developer?
                            <svg class="w-5 h-5 text-gray-400 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </summary>
