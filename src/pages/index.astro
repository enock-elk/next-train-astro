---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sidenav from '../components/Sidenav.astro';
import LiveBoard from '../components/LiveBoard.astro';
import TripPlanner from '../components/TripPlanner.astro';
import WelcomeModal from '../components/WelcomeModal.astro';
import PlannerModals from '../components/PlannerModals.astro';
import LiveBoardModals from '../components/LiveBoardModals.astro';
import HubModals from '../components/HubModals.astro';
---

<Layout title="Next Train | Live Schedules">
    
    <!-- SIDENAV / SETTINGS HUB -->
    <Sidenav />

    <!-- WELCOME MODAL COMPONENT -->
    <WelcomeModal />

    <!-- Planner / shared modals (help, disruption, map lightbox, legal, toast) -->
    <PlannerModals />

    <!-- Live board modals (route selector, schedule list, profile) -->
    <LiveBoardModals />

    <!-- Hub + admin modals (feedback, about, notices, login, dev panel) -->
    <HubModals />

    <!-- MAIN APP — grows with content; page scrolls as needed -->
    <main id="main-content" class="w-full max-w-md mx-auto bg-white dark:bg-gray-800 rounded-lg shadow-2xl overflow-hidden relative flex flex-col border border-gray-200 dark:border-gray-700">
        
        <Header />

        <div id="app-top-tabs" class="shrink-0 flex border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 relative z-20" role="tablist" aria-label="Primary">
            <button id="tab-next-train" class="tab-btn active" type="button" role="tab" aria-selected="true">
                Next Train
            </button>
            <button id="tab-trip-planner" class="tab-btn" type="button" role="tab" aria-selected="false">
                Trip Planner
            </button>
            <div id="tab-sliding-indicator" class="absolute bottom-0 h-0.5 bg-blue-600 dark:bg-blue-400 transition-all duration-300 ease-out z-10 w-1/2 left-0"></div>
        </div>

        <div id="developer-reply-banner" class="hidden bg-gray-900 dark:bg-black text-white w-full shadow-md z-20 shrink-0 relative transition-all duration-300">
            <div class="flex items-center justify-between p-3 px-4">
                <div class="flex items-center space-x-3 min-w-0">
                    <svg class="w-6 h-6 flex-shrink-0 animate-bounce text-gray-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500">Admin Message</span>
                        <span class="text-sm font-bold truncate">You have a new message!</span>
                    </div>
                </div>
                <button id="view-reply-btn" class="flex-shrink-0 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-700 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors shadow-sm focus:outline-none">Read</button>
            </div>
        </div>

        <LiveBoard />
        <TripPlanner />

        <nav id="bottom-nav" class="hidden shrink-0 border-t border-gray-200 dark:border-gray-700 bg-white/95 dark:bg-gray-900/95 backdrop-blur-md z-40 bottom-nav-bar" aria-label="Primary" aria-hidden="true">
            <div class="grid grid-cols-4 gap-0 max-w-md mx-auto">
                <button type="button" id="bottom-nav-home" data-bottom-nav="home" class="bottom-nav-item is-active flex flex-col items-center justify-center pt-2 pb-1.5 px-0.5 text-blue-600 dark:text-blue-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500" aria-label="Home — live board" aria-current="page">
                    <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z"></path></svg>
                    <span class="text-[9px] font-bold tracking-wide leading-tight text-center">Home</span>
                </button>
                <button type="button" id="bottom-nav-plan" data-bottom-nav="plan" class="bottom-nav-item flex flex-col items-center justify-center pt-2 pb-1.5 px-0.5 text-gray-400 dark:text-gray-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500" aria-label="Plan — trip planner" aria-current="false">
                    <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
                    <span class="text-[9px] font-bold tracking-wide leading-tight text-center">Plan</span>
                </button>
                <button type="button" id="bottom-nav-community" data-bottom-nav="community" class="bottom-nav-item flex flex-col items-center justify-center pt-2 pb-1.5 px-0.5 text-gray-400 dark:text-gray-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500" aria-label="Community — route feed" aria-current="false">
                    <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a2 2 0 01-2-2v-1"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v3l3.5-3H15a2 2 0 002-2V4a2 2 0 00-2-2z"></path></svg>
                    <span class="text-[9px] font-bold tracking-wide leading-tight text-center">Community</span>
                </button>
                <button type="button" id="bottom-nav-more" data-bottom-nav="more" class="bottom-nav-item flex flex-col items-center justify-center pt-2 pb-1.5 px-0.5 text-gray-400 dark:text-gray-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500" aria-label="More — Settings">
                    <svg class="w-5 h-5 mb-0.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="5" r="1.75"></circle>
                        <circle cx="12" cy="12" r="1.75"></circle>
                        <circle cx="12" cy="19" r="1.75"></circle>
                    </svg>
                    <span class="text-[9px] font-bold tracking-wide leading-tight text-center">More</span>
                </button>
            </div>
        </nav>

    </main>

</Layout>

<script>
    // @ts-nocheck
    import { loadAllSchedules, startClock, currentTime, currentDayType } from '../lib/logic.js';
    import { $currentRouteId, $userRegion, hydrateStores } from '../store.js';
    import { ROUTES } from '../lib/config.js';
    import { safeStorage } from '../lib/utils.js';
    import { initPlanner } from '../lib/planner-ui.js';
    import '../lib/renderer.js';
    import { initLiveBoardUi } from '../lib/live-board-ui.js';
    import { initHub, checkServiceAlerts } from '../lib/hub.js';
    import { initAdminBridge } from '../lib/admin-bridge.js';
    import {
        switchTab,
        initTabIndicator,
        setupSwipeNavigation,
        bindPlannerShellModals,
        openLegal
    } from '../lib/ui.js';
    import { hydratePrefs } from '../lib/prefs.js';

    window.openLegal = openLegal;

    const syncClockShims = () => {
        window.currentTime = currentTime;
        window.currentDayType = currentDayType;
    };

    hydrateStores();
    hydratePrefs();
    startClock();
    syncClockShims();
    setInterval(syncClockShims, 1000);

    initTabIndicator();
    setupSwipeNavigation();

    document.getElementById('tab-next-train')?.addEventListener('click', () => switchTab('next-train'));
    document.getElementById('tab-trip-planner')?.addEventListener('click', () => switchTab('trip-planner'));

    document.getElementById('bottom-nav-home')?.addEventListener('click', () => {
        window.triggerHaptic?.();
        switchTab('next-train');
    });
    document.getElementById('bottom-nav-plan')?.addEventListener('click', () => {
        window.triggerHaptic?.();
        switchTab('trip-planner');
    });
    document.getElementById('bottom-nav-community')?.addEventListener('click', () => {
        window.triggerHaptic?.();
        if (typeof window.syncBottomNavActive === 'function') window.syncBottomNavActive('community');
        if (typeof window.openRouteCommunity === 'function') {
            window.openRouteCommunity();
        } else {
            import('../lib/community.js').then((m) => m.openRouteCommunity()).catch(() => {});
        }
    });
    document.getElementById('bottom-nav-more')?.addEventListener('click', () => {
        window.triggerHaptic?.();
        window.openAppHub?.();
    });

    const hash = location.hash;
    if (hash === '#planner' || hash === '#planner-results') {
        switchTab('trip-planner');
    } else if (hash === '#map') {
        switchTab('next-train');
        setTimeout(() => window.openSmoothModal?.('map-modal'), 300);
    } else {
        const lastTab = safeStorage.getItem('activeTab');
        switchTab(lastTab === 'trip-planner' ? 'trip-planner' : 'next-train');
    }

    bindPlannerShellModals();
    initLiveBoardUi();
    initPlanner();
    initHub();
    initAdminBridge();

    const igniteDataEngine = async () => {
        const welcomeSeen = safeStorage.getItem('welcomeSeen') === 'true';
        if (!welcomeSeen) {
            console.log("🛡️ Guardian: New session detected. Postponing automatic schedule downloads until welcome configuration completes.");
            return;
        }

        const region = $userRegion.get() || 'GP';
        let savedDefault = safeStorage.getItem('defaultRoute_' + region);
        
        if (!savedDefault || !ROUTES[savedDefault] || ROUTES[savedDefault].region !== region) {
            const regionRoutes = Object.values(ROUTES).filter(r => r.region === region && r.isActive && r.id !== 'special_event');
            if (regionRoutes.length > 0) {
                savedDefault = regionRoutes[0].id;
                safeStorage.setItem('defaultRoute_' + region, savedDefault);
            }
        }

        if (savedDefault) {
            $currentRouteId.set(savedDefault);
            console.log("🛡️ Guardian: Igniting Data Engine...");
            await loadAllSchedules(true);
            checkServiceAlerts();
        }
    };

    igniteDataEngine();
</script>
