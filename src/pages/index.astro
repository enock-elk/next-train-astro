---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sidenav from '../components/Sidenav.astro';
import LiveBoard from '../components/LiveBoard.astro';
import TripPlanner from '../components/TripPlanner.astro';
import CommunityView from '../components/CommunityView.astro';
import WelcomeModal from '../components/WelcomeModal.astro';
import PlannerModals from '../components/PlannerModals.astro';
import LiveBoardModals from '../components/LiveBoardModals.astro';
import HubModals from '../components/HubModals.astro';
import { APP_VERSION, withBase } from '../lib/config.js';

/** SPA-parity homepage SEO (full brand). Short "Next Train" remains PWA homescreen only. */
const pageTitle = 'Metrorail Next Train | 2026 Train Schedules for South Africa';
const pageDescription =
  'Check live train schedules, download offline timetable images, and check fares for Metrorail South Africa.';
const ogTitle = 'Metrorail Next Train | 2026 Updated Schedules';
const ogDescription =
  'Stop guessing. Get accurate train times, ticket prices, and updates for Gauteng, Cape Town, KZN, and Eastern Cape. Download timetables and plan your trip offline!';
const twitterDescription =
  'Live Metrorail schedules for Gauteng and Western Cape. Download timetables and plan your trip offline.';

const softwareAppLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Metrorail Next Train',
  operatingSystem: 'Web, iOS, Android',
  applicationCategory: 'TravelApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'ZAR' },
  description:
    'Live Metrorail schedules and route maps for Gauteng (Pretoria, Johannesburg), Western Cape (Cape Town), KZN, and Eastern Cape. Download timetable images for offline use.',
  softwareVersion: APP_VERSION,
  featureList:
    'Offline Access, Full Timetable, Fare Calculator, Trip Planner, Network Map, Download Timetable Images',
  url: 'https://nexttrain.co.za/',
};

const webSiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Metrorail Next Train',
  url: 'https://nexttrain.co.za/',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://nexttrain.co.za/?route={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does this app work offline?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes! Once you open the app while connected to the internet, it saves the schedules to your device. You can check times while underground or during loadshedding without using data.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are you expanding to other provinces?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Absolutely. We cover Gauteng, Western Cape, KwaZulu-Natal, and Eastern Cape. We track demand, so be sure to vote for your region in the App Hub!',
      },
    },
    {
      '@type': 'Question',
      name: 'How can I help improve the app?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'As a crowdsourced tool, we rely on commuters like you. If you notice a missing train, or if you have a photo of a new timetable at your local station, please use the Feedback button in the app to send it to us so we can update the database.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why is my route showing "No Physical Connection"?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'If the Trip Planner fails to find a route, it means our system currently doesn\'t have a known transfer hub connecting your Origin and Destination. If you know a valid transfer route, please hit the "Report Missing Route" button to let us know!',
      },
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  twitterTitle={ogTitle}
  twitterDescription={twitterDescription}
  unlockShellEarly={true}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(softwareAppLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(webSiteLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    
    <!-- SIDENAV / SETTINGS HUB -->
    <Sidenav />

    <!-- WELCOME MODAL COMPONENT -->
    <WelcomeModal />

    <!-- Planner / shared modals (help, disruption, map lightbox, legal, toast) -->
    <PlannerModals />

    <!-- Live board modals (route selector, schedule list, profile) -->
    <LiveBoardModals />

    <!-- Hub + admin modals (feedback, about, notices, login, dev panel) -->
    <HubModals />

    <!-- Cold-boot only: returning sessions skip via html.nt-shell-ready (Layout head). -->
    <div id="loading-overlay" class="fixed inset-0 z-[90] flex flex-col items-center justify-center bg-gray-100 dark:bg-gray-900">
        <img
            src={withBase('icons/loading-logo-splash.webp')}
            alt=""
            class="w-16 h-16 mb-4 animate-pulse"
            width="64"
            height="64"
            fetchpriority="high"
            decoding="async"
        />
        <p class="text-xs font-bold uppercase tracking-widest text-gray-400">Starting Next Train…</p>
        <a
            href={withBase('help.html') + '?reason=boot'}
            class="absolute bottom-8 left-1/2 -translate-x-1/2 text-xs font-bold text-slate-500 underline underline-offset-2"
            data-nt-help-escape="1"
        >App stuck? Get help</a>
    </div>

    <!-- MAIN APP — fills device height; active tab expands into remaining space -->
    <main id="main-content" class="app-shell w-full max-w-md mx-auto bg-white dark:bg-gray-800 rounded-lg shadow-2xl overflow-hidden relative flex flex-col border border-gray-200 dark:border-gray-700" style="visibility: hidden;">
        
        <Header />

        <!-- SPA surface: Next Train + Trip Planner only (Community stays in DOM for later, off chrome) -->
        <div id="app-top-tabs" class="shrink-0 flex border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 sticky top-0 z-30 relative" role="tablist" aria-label="Primary">
            <button id="tab-next-train" class="tab-btn active" type="button" role="tab" aria-selected="true">
                Next Train
            </button>
            <button id="tab-trip-planner" class="tab-btn" type="button" role="tab" aria-selected="false">
                Trip Planner
            </button>
            <button id="tab-community" class="hidden" type="button" tabindex="-1" aria-hidden="true" aria-selected="false">
                Community
                <span id="community-unread-badge-top" class="hidden">0</span>
            </button>
            <div id="tab-sliding-indicator" class="absolute bottom-0 h-0.5 bg-blue-600 dark:bg-blue-400 transition-all duration-300 ease-out z-10 w-1/2 left-0"></div>
        </div>

        <div id="developer-reply-banner" class="hidden bg-gray-900 dark:bg-black text-white w-full shadow-md z-20 shrink-0 relative transition-all duration-300">
            <div class="flex items-center justify-between p-3 px-4">
                <div class="flex items-center space-x-3 min-w-0">
                    <svg class="w-6 h-6 flex-shrink-0 animate-bounce text-gray-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500">Admin Message</span>
                        <span class="text-sm font-bold truncate">You have a new message!</span>
                    </div>
                </div>
                <button id="view-reply-btn" class="flex-shrink-0 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-700 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors shadow-sm focus:outline-none">Read</button>
            </div>
        </div>

        <LiveBoard />
        <TripPlanner />
        <CommunityView />

        <nav id="bottom-nav" class="hidden shrink-0 border-t border-gray-200 dark:border-gray-700 bg-white/95 dark:bg-gray-900/95 backdrop-blur-md z-40 bottom-nav-bar" aria-label="Primary" aria-hidden="true">
            <div class="grid grid-cols-4 gap-0 max-w-md mx-auto">
                <button type="button" id="bottom-nav-home" data-bottom-nav="home" class="bottom-nav-item is-active flex flex-col items-center justify-center pt-3 pb-2.5 px-0.5 min-h-[3.75rem] text-blue-600 dark:text-blue-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500" aria-label="Next Train: live board" aria-current="page">
                    <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z"></path></svg>
                    <span class="text-[10px] sm:text-[11px] font-bold tracking-tight leading-tight text-center">Next Train</span>
                </button>
                <button type="button" id="bottom-nav-plan" data-bottom-nav="plan" class="bottom-nav-item flex flex-col items-center justify-center pt-3 pb-2.5 px-0.5 min-h-[3.75rem] text-gray-400 dark:text-gray-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500" aria-label="Trip Planner" aria-current="false">
                    <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
                    <span class="text-[10px] sm:text-[11px] font-bold tracking-tight leading-tight text-center">Trip Planner</span>
                </button>
                <button type="button" id="bottom-nav-community" data-bottom-nav="community" class="bottom-nav-item flex flex-col items-center justify-center pt-3 pb-2.5 px-0.5 min-h-[3.75rem] text-gray-400 dark:text-gray-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500" aria-label="Community: route feed" aria-current="false">
                    <span class="relative inline-flex mb-1">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a2 2 0 01-2-2v-1"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v3l3.5-3H15a2 2 0 002-2V4a2 2 0 00-2-2z"></path></svg>
                        <span id="community-unread-badge" class="hidden absolute -top-1.5 -right-2.5 min-w-[1.1rem] h-[1.1rem] px-1 flex items-center justify-center rounded-full bg-red-500 text-white text-[9px] font-black leading-none shadow-sm ring-2 ring-white dark:ring-gray-900">0</span>
                    </span>
                    <span class="text-[10px] sm:text-[11px] font-bold tracking-tight leading-tight text-center">Community</span>
                </button>
                <button type="button" id="bottom-nav-more" data-bottom-nav="more" class="bottom-nav-item flex flex-col items-center justify-center pt-3 pb-2.5 px-0.5 min-h-[3.75rem] text-gray-400 dark:text-gray-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500" aria-label="More: Settings">
                    <svg class="w-6 h-6 mb-1" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="5" r="2"></circle>
                        <circle cx="12" cy="12" r="2"></circle>
                        <circle cx="12" cy="19" r="2"></circle>
                    </svg>
                    <span class="text-[10px] sm:text-[11px] font-bold tracking-tight leading-tight text-center">More</span>
                </button>
            </div>
        </nav>

    </main>

</Layout>

<script>
    // @ts-nocheck
    import { loadAllSchedules, startClock, currentTime, currentDayType, syncRegionDisplayDom, ensureReachabilityProbed } from '../lib/logic.js';
    import { $currentRouteId, $userRegion, hydrateStores } from '../store.js';
    import { ROUTES, withBase } from '../lib/config.js';
    import { safeStorage } from '../lib/utils.js';

    const revealAppShell = () => {
        const main = document.getElementById('main-content');
        const overlay = document.getElementById('loading-overlay');
        if (main) main.style.visibility = '';
        if (overlay) overlay.style.display = 'none';
        try { document.documentElement.classList.add('nt-shell-ready'); } catch (e) {}
        try { sessionStorage.setItem('nt_shell_warm', '1'); } catch (e) {}
    };
    // Fix loader image base path for GitHub Pages preview (small WebP for cold-boot LCP)
    const loaderImg = document.querySelector('#loading-overlay img');
    if (loaderImg) loaderImg.setAttribute('src', withBase('icons/loading-logo-splash.webp'));

    // Paint header + tabs + board shell for 2 frames before dropping the logo overlay
    // (avoids the “Next Train / Loading… + pure white” flash on slow devices).
    requestAnimationFrame(() => {
        requestAnimationFrame(() => {
            revealAppShell();
        });
    });
    setTimeout(revealAppShell, 700);

    // Early reachability probe — radio up ≠ usable internet
    try { ensureReachabilityProbed(); } catch (e) { /* ignore */ }

    import { initPlanner, applyPlannerDeepLink } from '../lib/planner-ui.js';
    import '../lib/renderer.js';
    import { initLiveBoardUi, applyRouteDeepLink, openRegionRoutePicker } from '../lib/live-board-ui.js';
    import { initHub, checkServiceAlerts } from '../lib/hub.js';
    import {
        switchTab,
        initTabIndicator,
        setupSwipeNavigation,
        bindPlannerShellModals,
        openLegal,
        bindMaintenanceBanner
    } from '../lib/ui.js';
    import { hydratePrefs, syncCrmRegionAnalytics } from '../lib/prefs.js';
    import {
        prepareDeeplinkIntents,
        consumeHashDeeplinks,
        applyPlannerShortcutDeepLink,
        applyShareTargetDeepLink,
        flushPendingDeeplinkIntents,
        applyMapDeepLink
    } from '../lib/deeplink.js';
    import { setupBlackBoxLogger } from '../lib/blackbox.js';
    import { initRecoveryWatchdog } from '../lib/recovery.js';

    window.openLegal = openLegal;
    initRecoveryWatchdog();
    // Empathy modal "Try Again" (and admin) can call this before/without bridge
    window.loadAllSchedules = loadAllSchedules;
    prepareDeeplinkIntents();

    const syncClockShims = () => {
        window.currentTime = currentTime;
        window.currentDayType = currentDayType;
    };

    hydrateStores();
    // Align sidenav + route-modal region labels with hydrated localStorage region
    syncRegionDisplayDom($userRegion.get() || 'GP');
    syncCrmRegionAnalytics($userRegion.get() || 'GP');
    hydratePrefs();
    startClock();
    syncClockShims();
    setInterval(syncClockShims, 1000);

    initTabIndicator();
    setupSwipeNavigation();

    document.getElementById('tab-next-train')?.addEventListener('click', () => switchTab('next-train'));
    document.getElementById('tab-trip-planner')?.addEventListener('click', () => switchTab('trip-planner'));
    document.getElementById('tab-community')?.addEventListener('click', () => switchTab('community'));

    document.getElementById('bottom-nav-home')?.addEventListener('click', () => {
        window.triggerHaptic?.();
        switchTab('next-train');
    });
    document.getElementById('bottom-nav-plan')?.addEventListener('click', () => {
        window.triggerHaptic?.();
        switchTab('trip-planner');
    });
    document.getElementById('bottom-nav-community')?.addEventListener('click', () => {
        window.triggerHaptic?.();
        switchTab('community');
    });
    document.getElementById('bottom-nav-more')?.addEventListener('click', () => {
        window.triggerHaptic?.();
        window.openAppHub?.();
    });

    const hash = location.hash;
    if (hash === '#planner' || hash === '#planner-results') {
        switchTab('trip-planner');
    } else if (hash === '#community') {
        switchTab('community');
    } else if (hash === '#map') {
        switchTab('next-train');
        setTimeout(() => window.openSmoothModal?.('map-modal'), 300);
    } else {
        const lastTab = safeStorage.getItem('activeTab');
        if (lastTab === 'trip-planner') switchTab('trip-planner');
        else if (lastTab === 'community') switchTab('community');
        else switchTab('next-train');
    }

    bindPlannerShellModals();
    bindMaintenanceBanner();
    initLiveBoardUi();
    initPlanner();
    initHub();
    // Admin + Firebase SDK stay off the critical home chunk (CWV / SW precache).
    import('../lib/admin-bridge.js')
        .then(({ initAdminBridge }) => initAdminBridge())
        .catch((e) => console.warn('🛡️ Guardian: Admin bridge deferred load failed', e));
    setupBlackBoxLogger();

    // Legal docs don't need schedules — open as soon as the shell is ready
    const bootHash = location.hash || '';
    if (
        safeStorage.getItem('welcomeSeen') === 'true' &&
        (bootHash === '#privacy' || bootHash === '#terms' || bootHash === '#legal')
    ) {
        consumeHashDeeplinks().catch(() => {});
    }

    window.revealAppShell = revealAppShell;

    const igniteDataEngine = async () => {
        // Shell is already visible — schedules hydrate in the background.
        revealAppShell();
        try {
            if (await applyRouteDeepLink()) {
                checkServiceAlerts();
                await flushPendingDeeplinkIntents();
                if (location.hash === '#fare') await consumeHashDeeplinks();
                return;
            }

            if (await applyPlannerDeepLink()) {
                checkServiceAlerts();
                await flushPendingDeeplinkIntents();
                return;
            }

            if (await applyMapDeepLink()) {
                checkServiceAlerts();
                await flushPendingDeeplinkIntents();
                return;
            }

            if (await applyPlannerShortcutDeepLink()) {
                checkServiceAlerts();
                await flushPendingDeeplinkIntents();
                return;
            }

            if (await applyShareTargetDeepLink()) {
                checkServiceAlerts();
                await flushPendingDeeplinkIntents();
                return;
            }

            const welcomeSeen = safeStorage.getItem('welcomeSeen') === 'true';
            if (!welcomeSeen) {
                console.log("🛡️ Guardian: New session detected. Postponing automatic schedule downloads until welcome configuration completes.");
                return;
            }

            const region = $userRegion.get() || 'GP';
            let savedDefault = safeStorage.getItem('defaultRoute_' + region);

            // Pre-region SPA installs stored a single unsuffixed key; adopt it once.
            if (!savedDefault) {
                const legacyDefault = safeStorage.getItem('defaultRoute');
                if (legacyDefault && ROUTES[legacyDefault] && ROUTES[legacyDefault].region === region) {
                    savedDefault = legacyDefault;
                    safeStorage.setItem('defaultRoute_' + region, legacyDefault);
                    safeStorage.removeItem('defaultRoute');
                }
            }

            const pinnedOk = !!(
                savedDefault &&
                ROUTES[savedDefault] &&
                ROUTES[savedDefault].region === region &&
                ROUTES[savedDefault].isActive
            );

            if (pinnedOk) {
                $currentRouteId.set(savedDefault);
                console.log("🛡️ Guardian: Igniting Data Engine (background)…");
                // Do not await — poor networks must not block chrome / map→home return.
                loadAllSchedules(false)
                    .then(async () => {
                        checkServiceAlerts();
                        await flushPendingDeeplinkIntents();
                        if (location.hash === '#fare') await consumeHashDeeplinks();
                    })
                    .catch((e) => console.warn('🛡️ Guardian: Background schedule load failed', e));
            } else {
                // Unpin / no default: never invent first-in-list as pinned.
                // Open this region's route picker so the user chooses.
                openRegionRoutePicker();
            }
        } finally {
            revealAppShell();
        }
    };

    igniteDataEngine();
</script>
