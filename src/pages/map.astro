---
import ContentLayout from '../layouts/ContentLayout.astro';
import { ROUTES, REGIONS, PIPELINE_SOURCES, DYNAMIC_BASE_URL, APP_VERSION, REGION_SEO, normalizeBase, withBase } from '../lib/config.js';

const title = 'Metrorail Network Map: Active Routes | Metrorail Next Train';
const description = 'Interactive Metrorail network map for Gauteng, Western Cape, KZN, and Eastern Cape. View active train routes, stations, and live service disruptions.';
const base = normalizeBase(import.meta.env.BASE_URL);
const regionSeoSlugs = Object.fromEntries(
  Object.entries(REGION_SEO).map(([code, meta]) => [code, meta.slug])
);
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath="/map.html"
  ogType="website"
  robots="index, follow"
  bodyClass="bg-gray-100 dark:bg-gray-900 m-0 p-0 overflow-hidden h-full"
  htmlClass="h-full"
>
  <link slot="head" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <!-- Paint map shell before CSS/JS — prevents white flash in the sidenav iframe. -->
  <script slot="head" is:inline>
    (function () {
      try {
        var dark = document.documentElement.classList.contains('dark');
        var bg = dark ? '#111827' : '#f3f4f6';
        document.documentElement.style.backgroundColor = bg;
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      } catch (e) {}
    })();
  </script>
  <style slot="head" is:global>
      html, body { height: 100%; margin: 0; padding: 0; overflow: hidden; background-color: #f3f4f6; }
      html.dark, html.dark body { background-color: #111827; }
      #map { height: 100%; min-height: 100vh; width: 100%; z-index: 1; position: absolute; top: 0; left: 0; background-color: #f3f4f6; }
      html.dark #map { background-color: #111827; }
      /* Iframe Map tab: fill the parent pane (100vh inside a short iframe clips/shrinks). */
      html.nt-map-embedded #map { height: 100%; min-height: 100%; }
      #map-top-controls {
        position: fixed; top: 12px; right: 12px; z-index: 1001;
        display: flex; align-items: flex-start; gap: 0.375rem;
        pointer-events: none;
      }
      html.nt-map-embedded #map-top-controls {
        top: max(0.5rem, env(safe-area-inset-top, 0px));
        right: 12px;
      }
      html.nt-map-embedded #map-back-wrap { display: none !important; }
      /* Parent Map tab toolbar already has Contribute — keep Locate FAB only. */
      html.nt-map-embedded #custom-share-location-btn { display: none !important; }
      .map-chrome-btn {
        pointer-events: auto;
        width: 2.25rem; height: 2.25rem;
        display: inline-flex; align-items: center; justify-content: center;
        background: #fff; border-radius: 0.65rem;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
        border: 1px solid #d1d5db; color: #4b5563;
        transition: background-color 0.15s ease;
        flex-shrink: 0;
      }
      .dark .map-chrome-btn {
        background: #1f2937; border-color: #4b5563; color: #d1d5db;
      }
      .map-chrome-btn:hover { background: #f9fafb; }
      .dark .map-chrome-btn:hover { background: #374151; }
      /* Back = same height as GP/theme chrome, inverted fill vs theme */
      .map-back-btn {
        pointer-events: auto;
        height: 2.25rem;
        min-height: 2.25rem;
        padding: 0 0.55rem;
        display: inline-flex; align-items: center; justify-content: center; gap: 0.25rem;
        border-radius: 0.65rem;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
        font-size: 11px; font-weight: 800; line-height: 1;
        transition: background-color 0.15s ease, transform 0.1s ease;
        /* Light theme: chrome is white → Back is dark */
        background: #111827; border: 1px solid #111827; color: #f9fafb;
      }
      .map-back-btn:hover { background: #1f2937; }
      .map-back-btn:active { transform: scale(0.95); }
      /* Dark theme: chrome is dark → Back is white */
      .dark .map-back-btn {
        background: #ffffff; border-color: #e5e7eb; color: #111827;
      }
      .dark .map-back-btn:hover { background: #f3f4f6; }
      .map-back-btn svg { width: 0.9rem; height: 0.9rem; flex-shrink: 0; }
      .region-picker, .legend-container {
        position: relative; pointer-events: auto;
      }
      .legend-container { display: none; }
      .region-panel, .legend-panel {
        display: none;
        position: absolute; top: calc(100% + 0.4rem);
        /* Prefer left-align so badges stay on-screen; clamp width to viewport */
        left: 0; right: auto;
        width: min(220px, calc(100vw - 1.5rem));
        max-width: calc(100vw - 1.5rem);
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        border-radius: 0.75rem; padding: 0.5rem;
        font-family: 'Inter', sans-serif; color: #1f2937;
        border: 1px solid #e5e7eb;
        max-height: min(60vh, 420px); overflow-y: auto;
        box-sizing: border-box;
        z-index: 1100;
      }
      /* Network lines sits further right — keep its menu right-aligned */
      .legend-panel { left: auto; right: 0; width: min(250px, calc(100vw - 1.5rem)); padding: 0.75rem; }
      /* Fixed fallback when JS clamps — keeps badges inside the visual viewport */
      .region-panel.is-viewport-clamped {
        position: fixed;
        top: auto;
        margin: 0;
      }
      .dark .region-panel, .dark .legend-panel {
        background: rgba(31, 41, 55, 0.96); color: #f3f4f6; border-color: #374151;
      }
      .region-picker.is-open .region-panel,
      .legend-container.is-open .legend-panel { display: block; }
      .region-option {
        display: flex; align-items: center; gap: 0.5rem;
        width: 100%; text-align: left;
        padding: 0.55rem 0.65rem; border-radius: 0.5rem;
        font-size: 12px; font-weight: 700; color: inherit;
        background: transparent; border: 0; cursor: pointer;
      }
      .region-option:hover { background: rgba(59, 130, 246, 0.12); }
      .region-option.is-active { background: rgba(37, 99, 235, 0.16); color: #1d4ed8; }
      .dark .region-option.is-active { color: #93c5fd; }
      .region-code {
        display: inline-flex; align-items: center; justify-content: center;
        width: 1.75rem; height: 1.75rem; border-radius: 0.4rem;
        font-size: 10px; font-weight: 900; letter-spacing: 0.04em;
        background: #eff6ff; color: #1d4ed8; flex-shrink: 0;
      }
      .dark .region-code { background: #1e3a8a; color: #bfdbfe; }
      .legend-item { display: flex; align-items: center; margin-bottom: 6px; font-size: 11px; font-weight: 600; }
      .legend-item:last-child { margin-bottom: 0; }
      .color-dot { width: 12px; height: 12px; border-radius: 50%; margin-right: 8px; flex-shrink: 0; }
      .status-badge { font-size: 9px; padding: 2px 6px; border-radius: 4px; margin-left: auto; font-weight: 800; color: white; text-transform: uppercase; }
      .legend-chevron { transition: transform 0.2s ease; }
      .legend-container.is-open .legend-chevron { transform: rotate(180deg); }
      #map-placeholder {
        position: absolute; inset: 0; background-color: #f3f4f6;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        z-index: 50; transition: opacity 0.5s ease;
      }
      html.dark #map-placeholder { background-color: #111827; }
      .gps-pulse {
        width: 16px; height: 16px; background: #3b82f6; border-radius: 50%;
        box-shadow: 0 0 0 rgba(59, 130, 246, 0.4); animation: pulse 2s infinite; border: 3px solid white;
      }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7); }
        70% { box-shadow: 0 0 0 15px rgba(59, 130, 246, 0); }
        100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
      }
      .custom-div-icon { background: transparent; border: none; }
      .dark .leaflet-tile-pane {
        filter: invert(100%) hue-rotate(180deg) brightness(95%) contrast(90%);
      }
      .tooltip-dynamic {
        transition: opacity 0.3s ease, font-size 0.2s ease;
        font-family: 'Inter', sans-serif; opacity: 0;
      }
      .leaflet-tooltip.tooltip-halo {
        background: transparent !important; border: none !important; box-shadow: none !important;
        white-space: nowrap; color: #1f2937;
        text-shadow: -1.5px -1.5px 0 #ffffff, 1.5px -1.5px 0 #ffffff, -1.5px 1.5px 0 #ffffff, 1.5px 1.5px 0 #ffffff;
      }
      .dark .leaflet-tooltip.tooltip-halo {
        color: #ffffff !important;
        text-shadow: -1px -1px 0 rgba(0,0,0,0.8), 1px -1px 0 rgba(0,0,0,0.8), -1px 1px 0 rgba(0,0,0,0.8), 1px 1px 0 rgba(0,0,0,0.8), 0 0 8px rgba(0,0,0,0.9) !important;
      }
      .leaflet-tooltip.tooltip-halo::before { display: none !important; }
      .disruption-line-overlay { animation: dashPulse 1.5s linear infinite; }
      @keyframes dashPulse { to { stroke-dashoffset: -22; } }
      .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
      }
  </style>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Metrorail Next Train Network Map",
    "url": "https://nexttrain.co.za/map.html",
    "applicationCategory": "TravelApplication",
    "operatingSystem": "Any",
    "description": description,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "ZAR" }
  })} />

  <h1 class="sr-only">Interactive Metrorail Network Map</h1>
  <noscript>
    <div class="p-6 max-w-lg mx-auto text-center text-gray-800">
      <p class="font-bold mb-2">Metrorail network map</p>
      <p class="text-sm mb-4">Enable JavaScript to explore the interactive map, or open the main app for live train times.</p>
      <p class="text-sm">
        <a href={base}>Open Next Train</a>
        ·
        <a href={withBase('guide.html')}>Commuter guide</a>
      </p>
    </div>
  </noscript>

  <div id="map-back-wrap" class="fixed top-3 left-3 z-[1001]">
    <a id="map-back-link" href={base} class="map-back-btn" aria-label="Back to Next Train">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Back
    </a>
  </div>

  <div id="map-placeholder" data-nosnippet aria-hidden="true">
    <div class="text-center p-6">
      <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900/50 rounded-full flex items-center justify-center mx-auto mb-4 shadow-inner">
        <svg class="w-8 h-8 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0121 18.382V7.618a1 1 0 01-1.447-.894L15 7m0 13V7"></path></svg>
      </div>
      <h3 class="text-xl font-black text-gray-900 dark:text-white mb-2 tracking-tight">Loading Network...</h3>
      <svg class="animate-spin h-6 w-6 text-blue-600 dark:text-blue-400 mx-auto mt-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-4 font-mono">Syncing Regional Data & Live Status...</p>
    </div>
  </div>

  <div id="empty-map-warning" data-nosnippet aria-hidden="true" class="hidden absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-[1000] bg-white dark:bg-gray-800 p-6 rounded-xl shadow-2xl text-center border border-gray-200 dark:border-gray-700 max-w-[80%] w-full sm:max-w-sm">
    <span class="text-4xl mb-3 block">🗺️</span>
    <h3 class="font-black text-gray-900 dark:text-white text-lg leading-tight mb-2">Interactive Map in Progress</h3>
    <p class="text-gray-500 dark:text-gray-400 text-sm font-medium mb-4">GPS coordinates for this region are currently being mapped. Please use the Static Map view in the meantime.</p>
    <a href={base} class="inline-block bg-blue-600 text-white font-bold py-2.5 px-6 rounded-lg shadow-md hover:bg-blue-700 transition w-full">Go Back</a>
  </div>

  <div id="map-cold-start" data-nosnippet class="hidden absolute inset-0 z-[60] flex items-center justify-center p-4 bg-gray-100/95 dark:bg-gray-900/95">
    <div class="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 max-w-sm w-full text-center">
      <span class="text-4xl mb-3 block">📡</span>
      <h3 class="font-black text-gray-900 dark:text-white text-lg mb-2">Couldn't load map data</h3>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">New here? Pick a region or open the main app to download schedules first. The map works without a prior visit when you're online.</p>
      <div class="grid grid-cols-2 gap-2 mb-4" id="map-region-picker">
        <button type="button" data-region="GP" class="py-2 px-3 rounded-lg bg-blue-600 text-white text-xs font-bold hover:bg-blue-700">Gauteng</button>
        <button type="button" data-region="WC" class="py-2 px-3 rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white text-xs font-bold hover:bg-gray-200 dark:hover:bg-gray-600">Western Cape</button>
        <button type="button" data-region="KZN" class="py-2 px-3 rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white text-xs font-bold hover:bg-gray-200 dark:hover:bg-gray-600">KZN</button>
        <button type="button" data-region="EC" class="py-2 px-3 rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white text-xs font-bold hover:bg-gray-200 dark:hover:bg-gray-600">Eastern Cape</button>
      </div>
      <a href={base} class="inline-block w-full bg-blue-600 text-white font-bold py-2.5 px-6 rounded-lg shadow-md hover:bg-blue-700 transition mb-2">Open Next Train</a>
      <button type="button" id="map-retry-btn" class="w-full text-sm font-bold text-blue-600 dark:text-blue-400 py-2">Retry</button>
    </div>
  </div>

  <!-- Order: Back (left) · Region · Theme · Network Lines -->
  <div id="map-top-controls" class="pointer-events-none">
    <div class="region-picker" id="region-picker">
      <button type="button" id="region-toggle-btn" class="map-chrome-btn font-black text-[11px] tracking-wide text-blue-700 dark:text-blue-300" aria-expanded="false" aria-controls="region-panel" aria-label="Change map region">
        <span id="region-toggle-label">GP</span>
      </button>
      <div id="region-panel" class="region-panel" role="menu" aria-label="Map regions">
        <button type="button" class="region-option" data-region="GP" role="menuitem"><span class="region-code">GP</span><span>Gauteng</span></button>
        <button type="button" class="region-option" data-region="WC" role="menuitem"><span class="region-code">WC</span><span>Western Cape</span></button>
        <button type="button" class="region-option" data-region="KZN" role="menuitem"><span class="region-code">KZN</span><span>KwaZulu-Natal</span></button>
        <button type="button" class="region-option" data-region="EC" role="menuitem"><span class="region-code">EC</span><span>Eastern Cape</span></button>
      </div>
    </div>
    <button id="custom-theme-btn" type="button" class="map-chrome-btn text-amber-500" aria-label="Toggle theme">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    </button>
    <div class="legend-container" id="legend-container">
      <button type="button" id="legend-toggle-btn" onclick="toggleLegend()" class="h-9 inline-flex items-center gap-1.5 px-2.5 bg-white dark:bg-gray-800 rounded-[0.65rem] shadow-lg border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors focus:outline-none pointer-events-auto" aria-expanded="false" aria-controls="legend-panel">
        <span class="font-black text-[10px] uppercase tracking-widest whitespace-nowrap">Network Lines</span>
        <svg id="legend-icon" class="legend-chevron w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </button>
      <div id="legend-panel" class="legend-panel" role="region" aria-label="Network lines legend">
        <div id="legend-content" class="legend-content"></div>
      </div>
    </div>
  </div>

  <div class="fixed bottom-6 right-4 z-[1000] pointer-events-none flex flex-col items-end gap-2">
    <button id="custom-share-location-btn" type="button" class="h-12 px-3.5 flex items-center justify-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-full shadow-lg border border-blue-700/40 hover:scale-105 transition-transform pointer-events-auto text-xs font-bold focus:outline-none" aria-label="Contribute location for a train">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
      Contribute
    </button>
    <button id="custom-locate-btn" type="button" class="w-14 h-14 flex items-center justify-center bg-white dark:bg-gray-800 rounded-full shadow-lg border border-gray-300 dark:border-gray-600 hover:scale-105 transition-transform pointer-events-auto text-gray-400 focus:outline-none" aria-label="Locate me">
      <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="18" y2="12"/><line x1="6" y1="12" x2="2" y2="12"/><line x1="12" y1="6" x2="12" y2="2"/><line x1="12" y1="22" x2="12" y2="18"/></svg>
    </button>
  </div>

  <div id="map" role="application" aria-label="Metrorail network map"></div>

  <script is:inline define:vars={{ ROUTES, REGIONS, PIPELINE_SOURCES, DYNAMIC_BASE_URL, APP_VERSION, APP_BASE: base, REGION_SEO_SLUGS: regionSeoSlugs }}>
    window.ROUTES = ROUTES;
    window.REGIONS = REGIONS;
    window.PIPELINE_SOURCES = PIPELINE_SOURCES;
    window.DYNAMIC_BASE_URL = DYNAMIC_BASE_URL;
    window.APP_VERSION = APP_VERSION;
    window.APP_BASE = APP_BASE;
    window.REGION_SEO_SLUGS = REGION_SEO_SLUGS;
  </script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script is:inline src={`${withBase('js/map-app.js')}?v=${APP_VERSION}`}></script>
  <script is:inline>
    (function () {
      function inAppSheet() {
        try {
          return !!(window.parent && window.parent !== window && typeof window.parent.__ntCloseInAppSheet === 'function');
        } catch (_) { return false; }
      }
      function inMapTab() {
        try {
          if (new URLSearchParams(location.search).get('embed') === '1') return true;
          return !!(window.parent && window.parent !== window && window.parent.__ntMapTabEmbed);
        } catch (_) { return false; }
      }
      // Parent sheet / Map tab already has chrome — hide Back.
      if (inAppSheet() || inMapTab()) {
        document.documentElement.classList.add('nt-map-embedded');
        document.getElementById('map-back-wrap')?.classList.add('hidden');
        if (inAppSheet()) {
          try { window.parent.__ntNavigateInAppSheet?.(null, 'Network Map'); } catch (_) {}
        }
      }
      document.addEventListener('click', function (e) {
        if (!inAppSheet()) return;
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a) return;
        var href = a.getAttribute('href') || '';
        if (!href || href.startsWith('#') || a.target === '_blank') return;
        var path = '';
        try { path = new URL(href, window.location.href).pathname; } catch (_) { path = href; }
        var isHome = href === '/' || href === './' || /index\.html?$/i.test(path)
          || path.replace(/\/+$/, '') === String(window.APP_BASE || '/').replace(/\/+$/, '');
        var isGuide = /\/guide\.html?$/i.test(path);
        if (isGuide && typeof window.parent.__ntNavigateInAppSheet === 'function') {
          e.preventDefault();
          window.parent.__ntNavigateInAppSheet(href, 'Commuter Guide');
          return;
        }
        if (isHome || /\/routes(\/|\.html)/i.test(path)) {
          e.preventDefault();
          window.parent.__ntCloseInAppSheet();
        }
      }, true);
    })();
  </script>
</ContentLayout>
