---
/**
 * Public Privacy Policy. Facebook, Google, and Meta fetch this file as HTML.
 * They never see a hash. Do not point those consoles at /#privacy.
 */
import ContentLayout from '../layouts/ContentLayout.astro';
import LegalArticle from '../components/LegalArticle.astro';
import { LEGAL_TEXTS } from '../lib/config.js';

const title = 'Privacy Policy | Next Train';
const description = 'How Next Train handles optional accounts, location on your device, analytics, and POPIA deletion requests.';
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath="/privacy.html"
  seoPageType="privacy"
  bodyClass="bg-[#f2f2f7] dark:bg-black text-gray-900 min-h-screen"
>
  <LegalArticle title="Privacy Policy">
    <div set:html={LEGAL_TEXTS.privacy} />
  </LegalArticle>
</ContentLayout>
