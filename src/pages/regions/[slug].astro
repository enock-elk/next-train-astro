---
import ContentLayout from '../../layouts/ContentLayout.astro';
import SeoThemeToggle from '../../components/SeoThemeToggle.astro';
import { withBase } from '../../lib/config.js';
import {
  listSeoRegions,
  getSeoRegionBySlug,
  displayRouteName,
  stationLabel,
  getCorridorLabel,
} from '../../lib/seo-routes.js';

export function getStaticPaths() {
  return listSeoRegions().map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const entry = getSeoRegionBySlug(slug);
if (!entry) return Astro.redirect('/routes.html');

const title = entry.pageTitle;
const description = `${entry.blurb} Browse corridor pages, view the regional network map, and open today’s live board.`;
const canonicalPath = `/regions/${entry.slug}.html`;
const routesIndexHref = withBase('routes.html');
const guideHref = withBase('guide.html');
const mapHref = withBase(`map.html?region=${encodeURIComponent(entry.region)}`);
const REGION_MAP_IMAGES = {
  GP: 'images/network-map.png',
  WC: 'images/network-map_wc.png',
  KZN: 'images/network-map_kzn.png',
  EC: 'images/network-map_ec.png',
};
const mapImageSrc = withBase(REGION_MAP_IMAGES[entry.region] || REGION_MAP_IMAGES.GP);

const popularRoutes = entry.routes.slice(0, 6);
const otherRegions = listSeoRegions().filter((r) => r.slug !== entry.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Metrorail Next Train',
    alternateName: 'Next Train',
    url: 'https://nexttrain.co.za/',
  },
};
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  themeColor="#1d4ed8"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <SeoThemeToggle />

  <main class="min-h-screen bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <div class="max-w-2xl mx-auto px-4 py-10 sm:py-14">
      <p class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 mb-3">
        <a href={routesIndexHref} class="hover:underline">Metrorail routes</a>
        <span class="text-slate-400 dark:text-slate-500"> / </span>
        {entry.regionLabel}
      </p>

      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
        {entry.h1}
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        {entry.blurb}
      </p>
      <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        Check {entry.cityFocus} Metrorail train times and schedules today without a PDF — pick a route below or open the live board for weekday, Saturday and public-holiday sheets.
      </p>

      <section class="mt-8 rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 px-4 py-4">
        <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-2">
          How to check today’s schedule
        </h2>
        <ol class="list-decimal list-inside space-y-1.5 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          <li>Choose your corridor or origin–destination route.</li>
          <li>Open the live board for next departures and the full timetable grid.</li>
          <li>Confirm weekday vs Saturday / holiday day type before you travel.</li>
        </ol>
        <p class="mt-3 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Metrorail generally does not run on Sundays. Public holidays may follow a Saturday sheet or have no service — always confirm in Next Train.
        </p>
      </section>

      <section class="mt-8">
        <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">
          {entry.regionLabel} network map
        </h2>
        <a
          href={mapHref}
          class="block group rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 hover:border-blue-500 dark:hover:border-blue-700 transition-colors"
        >
          <img
            src={mapImageSrc}
            alt={`${entry.regionLabel} Metrorail network map`}
            class="w-full h-auto object-cover bg-slate-100 dark:bg-slate-900 aspect-[3/2]"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="1200"
            height="800"
          />
          <div class="px-4 py-3 flex items-center justify-between gap-3">
            <span class="text-sm font-bold text-slate-900 dark:text-white">
              Open interactive map · {entry.region}
            </span>
            <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 group-hover:underline">
              Explore
            </span>
          </div>
        </a>
        <p class="mt-2 text-[11px] text-slate-500">
          Live routes, stations, and disruptions for {entry.regionLabel}.
        </p>
      </section>

      {popularRoutes.length > 0 && (
        <section class="mt-10">
          <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">
            Popular routes · schedules today
          </h2>
          <ul class="space-y-2">
            {popularRoutes.map(({ seed, route }) => (
              <li>
                <a
                  href={withBase(`routes/${seed.slug}.html`)}
                  class="block rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 px-4 py-4 hover:border-blue-500 dark:hover:border-blue-700 transition-colors"
                >
                  <span class="block text-base font-bold text-slate-900 dark:text-white">
                    {stationLabel(route.destA)} to {stationLabel(route.destB)} train schedule today
                  </span>
                  <span class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mt-1">
                    {getCorridorLabel(route) || displayRouteName(route)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {entry.corridors.length > 0 && (
        <section class="mt-10">
          <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">Lines & corridors</h2>
          <ul class="space-y-2">
            {entry.corridors.map((c) => (
              <li>
                <a
                  href={withBase(`corridors/${c.slug}.html`)}
                  class="block rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 px-4 py-4 hover:border-blue-500 dark:hover:border-blue-700 transition-colors"
                >
                  <span class="block text-base font-bold text-slate-900 dark:text-white">{c.label}</span>
                  <span class="block text-sm text-slate-500 dark:text-slate-400 mt-1">{c.routes.length} route{c.routes.length === 1 ? '' : 's'}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="mt-10">
        <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">All routes in {entry.regionLabel}</h2>
        <ul class="space-y-2">
          {entry.routes.map(({ seed, route }) => (
            <li>
              <a
                href={withBase(`routes/${seed.slug}.html`)}
                class="block rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 px-4 py-4 hover:border-blue-500 dark:hover:border-blue-700 transition-colors"
              >
                <span class="block text-base font-bold text-slate-900 dark:text-white">
                  {stationLabel(route.destA)} to {stationLabel(route.destB)}
                </span>
                <span class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mt-1">
                  {getCorridorLabel(route) || displayRouteName(route)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {otherRegions.length > 0 && (
        <section class="mt-10">
          <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">
            Other provinces
          </h2>
          <ul class="flex flex-wrap gap-2">
            {otherRegions.map((r) => (
              <li>
                <a
                  href={withBase(`regions/${r.slug}.html`)}
                  class="inline-block rounded-lg border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 px-3 py-2 text-sm font-semibold text-blue-700 dark:text-blue-300 hover:border-blue-500 dark:hover:border-blue-700 transition-colors"
                >
                  {r.cityFocus} train times
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="mt-10 grid gap-2 sm:grid-cols-2">
        <a
          href={mapHref}
          class="flex w-full items-center justify-center rounded-xl border border-blue-600 text-blue-700 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-blue-950/40 font-bold py-3.5 transition-colors"
        >
          Interactive map · {entry.region}
        </a>
        <a
          href={withBase(`/?region=${encodeURIComponent(entry.region)}`)}
          class="flex w-full items-center justify-center rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 transition-colors"
        >
          Open Next Train · {entry.regionLabel}
        </a>
      </div>
      <p class="mt-2 text-center text-[11px] text-slate-500">
        First visit suggests {entry.regionLabel}. Returning visitors keep their saved setup.
      </p>
      <p class="mt-6 text-sm text-slate-500 text-center">
        <a href={guideHref} class="text-blue-600 dark:text-blue-400 hover:underline">User guide</a>
        ·
        <a href={withBase('/')} class="text-blue-600 dark:text-blue-400 hover:underline ml-1">Home</a>
      </p>
    </div>
  </main>
</ContentLayout>
