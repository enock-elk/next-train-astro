---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { withBase } from '../../lib/config.js';
import {
  listSeoRegions,
  getSeoRegionBySlug,
  displayRouteName,
  stationLabel,
  getCorridorLabel,
} from '../../lib/seo-routes.js';

export function getStaticPaths() {
  return listSeoRegions().map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const entry = getSeoRegionBySlug(slug);
if (!entry) return Astro.redirect('/routes.html');

const title = `${entry.title} Timetables | Next Train`;
const description = `${entry.blurb} Browse corridor pages and open the live Next Train board.`;
const canonicalPath = `/regions/${entry.slug}.html`;
const routesIndexHref = withBase('routes.html');
const guideHref = withBase('guide.html');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  isPartOf: { '@type': 'WebSite', name: 'Next Train', url: 'https://nexttrain.co.za/' },
};
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  themeColor="#1d4ed8"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <main class="min-h-screen bg-slate-950 text-slate-100">
    <div class="max-w-2xl mx-auto px-4 py-10 sm:py-14">
      <p class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-3">
        <a href={routesIndexHref} class="hover:underline">Metrorail routes</a>
        <span class="text-slate-500"> / </span>
        {entry.regionLabel}
      </p>

      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-white leading-tight">
        {entry.title}
      </h1>
      <p class="mt-3 text-base text-slate-300 leading-relaxed">
        {entry.blurb}
      </p>

      {entry.corridors.length > 0 && (
        <section class="mt-10">
          <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">Lines & corridors</h2>
          <ul class="space-y-2">
            {entry.corridors.map((c) => (
              <li>
                <a
                  href={withBase(`corridors/${c.slug}.html`)}
                  class="block rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-4 hover:border-blue-700 transition-colors"
                >
                  <span class="block text-base font-bold text-white">{c.label}</span>
                  <span class="block text-sm text-slate-400 mt-1">{c.routes.length} route{c.routes.length === 1 ? '' : 's'}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="mt-10">
        <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">All routes in {entry.regionLabel}</h2>
        <ul class="space-y-2">
          {entry.routes.map(({ seed, route }) => (
            <li>
              <a
                href={withBase(`routes/${seed.slug}.html`)}
                class="block rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-4 hover:border-blue-700 transition-colors"
              >
                <span class="block text-base font-bold text-white">
                  {stationLabel(route.destA)} to {stationLabel(route.destB)}
                </span>
                <span class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mt-1">
                  {getCorridorLabel(route) || displayRouteName(route)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <a
        href={withBase(`/?region=${encodeURIComponent(entry.region)}`)}
        class="mt-10 flex w-full items-center justify-center rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 transition-colors"
      >
        Open Next Train · {entry.regionLabel}
      </a>
      <p class="mt-6 text-sm text-slate-500 text-center">
        <a href={guideHref} class="text-blue-400 hover:underline">User guide</a>
        ·
        <a href={withBase('/')} class="text-blue-400 hover:underline ml-1">Home</a>
      </p>
    </div>
  </main>
</ContentLayout>
