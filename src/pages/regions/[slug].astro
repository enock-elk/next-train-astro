---
import ContentLayout from '../../layouts/ContentLayout.astro';
import SeoPageHeader from '../../components/SeoPageHeader.astro';
import { withBase } from '../../lib/config.js';
import {
  listSeoRegions,
  getSeoRegionBySlug,
  displayRouteName,
  getCorridorLabel,
  WC_PUBLIC_HOLIDAYS_PATH,
} from '../../lib/seo-routes.js';
import SeoCrossLinks from '../../components/SeoCrossLinks.astro';
import SeoNetworkMap from '../../components/SeoNetworkMap.astro';
import JhbFit from '../../components/JhbFit.astro';

export function getStaticPaths() {
  return listSeoRegions().map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const entry = getSeoRegionBySlug(slug);
if (!entry) return Astro.redirect('/routes.html');

const REGION_PAGE_COPY = {
  GP: {
    title: 'Pretoria and Johannesburg Train Schedule | Next Train',
    h1: 'Pretoria and Johannesburg train schedule',
    description: 'Metrorail Gauteng timetables for Pretoria and Johannesburg, including Mabopane, Pienaarspoort, Kempton Park, Naledi and Germiston. View and download weekday and Saturday sheets for today. No Sunday service.',
    lead: 'Weekday and Saturday times for Pretoria and Johannesburg. The routes people open most are Mabopane, Pienaarspoort, Kempton Park, Naledi and Germiston. There is no Sunday service.',
    featured: ['pretoria-to-mabopane', 'pretoria-to-pienaarspoort', 'pretoria-to-kempton-park', 'johannesburg-to-naledi', 'johannesburg-to-germiston'],
  },
  WC: {
    title: 'Cape Town Train Schedule | Next Train',
    h1: 'Cape Town train schedule',
    description: "Cape Town Metrorail train schedule for Strand, Bellville, Chris Hani, Wellington and Simon's Town. Weekdays and Saturdays. Public holidays when PRASA announces them. No regular Sunday service.",
    lead: "Cape Town train times for the Northern, Central, Southern, Cape Flats and Malmesbury lines. Strand, Bellville, Chris Hani and Simon's Town each have their own page. Weekdays and Saturdays. No regular Sunday service.",
    featured: ['cape-town-to-strand', 'cape-town-to-bellville', 'cape-town-to-chris-hani', 'cape-town-to-wellington', 'cape-town-to-simons-town'],
  },
  KZN: {
    title: 'Durban Train Schedule | Next Train',
    h1: 'Durban train schedule',
    description: 'Durban Metrorail train schedule for Pinetown, Umlazi, Winklespruit and Cato Ridge. Weekdays and Saturdays. No Sunday service.',
    lead: 'Durban train times for the north, south and inland lines, including Pinetown, Umlazi, Winklespruit and Cato Ridge. Weekdays and Saturdays. There is no Sunday service.',
    featured: ['durban-to-pinetown', 'durban-to-umlazi', 'durban-to-winklespruit', 'durban-to-cato-ridge'],
  },
  EC: {
    title: 'East London Train Schedule | Next Train',
    h1: 'East London train schedule',
    description: 'East London Metrorail train schedule, including Berlin. Weekday times on the route page. No Sunday service.',
    lead: 'East London to Berlin. The weekday sheet is on the route page. There is no Sunday service.',
    featured: ['east-london-to-berlin'],
  },
};
const pageCopy = REGION_PAGE_COPY[entry.region] || null;
const title = pageCopy?.title || `Metrorail ${entry.regionLabel} Train Times | Next Train`;
const description = pageCopy?.description
  || `View and download ${entry.title} PRASA Metrorail train timetables. ${entry.blurb} Works offline in Next Train, with ticket prices and the next train.`;
const featuredRoutes = (pageCopy?.featured || [])
  .map((slug) => entry.routes.find(({ seed }) => seed.slug === slug))
  .filter(Boolean);
const canonicalPath = `/regions/${entry.slug}.html`;
const routesIndexHref = withBase('routes.html');
const guideHref = withBase('guide.html');
const appHref = withBase(`/?region=${encodeURIComponent(entry.region)}`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  isPartOf: { '@type': 'WebSite', name: 'Metrorail Next Train', url: 'https://nexttrain.co.za/' },
};
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  themeColor="#1d4ed8"
  forceLight={true}
  seoPageType="region"
  seoSlug={entry.slug}
  seoRegion={entry.region}
  seoAlertRouteIds={entry.routes.map(({ route }) => route.id).join(',')}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <SeoPageHeader region={entry.region} regionLabel={entry.regionLabel} />

  <main class="min-h-screen bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <div class="max-w-2xl mx-auto px-4 py-6 sm:py-10">
      <p class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 mb-3">
        <a href={routesIndexHref} class="hover:underline">Metrorail routes</a>
        <span class="text-slate-400 dark:text-slate-500"> / </span>
        {entry.regionLabel}
      </p>

      <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
        {pageCopy?.h1 || entry.title}
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        {pageCopy?.lead || entry.blurb}
      </p>
      {featuredRoutes.length > 0 && (
        <ul class="mt-4 space-y-2">
          {featuredRoutes.map(({ seed, route }) => (
            <li>
              <a
                href={withBase(`routes/${seed.slug}.html`)}
                class="block rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 px-4 py-3 hover:border-blue-500 dark:hover:border-blue-700 transition-colors"
              >
                <span class="block text-sm font-bold text-slate-900 dark:text-white">{displayRouteName(route)}</span>
                <span class="block text-xs text-slate-500 mt-0.5">Weekday sheet, Saturday where listed, ticket prices</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      <SeoNetworkMap
        region={entry.region}
        regionLabel={entry.regionLabel}
        figureId="region-seo-map"
        caption={`Static network map for ${entry.regionLabel}. Tap the map to enlarge. GPS Network Map opens live routes, stations, and disruptions.`}
      />

      {entry.corridors.length > 0 && (
        <section class="mt-10">
          <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">Lines & corridors</h2>
          <ul class="space-y-2">
            {entry.corridors.map((c) => (
              <li>
                <a
                  href={withBase(`corridors/${c.slug}.html`)}
                  class="block rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 px-4 py-4 hover:border-blue-500 dark:hover:border-blue-700 transition-colors"
                >
                  <span class="block text-base font-bold text-slate-900 dark:text-white"><JhbFit text={c.label} /></span>
                  <span class="block text-sm text-slate-500 dark:text-slate-400 mt-1">{c.routes.length} route{c.routes.length === 1 ? '' : 's'}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="mt-10">
        <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">All routes in {entry.regionLabel}</h2>
        <ul class="space-y-2">
          {entry.routes.map(({ seed, route }) => (
            <li>
              <a
                href={withBase(`routes/${seed.slug}.html`)}
                class="block rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 px-4 py-4 hover:border-blue-500 dark:hover:border-blue-700 transition-colors"
              >
                <span class="block text-base font-bold text-slate-900 dark:text-white">
                  {displayRouteName(route)}
                </span>
                <span class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mt-1">
                  <JhbFit text={getCorridorLabel(route) || 'Metrorail'} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {entry.region === 'WC' && (
        <section class="mt-10">
          <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">
            Public holidays
          </h2>
          <a
            href={withBase(WC_PUBLIC_HOLIDAYS_PATH)}
            class="block rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 px-4 py-4 hover:border-blue-500 dark:hover:border-blue-700 transition-colors"
          >
            <span class="block text-base font-bold text-slate-900 dark:text-white">
              Western Cape public holiday timetable
            </span>
            <span class="block text-sm text-slate-500 dark:text-slate-400 mt-1">
              Cape Town public holidays may use a Public Holiday sheet or the Saturday timetable. Check Next Train when PRASA announces the day.
            </span>
          </a>
        </section>
      )}

      <a
        href={appHref}
        class="mt-10 flex w-full items-center justify-center rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 transition-colors"
      >
        Open Next Train · {entry.regionLabel}
      </a>
      <p class="mt-2 text-center text-[11px] text-slate-500">
        First visit suggests {entry.regionLabel}. Returning visitors keep their saved setup.
      </p>
      <SeoCrossLinks region={entry.region} current="region" />

      <p class="mt-6 text-sm text-slate-500 text-center">
        <a href={guideHref} class="text-blue-600 dark:text-blue-400 hover:underline">User guide</a>
        ·
        <a href={withBase('/')} class="text-blue-600 dark:text-blue-400 hover:underline ml-1">Home</a>
      </p>
    </div>
  </main>
</ContentLayout>
