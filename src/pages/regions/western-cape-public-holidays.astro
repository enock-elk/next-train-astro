---
/**
 * Western Cape dedicated Public Holiday timetable landing.
 * Other provinces do not have *_pub sheets — do not invent those pages.
 */
import ContentLayout from '../../layouts/ContentLayout.astro';
import SeoPageHeader from '../../components/SeoPageHeader.astro';
import SeoCrossLinks from '../../components/SeoCrossLinks.astro';
import SeoTimetableGrid from '../../components/SeoTimetableGrid.astro';
import { withBase } from '../../lib/config.js';
import {
  getSeoRegionBySlug,
  WC_PUBLIC_HOLIDAYS_PATH,
  WC_PUBLIC_HOLIDAYS_SLUG,
  listWcPublicHolidayDays,
} from '../../lib/seo-routes.js';
import { buildWcPublicHolidayTimetables } from '../../lib/seo-timetable.js';

const entry = getSeoRegionBySlug('western-cape');
if (!entry) return Astro.redirect('/routes.html');

const year = 2026;
const holidays = listWcPublicHolidayDays(year);
const running = holidays.filter((h) => h.runs);
const noService = holidays.filter((h) => !h.runs);
const timetables = buildWcPublicHolidayTimetables();
const title = `Western Cape Metrorail public holiday timetable ${year} | Next Train`;
const description = `Cape Town Metrorail public holiday train times for ${year}. Some holidays use a Public Holiday sheet, others use the Saturday timetable. Check Next Train when PRASA announces the day.`;
const canonicalPath = `/${WC_PUBLIC_HOLIDAYS_PATH}`;
const regionHref = withBase(`regions/${entry.slug}.html`);
const routesIndexHref = withBase('routes.html');
const appHref = withBase('/?region=WC');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  isPartOf: { '@type': 'WebSite', name: 'Metrorail Next Train', url: 'https://nexttrain.co.za/' },
  about: 'Western Cape Metrorail public holiday timetable',
};
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  themeColor="#1d4ed8"
  forceLight={true}
  seoPageType="region_holidays"
  seoSlug={WC_PUBLIC_HOLIDAYS_SLUG}
  seoRegion="WC"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <SeoPageHeader region="WC" regionLabel={entry.regionLabel} />

  <main class="min-h-screen bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100">
    <div class="max-w-2xl mx-auto px-4 py-6 sm:py-10">
      <p class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 mb-3">
        <a href={routesIndexHref} class="hover:underline">Metrorail routes</a>
        <span class="text-slate-400 dark:text-slate-500"> / </span>
        <a href={regionHref} class="hover:underline">{entry.regionLabel}</a>
        <span class="text-slate-400 dark:text-slate-500"> / </span>
        Public holidays
      </p>

      <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
        Western Cape public holiday timetable
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        Cape Town Metrorail often has its own Public Holiday timetable. Some public holidays instead run on the Saturday timetable. PRASA announces which. Check Next Train for the live day type when they post an update.
        Gauteng, KwaZulu-Natal and Eastern Cape do not have a separate public-holiday timetable here.
      </p>

      {timetables.length > 0 && (
        <nav class="mt-6" aria-label="Public holiday timetables">
          <p class="text-sm font-black uppercase tracking-widest text-slate-500 mb-2">
            Public Holiday timetables
          </p>
          <ul class="flex flex-wrap gap-2">
            {timetables.map((item) => (
              <li>
                <a
                  href={`#holiday-${item.id}`}
                  class="inline-flex rounded-full border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900/60 px-3 py-1.5 text-sm font-semibold text-blue-700 dark:text-blue-300 hover:border-blue-500"
                >
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <section class="mt-10">
        <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">
          {year} days with a Public Holiday timetable
        </h2>
        <ul class="rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 divide-y divide-slate-100 dark:divide-slate-800">
          {running.map((h) => (
            <li class="px-4 py-3 flex items-baseline justify-between gap-3">
              <span class="font-semibold text-slate-900 dark:text-white">{h.name}</span>
              <time class="text-sm text-slate-500 whitespace-nowrap" datetime={h.iso}>{h.label}</time>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-8">
        <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">
          {year} days with no trains
        </h2>
        <ul class="rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60 divide-y divide-slate-100 dark:divide-slate-800">
          {noService.map((h) => (
            <li class="px-4 py-3 flex items-baseline justify-between gap-3">
              <span class="font-semibold text-slate-900 dark:text-white">{h.name}</span>
              <time class="text-sm text-slate-500 whitespace-nowrap" datetime={h.iso}>{h.label}</time>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Sundays also have no Metrorail service. Open Next Train on the day. The board follows the sheet PRASA is using, including when a holiday runs as Saturday.
        </p>
      </section>

      {timetables.length > 0 && (
        <section class="mt-10">
          <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">
            Public Holiday timetables
          </h2>
          <p class="mb-4 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            These routes have a published Public Holiday timetable.
          </p>
          <div class="space-y-10">
            {timetables.map((item) => (
              <section id={`holiday-${item.id}`} class="scroll-mt-4">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                  <a href={withBase(`routes/${item.slug}.html`)} class="hover:underline">{item.name}</a>
                </h3>
                {item.b && (
                  <div class="mt-4">
                    <h4 class="text-sm font-black uppercase tracking-widest text-slate-500">
                      {item.b.heading}
                    </h4>
                    <SeoTimetableGrid grid={item.b} caption={`Public Holiday trains, ${item.b.heading}`} />
                  </div>
                )}
                {item.a && (
                  <div class="mt-4">
                    <h4 class="text-sm font-black uppercase tracking-widest text-slate-500">
                      {item.a.heading}
                    </h4>
                    <SeoTimetableGrid grid={item.a} caption={`Public Holiday trains, ${item.a.heading}`} />
                  </div>
                )}
              </section>
            ))}
          </div>
        </section>
      )}

      <a
        href={appHref}
        class="mt-10 flex w-full items-center justify-center rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 transition-colors"
      >
        Open Next Train · Western Cape
      </a>

      <SeoCrossLinks region="WC" current="holidays" />
    </div>
  </main>
</ContentLayout>
