---
import ContentLayout from '../layouts/ContentLayout.astro';
import { withBase } from '../lib/config.js';
import {
  listSeoRoutes,
  listSeoRegions,
  displayRouteName,
  regionName,
  stationLabel,
  getCorridorLabel,
} from '../lib/seo-routes.js';

const title = 'Metrorail Route Timetables | Next Train';
const description =
  'Browse Pretoria, Cape Town, Durban and more Metrorail corridor pages, then open live schedules in Next Train.';
const pages = listSeoRoutes();
const regions = listSeoRegions();
const byRegion = pages.reduce((acc, item) => {
  const key = item.route.region || 'OTHER';
  if (!acc[key]) acc[key] = [];
  acc[key].push(item);
  return acc;
}, {});
const regionOrder = ['GP', 'WC', 'KZN', 'EC'];
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath="/routes.html"
  themeColor="#1d4ed8"
>
  <main class="min-h-screen bg-slate-950 text-slate-100">
    <div class="max-w-2xl mx-auto px-4 py-10 sm:py-14">
      <p class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-3">
        <a href={withBase('/')} class="hover:underline">Next Train</a>
      </p>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-white">
        Metrorail route timetables
      </h1>
      <p class="mt-3 text-base text-slate-300 leading-relaxed">
        Dedicated pages for every active Metrorail corridor we cover. Start with a province or line, then open the live Next Train board.
      </p>

      {regions.length > 0 && (
        <section class="mt-8">
          <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">Provinces</h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {regions.map((r) => (
              <li>
                <a
                  href={withBase(`regions/${r.slug}.html`)}
                  class="block rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-3 hover:border-blue-700 transition-colors"
                >
                  <span class="block text-sm font-bold text-white">{r.title}</span>
                  <span class="block text-xs text-slate-400 mt-0.5">{r.routes.length} routes · {r.corridors.length} lines</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="mt-10 space-y-8">
        {regionOrder.filter((r) => byRegion[r]?.length).map((region) => (
          <section>
            <h2 class="text-sm font-black uppercase tracking-widest text-slate-500 mb-3">
              {regions.find((x) => x.region === region)?.slug ? (
                <a href={withBase(`regions/${regions.find((x) => x.region === region).slug}.html`)} class="hover:text-blue-400 transition-colors">
                  {regionName(region)}
                </a>
              ) : (
                regionName(region)
              )}
            </h2>
            <ul class="space-y-2">
              {byRegion[region].map(({ seed, route }) => (
                <li>
                  <a
                    href={withBase(`routes/${seed.slug}.html`)}
                    class="block rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-4 hover:border-blue-700 transition-colors"
                  >
                    <span class="block text-base font-bold text-white">
                      {stationLabel(route.destA)} to {stationLabel(route.destB)}
                    </span>
                    <span class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500 mt-1">
                      {getCorridorLabel(route) || displayRouteName(route)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <a
        href={withBase('/')}
        class="mt-10 flex w-full items-center justify-center rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 transition-colors"
      >
        Open Next Train app
      </a>
    </div>
  </main>
</ContentLayout>
