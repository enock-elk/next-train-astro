---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { withBase } from '../../lib/config.js';
import {
  listSeoRoutes,
  getSeoRouteBySlug,
  displayRouteName,
  stationLabel,
  regionName,
  getCorridorLabel,
  listSeoRegions,
  listSeoCorridors,
} from '../../lib/seo-routes.js';

export function getStaticPaths() {
  return listSeoRoutes().map(({ seed }) => ({
    params: { slug: seed.slug },
  }));
}

const { slug } = Astro.params;
const entry = getSeoRouteBySlug(slug);
if (!entry) {
  return Astro.redirect('/routes.html');
}

const { seed, route } = entry;
const name = displayRouteName(route);
const origin = stationLabel(route.destA);
const dest = stationLabel(route.destB);
const province = regionName(route.region);
const corridorLabel = getCorridorLabel(route);
const regionEntry = listSeoRegions().find((r) => r.region === route.region);
const corridorEntry = listSeoCorridors().find(
  (c) => route.corridorId && c.corridorIds.includes(route.corridorId)
);
const title = `${origin} to ${dest} Train Times | Metrorail Next Train`;
const description = `${seed.blurb} Check live ${province} Metrorail schedules offline in Next Train.`;
const canonicalPath = `/routes/${seed.slug}.html`;
const appHref = withBase(`/?rt=${encodeURIComponent(route.id)}`);
const routesIndexHref = withBase('routes.html');
const guideHref = withBase('guide.html');
const regionHref = regionEntry ? withBase(`regions/${regionEntry.slug}.html`) : routesIndexHref;
const corridorHref = corridorEntry ? withBase(`corridors/${corridorEntry.slug}.html`) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  about: name,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Next Train',
    url: 'https://nexttrain.co.za/',
  },
};

const related = [
  ...listSeoRoutes().filter(
    (r) => r.seed.slug !== seed.slug && r.route.corridorId && r.route.corridorId === route.corridorId
  ),
  ...listSeoRoutes().filter(
    (r) => r.seed.slug !== seed.slug && r.route.region === route.region && r.route.corridorId !== route.corridorId
  ),
].slice(0, 4);
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  themeColor="#1d4ed8"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <main class="min-h-screen bg-slate-950 text-slate-100">
    <div class="max-w-2xl mx-auto px-4 py-10 sm:py-14">
      <p class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-3">
        <a href={routesIndexHref} class="hover:underline">Metrorail routes</a>
        <span class="text-slate-500"> / </span>
        <a href={regionHref} class="hover:underline">{province}</a>
        {corridorLabel && (
          <>
            <span class="text-slate-500"> / </span>
            {corridorHref ? <a href={corridorHref} class="hover:underline">{corridorLabel}</a> : corridorLabel}
          </>
        )}
      </p>

      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-white leading-tight">
        {origin} to {dest} train times
      </h1>
      <p class="mt-3 text-base text-slate-300 leading-relaxed">
        {seed.blurb}
      </p>

      <div class="mt-8 rounded-2xl border border-slate-800 bg-slate-900/80 p-5 sm:p-6 shadow-xl">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-slate-500 font-bold uppercase tracking-wide text-[10px]">Origin</dt>
            <dd class="mt-1 font-semibold text-white">{origin}</dd>
          </div>
          <div>
            <dt class="text-slate-500 font-bold uppercase tracking-wide text-[10px]">Destination</dt>
            <dd class="mt-1 font-semibold text-white">{dest}</dd>
          </div>
          <div>
            <dt class="text-slate-500 font-bold uppercase tracking-wide text-[10px]">Province</dt>
            <dd class="mt-1 font-semibold text-white">{province}</dd>
          </div>
          <div>
            <dt class="text-slate-500 font-bold uppercase tracking-wide text-[10px]">Corridor</dt>
            <dd class="mt-1 font-semibold text-white">{corridorLabel || 'Metrorail'}</dd>
          </div>
        </dl>

        <p class="mt-5 text-sm text-slate-400 leading-relaxed border-t border-slate-800 pt-4">
          {seed.operatingNote}
        </p>

        <a
          href={appHref}
          class="mt-6 flex w-full items-center justify-center rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 px-4 transition-colors shadow-lg shadow-blue-900/40"
        >
          Open live board for {name}
        </a>
        <p class="mt-2 text-center text-[11px] text-slate-500">
          Opens Next Train with this route selected. Works offline after first load.
        </p>
      </div>

      <section class="mt-10">
        <h2 class="text-lg font-bold text-white mb-3">Related routes</h2>
        <ul class="space-y-2">
          {related.map(({ seed: rel, route: relRoute }) => (
            <li>
              <a
                href={withBase(`routes/${rel.slug}.html`)}
                class="block rounded-xl border border-slate-800 bg-slate-900/50 px-4 py-3 text-sm font-semibold text-blue-300 hover:border-blue-700 hover:bg-slate-900 transition-colors"
              >
                {displayRouteName(relRoute)} train times
              </a>
            </li>
          ))}
        </ul>
      </section>

      <p class="mt-10 text-sm text-slate-500">
        Need holiday rules or offline tips?
        <a href={guideHref} class="text-blue-400 hover:underline ml-1">Read the user guide</a>
        ·
        <a href={withBase('/')} class="text-blue-400 hover:underline ml-1">Home</a>
      </p>
    </div>
  </main>
</ContentLayout>
