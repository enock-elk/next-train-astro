---
/**
 * Public Terms of Use. Same document as the in-app legal modal.
 */
import ContentLayout from '../layouts/ContentLayout.astro';
import LegalArticle from '../components/LegalArticle.astro';
import { LEGAL_TEXTS } from '../lib/config.js';

const title = 'Terms of Use | Next Train';
const description = 'Terms of use for Next Train, an independent Metrorail timetable helper.';
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath="/terms.html"
  seoPageType="terms"
  bodyClass="bg-[#f2f2f7] dark:bg-black text-gray-900 min-h-screen"
>
  <LegalArticle title="Terms of Use">
    <div set:html={LEGAL_TEXTS.terms} />
  </LegalArticle>
</ContentLayout>
