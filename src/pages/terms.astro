---
/**
 * Public Terms of Use. Same document as the in-app legal modal.
 */
import ContentLayout from '../layouts/ContentLayout.astro';
import { LEGAL_TEXTS, withBase } from '../lib/config.js';

const title = 'Terms of Use | Next Train';
const description = 'Terms of use for Next Train, an independent Metrorail timetable helper.';
---

<ContentLayout
  title={title}
  description={description}
  canonicalPath="/terms.html"
  seoPageType="terms"
  bodyClass="bg-white text-gray-900 min-h-screen"
>
  <article class="max-w-xl mx-auto px-4 py-8">
    <p class="text-sm mb-6"><a href={withBase('')} class="text-blue-600 underline">Back to Next Train</a></p>
    <h1 class="text-2xl font-black tracking-tight mb-4">Terms of Use</h1>
    <p class="text-sm text-gray-500 mb-6">Kazembe CodeWorks · nexttrain.co.za</p>
    <div class="text-gray-800 leading-relaxed" set:html={LEGAL_TEXTS.terms} />
    <p class="mt-8 text-sm">
      <a href={withBase('privacy.html')} class="text-blue-600 underline">Privacy Policy</a>
    </p>
  </article>
</ContentLayout>
