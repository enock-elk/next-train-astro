{
  "zoneId": "12ae447dd10517a217c534114653c2a3",
  "scriptName": "nexttrain-edge",
  "hosts": ["nexttrain.co.za", "www.nexttrain.co.za"],
  "cache": [
    {
      "ref": "nt-edge-astro",
      "description": "nt-edge: long-cache hashed /_astro/ (200s only; errors not stored)",
      "expression": "(http.host eq \"nexttrain.co.za\" or http.host eq \"www.nexttrain.co.za\") and starts_with(http.request.uri.path, \"/_astro/\")",
      "action": "set_cache_settings",
      "enabled": true,
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 31536000,
          "status_code_ttl": [
            { "status_code_range": { "from": 200, "to": 299 }, "value": 31536000 },
            { "status_code_range": { "from": 400, "to": 599 }, "value": -1 }
          ]
        },
        "browser_ttl": {
          "mode": "override_origin",
          "default": 31536000
        }
      }
    },
    {
      "ref": "nt-edge-icons",
      "description": "nt-edge: long-cache /icons and favicon (200s only)",
      "expression": "(http.host eq \"nexttrain.co.za\" or http.host eq \"www.nexttrain.co.za\") and (starts_with(http.request.uri.path, \"/icons/\") or http.request.uri.path eq \"/favicon.ico\")",
      "action": "set_cache_settings",
      "enabled": true,
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 2592000,
          "status_code_ttl": [
            { "status_code_range": { "from": 200, "to": 299 }, "value": 2592000 },
            { "status_code_range": { "from": 400, "to": 599 }, "value": -1 }
          ]
        },
        "browser_ttl": {
          "mode": "override_origin",
          "default": 2592000
        }
      }
    },
    {
      "ref": "nt-edge-probes",
      "description": "nt-edge: bypass cache for sw.js and app-version.json",
      "expression": "(http.host eq \"nexttrain.co.za\" or http.host eq \"www.nexttrain.co.za\") and (http.request.uri.path eq \"/sw.js\" or http.request.uri.path eq \"/app-version.json\")",
      "action": "set_cache_settings",
      "enabled": true,
      "action_parameters": {
        "cache": false
      }
    }
  ],
  "transform": [
    {
      "ref": "nt-edge-cc-astro",
      "description": "nt-edge: Cache-Control immutable on hashed /_astro/",
      "expression": "(http.host eq \"nexttrain.co.za\" or http.host eq \"www.nexttrain.co.za\") and starts_with(http.request.uri.path, \"/_astro/\")",
      "action": "rewrite",
      "enabled": true,
      "action_parameters": {
        "headers": {
          "Cache-Control": {
            "operation": "set",
            "value": "public, max-age=31536000, immutable"
          },
          "Expires": { "operation": "remove" }
        }
      }
    },
    {
      "ref": "nt-edge-cc-icons",
      "description": "nt-edge: Cache-Control 30d on /icons and favicon",
      "expression": "(http.host eq \"nexttrain.co.za\" or http.host eq \"www.nexttrain.co.za\") and (starts_with(http.request.uri.path, \"/icons/\") or http.request.uri.path eq \"/favicon.ico\")",
      "action": "rewrite",
      "enabled": true,
      "action_parameters": {
        "headers": {
          "Cache-Control": {
            "operation": "set",
            "value": "public, max-age=2592000"
          },
          "Expires": { "operation": "remove" }
        }
      }
    },
    {
      "ref": "nt-edge-cc-probes",
      "description": "nt-edge: no-store on sw.js and app-version.json",
      "expression": "(http.host eq \"nexttrain.co.za\" or http.host eq \"www.nexttrain.co.za\") and (http.request.uri.path eq \"/sw.js\" or http.request.uri.path eq \"/app-version.json\")",
      "action": "rewrite",
      "enabled": true,
      "action_parameters": {
        "headers": {
          "Cache-Control": {
            "operation": "set",
            "value": "no-store, no-cache, must-revalidate"
          },
          "Pragma": {
            "operation": "set",
            "value": "no-cache"
          },
          "Expires": { "operation": "remove" }
        }
      }
    }
  ]
}
