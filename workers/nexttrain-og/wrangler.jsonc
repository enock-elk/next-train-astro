{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexttrain-og",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  // Deploy checklist (infra):
  // 1) Orange-cloud DNS for nexttrain.co.za on Cloudflare
  // 2) Set ORIGIN_URL to the real upstream host (NOT nexttrain.co.za — avoid loops)
  //    e.g. GitHub Pages project URL or a dedicated origin hostname
  // 3) Attach routes below (uncomment after zone is on Cloudflare)
  // 4) Confirm schedules readable: SCHEDULE_BASE + schedules/{region}.json
  // 5) Smoke-test with Facebook Sharing Debugger + a fresh WhatsApp message
  "vars": {
    "PUBLIC_SITE": "https://nexttrain.co.za",
    "ORIGIN_URL": "https://enock-elk.github.io/next-train-astro",
    "SCHEDULE_BASE": "https://metrorail-next-train-default-rtdb.firebaseio.com/",
    "FALLBACK_OG_IMAGE": "https://nexttrain.co.za/icons/loading-logo.png"
  }
  // "routes": [
  //   { "pattern": "nexttrain.co.za/", "zone_name": "nexttrain.co.za" },
  //   { "pattern": "nexttrain.co.za/og/*", "zone_name": "nexttrain.co.za" },
  //   { "pattern": "www.nexttrain.co.za/", "zone_name": "nexttrain.co.za" },
  //   { "pattern": "www.nexttrain.co.za/og/*", "zone_name": "nexttrain.co.za" }
  // ]
}
