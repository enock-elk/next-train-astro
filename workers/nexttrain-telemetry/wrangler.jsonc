{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexttrain-telemetry",
  "main": "worker.js",
  "compatibility_date": "2026-03-22",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // Existing production database. Keep this binding in the file so a deploy does not drop it.
  "d1_databases": [
    {
      "binding": "REGION_PRESENCE_DB",
      "database_name": "nexttrain-region-presence",
      "database_id": "5c461bd1-ba86-439c-8d8c-4ee2079653d5",
      "migrations_dir": "migrations"
    }
  ],
  // Plain vars (secrets GA_PRIVATE_KEY / SENTRY_AUTH_TOKEN / CF_API_TOKEN / GH_ACTIONS_TOKEN stay in the dashboard).
  "vars": {
    "GA_CLIENT_EMAIL": "nexttrain-telemetry@metrorail-next-train.iam.gserviceaccount.com",
    "GA_PROPERTY_ID": "514537103",
    "SENTRY_ORG": "actuary-consulting-pty-ltd",
    "SENTRY_PROJECT": "javascript",
    "FIREBASE_WEB_API_KEY": "AIzaSyAU303BRMrH3A5n5zbJH4MVwWdkfznqxMY",
    "CF_ZONE_ID": "12ae447dd10517a217c534114653c2a3"
  }
}
